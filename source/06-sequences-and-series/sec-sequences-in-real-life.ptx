<?xml version="1.0" encoding="utf-8"?>

<section xml:id="sec-sequences-in-real-life" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Sequences in Real Life</title>
    <!--  -->
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        1.0 Numbers and Algebra
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>
                        1.6 Sequences and Series
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title>
                    <p>
                        <ul>
                            <li>Apply sequences and series to real-life situations</li>
                            <li>Appreciate the use of sequences and series in real life</li>
                        </ul>
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        11
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>
                        40 minutes
                    </p>
                </li>
            </dl>
            </p>
        </introduction>
    </objectives>

     <axiom component="lesson-plan">
        <title>Problem-Solving and Discovery</title>
        <dl>
            <li>
                <title>Suggested Time</title>
                <p>
                    10 minutes
                </p>
            </li>
            <li>
                <title>Objective</title>
                <p>
                    To engage students in discovering how sequences and series appear in real-life contexts,
                    and to develop their ability to model and solve problems using these concepts.
                </p>
            </li>
        </dl>
    </axiom>

    <activity>
        <statement>
            <p>
                <term>Work in Groups</term>
            </p>
            <p>
                Your school is planning a sports day and needs to seat spectators in two
                separate sections of the field.
            </p>
            <p>
                <ul>
                    <li>
                        <p>
                            <em>General seating:</em> The first row has <m>25</m> chairs.
                            Each row behind it has <m>6</m> more chairs than the row in front.
                        </p>
                    </li>
                    <li>
                        <p>
                            <em>VIP seating:</em> The first row has <m>8</m> chairs.
                            Each row behind it has twice as many chairs as the row in front.
                        </p>
                    </li>
                </ul>
            </p>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                            Write down the number of chairs in the first 6 rows of each section.
                        </p>
                    </li>
                    <li>
                        <p>
                            How many chairs are in row 10 of the general section?
                            How many are in row 6 of the VIP section?
                        </p>
                    </li>
                    <li>
                        <p>
                            Find the total number of chairs in the first 12 rows of the general section.
                            Find the total for the first 7 rows of the VIP section.
                        </p>
                    </li>
                    <li>
                        <p>
                            The field can accommodate at most <m>800</m> chairs in total.
                            Which section fits more rows within this limit?
                        </p>
                    </li>
                    <li>
                        <p>
                            Which layout would you recommend for sports day, and why?
                            Consider: fairness, cost, and ease of fitting more spectators.
                        </p>
                    </li>
                </ol>
            </p>
        </statement>
    </activity>

