    <!-- If STACK questions are included, uncomment this: -->

    <!-- <xi:include href="../lesson-plan-templates/checkpoint.ptx" /> -->

    <!-- Add STACK exercises if made -->

    <!-- Add static exercises -->

    <exercises>
        <exercise>
            <statement>
                <p>
                    For each of the following sequences, find the terms indicated:
                </p>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                The seventh and twelfth terms.
                            </p>
                            <p>
                                <m>0,2,6,12,\ldots</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                The seventh and the ninth terms.
                            </p>
                            <p>
                                <m>\frac{1}{3}, \frac{5}{3}, \frac{9}{3}, \frac{13}{3} ,\ldots </m>
                            </p>
                        </li>
                        <li>
                            <p>
                                The fifth and eighth terms.
                            </p>
                            <p>
                                <m> \frac{1}{5}, 1, \frac{9}{5}, \frac{13}{5} ,\ldots </m>
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m>42, 132</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m> \frac{25}{3}, 11 </m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>\frac{17}{5}, \frac{29}{5} </m>
                            </p>
                        </li>
                    </ol>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    Write down the first three terms of a sequence whose <m>n^{\text{th}}</m> term is given below:
                </p>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m>2n</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>2n+1</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>n^2</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>\frac{n^2+1}{2}</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>2n^2-2</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>2^n+1</m>
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)">
                        <li><p><m>2, 4, 6</m></p></li>
                        <li><p><m>3, 5, 7</m></p></li>
                        <li><p><m>1, 4, 9</m></p></li>
                        <li><p><m>1, \dfrac{5}{2}, 5</m></p></li>
                        <li><p><m>0, 6, 16</m></p></li>
                        <li><p><m>3, 5, 9</m></p></li>
                    </ol>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    Give an expression for the <m>n^{\text{th}}</m> term:
                </p>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                               <m>3,6,9,12 ,\ldots</m> 
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>1,3,5,7,9 ,\ldots</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>6,11,16 ,\ldots</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>0,3,8,15 ,\ldots</m>
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m>3n</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>2n-1</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>5n+1</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>n^2-1</m>
                            </p>
                        </li>
                    </ol>
                </p>
            </answer>
        </exercise>
    <exercise>
        <introduction>
            <p>
                Consider the sequence of dominoes shown below:
                <figure xml:id="dominoes-sequence">
                    <image source="images/square-sequence.png" width="100%">
                        <shortdescription></shortdescription>
                    </image>
                    <caption><q><url href="https://www.visualpatterns.org/patterns/401-through-450">Pattern 407</url></q> by Johnothon Sauer is licensed under <url href="https://creativecommons.org/licenses/by/4.0/deed.en">CC-BY-4.0</url>.</caption>
                </figure>
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    Let <m>D_n</m> represent the number of dominoes in the <m>n^{\text{th}}</m> square. How many dominoes are in the first square, <m>D_1</m>?
                </p>
            </statement>
            <solution>
                <p>
                    The first square has <m>4 + 8 = 12</m> dominoes, so <m>D_1 = 12</m>.
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    How many dominoes are in the second square, <m>D_2</m>?
                </p>
            </statement>
            <solution>
                <p>
                    The second square has <m>4 + 8 + 12 = 24</m> dominoes, so <m>D_2 = 24</m>.
                </p>
            </solution>
        </task>
        <task>
            <statement>
                <p>
                    Can you find a formula for the number of dominoes in the <m>n^{\text{th}}</m> square, <m>D_n</m>?
                </p>
            </statement>
            <solution>
                <p>
                    The innermost ring has 4 dominoes, the next ring has 8 dominoes, the next has 12 dominoes, and so on. The <m>n^{\text{th}}</m> ring has <m>4n</m> dominoes. Since there are <m>n</m> rings in the <m>n^{\text{th}}</m> square, the total number of dominoes is:
                    <md>
                        D_n = 4 + 8 + 12 + \ldots 4n
                    </md>
                </p>
                <p>
                    We'll learn how to find a closed-form formula for this sum in <xref ref="sec-finding-the-sum-of-arithmetic-sequences"/>.
                </p>
            </solution>
        </task>
    </exercise>
        <exercise>
            <statement>
                <p>
                    The <m>n^{\text{th}}</m> term of a sequence is <m>T_n = 5n - 2</m>.
                </p>
                <p>
                    <ol marker="(a)">
                        <li><p>Find <m>T_1</m>, <m>T_4</m>, and <m>T_{10}</m>.</p></li>
                        <li><p>Which term of the sequence equals <m>48</m>?</p></li>
                        <li><p>Is <m>71</m> a term of this sequence? Explain.</p></li>
                        <li><p>Is <m>73</m> a term of this sequence? Explain.</p></li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)">
                        <li><p><m>3,\ 18,\ 48</m></p></li>
                        <li><p>The 10th term</p></li>
                        <li><p>No — <m>5n - 2 = 71</m> gives <m>n = 14.6</m>, which is not a whole number.</p></li>
                        <li><p>Yes — <m>5n - 2 = 73</m> gives <m>n = 15</m>, so <m>T_{15} = 73</m>.</p></li>
                    </ol>
                </p>
            </answer>
            <solution>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                <md>
                                    <mrow>T_1 \amp =\; 5(1) - 2 = 3</mrow>
                                    <mrow>T_4 \amp =\; 5(4) - 2 = 18</mrow>
                                    <mrow>T_{10} \amp =\; 5(10) - 2 = 48</mrow>
                                </md>
                            </p>
                        </li>
                        <li>
                            <p>
                                We need <m>5n - 2 = 48</m>:
                                <md>
                                    <mrow>5n \amp =\; 50 \implies n = 10</mrow>
                                </md>
                                So <m>48</m> is the <em>10th term</em>.
                            </p>
                        </li>
                        <li>
                            <p>
                                Set <m>5n - 2 = 71</m>, so <m>5n = 73</m>, giving <m>n = 14.6</m>.
                                Since <m>n</m> must be a positive whole number, <m>71</m> is <em>not</em> a term of this sequence.
                            </p>
                        </li>
                        <li>
                            <p>
                                Set <m>5n - 2 = 73</m>, so <m>5n = 75</m>, giving <m>n = 15</m>.
                                Since <m>n = 15</m> is a positive whole number, <m>73</m> <em>is</em> a term of the sequence (<m>T_{15} = 73</m>).
                            </p>
                        </li>
                    </ol>
                </p>
            </solution>
        </exercise>

        <exercise>
            <statement>
                <p>
                    For each sequence below, determine whether the given value is a term.
                    If it is, state which term. If it is not, explain why.
                </p>
                <p>
                    <ol marker="(a)">
                        <li><p>Sequence: <m>4, 7, 10, 13, \ldots</m> — Is <m>101</m> a term?</p></li>
                        <li><p>Sequence: <m>4, 7, 10, 13, \ldots</m> — Is <m>100</m> a term?</p></li>
                        <li><p>Sequence: <m>6, 11, 16, 21, \ldots</m> — Is <m>151</m> a term?</p></li>
                        <li><p>Sequence: <m>2, 6, 12, 20, 30, \ldots</m> — Is <m>72</m> a term?</p></li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)">
                        <li><p>No — <m>n = \frac{100}{3}</m> is not a whole number.</p></li>
                        <li><p>Yes — the 33rd term.</p></li>
                        <li><p>Yes — the 30th term.</p></li>
                        <li><p>Yes — the 8th term.</p></li>
                    </ol>
                </p>
            </answer>
            <solution>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                The <m>n^{\text{th}}</m> term is <m>T_n = 3n + 1</m>.
                                Set <m>3n + 1 = 101</m>: <m>3n = 100</m>, so <m>n = \frac{100}{3} \approx 33.3</m>.
                                Since this is not a whole number, <m>101</m> is <em>not</em> a term of this sequence.
                            </p>
                        </li>
                        <li>
                            <p>
                                Set <m>3n + 1 = 100</m>: <m>n = 33</m>.
                                Check: <m>T_{33} = 3(33)+1 = 100</m>. <m>\checkmark</m>
                                So <m>100</m> <em>is</em> the 33rd term.
                            </p>
                        </li>
                        <li>
                            <p>
                                The <m>n^{\text{th}}</m> term is <m>T_n = 5n + 1</m>.
                                Set <m>5n + 1 = 151</m>: <m>n = 30</m>.
                                Check: <m>T_{30} = 5(30)+1 = 151</m>. <m>\checkmark</m>
                                So <m>151</m> <em>is</em> the 30th term.
                            </p>
                        </li>
                        <li>
                            <p>
                                The terms are <m>1 \times 2,\ 2 \times 3,\ 3 \times 4,\ 4 \times 5,\ \ldots</m>,
                                so <m>T_n = n(n+1)</m>.
                                Set <m>n(n+1) = 72</m>: try <m>n = 8</m>: <m>8 \times 9 = 72</m>. <m>\checkmark</m>
                                So <m>72</m> <em>is</em> the 8th term.
                            </p>
                        </li>
                    </ol>
                </p>
            </solution>
        </exercise>

        <exercise>
            <statement>
                <p>
                    A school hall has rows of chairs.
                    The first row has <m>15</m> chairs.
                    Each row behind it has <m>4</m> more chairs than the row in front.
                </p>
                <p>
                    <ol marker="(a)">
                        <li><p>Write down the number of chairs in rows <m>1,2,ldots,5</m>.</p></li>
                        <li><p>Write a formula for the number of chairs in row <m>n</m>.</p></li>
                        <li><p>How many chairs are in row 18?</p></li>
                        <li><p>Which row has exactly <m>55</m> chairs?</p></li>
                        <li><p>The hall has 20 rows. How many chairs does the last row have?</p></li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)">
                        <li><p><m>15, 19, 23, 27, 31</m></p></li>
                        <li><p><m>T_n = 4n + 11</m></p></li>
                        <li><p><m>83</m> chairs</p></li>
                        <li><p>Row 11</p></li>
                        <li><p><m>91</m> chairs</p></li>
                    </ol>
                </p>
            </answer>
            <solution>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                Adding 4 each time: <m>15, 19, 23, 27, 31</m>.
                            </p>
                        </li>
                        <li>
                            <p>
                                Row 1 has 15 chairs and each row adds 4, so:
                                <md>
                                    <mrow>T_n \amp =\; 15 + (n-1) \times 4 = 4n + 11</mrow>
                                </md>
                            </p>
                        </li>
                        <li>
                            <p>
                                <md>
                                    <mrow>T_{18} \amp =\; 4(18) + 11 = 72 + 11 = 83 \text{ chairs}</mrow>
                                </md>
                            </p>
                        </li>
                        <li>
                            <p>
                                Set <m>4n + 11 = 55</m>:
                                <md>
                                    <mrow>4n \amp =\; 44 \implies n = 11</mrow>
                                </md>
                                Row <m>11</m> has exactly 55 chairs.
                            </p>
                        </li>
                        <li>
                            <p>
                                <md>
                                    <mrow>T_{20} \amp =\; 4(20) + 11 = 91 \text{ chairs}</mrow>
                                </md>
                            </p>
                        </li>
                    </ol>
                </p>
            </solution>
        </exercise>
    </exercises>

