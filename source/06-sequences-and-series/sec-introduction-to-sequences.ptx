<?xml version="1.0" encoding="utf-8"?>

<section xml:id="sec-introduction-to-sequences" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Introduction to Sequences</title>
    <!--  -->
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        1.0 Numbers and Algebra
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>
                        1.6 Sequences and Series
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title> 
                    <p>
                        Determine nth term in a number sequences
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        11
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>
                        40 minutes
                    </p>
                </li>
            </dl>
            </p>
        </introduction>
    </objectives>

    <!-- [LP] Add guidance on activity -->

    <axiom component="lesson-plan">
            <title>Problem-Solving and Discovery</title>
            <dl>
                <li>
                    <title>Suggested Time</title>
                    <p>
                        10 minutes
                    </p>
                </li>
                <li>
                    <title>Objective</title>
                    <p>
                        To visually explore different types of sequences.
                    </p>
                </li>
                <li>
                    <title>Teacher's Role</title>
                    <p>
                        Encourage Learners to draw the next step in the pattern, and to explain their reasoning. To extend Learners, ask them about the difference between the patterns, drawing out how Pattern D is a doubling, while Pattern A only has addition.
                    </p>
                </li>
            </dl>
        </axiom>

    <activity>
        <introduction>
            <p>
                <term>Visual Patterns — Work in Groups</term>
            </p>
            <p>
                The diagrams below show sequences of tile arrangements.
                For each pattern:
            </p>
            <p>
                <ul>
                    <li><p>Count the number of tiles at each step and record your results in a table.</p></li>
                    <li><p>Describe the rule connecting one step to the next.</p></li>
                    <li><p>Predict the number of tiles at Step 5.</p></li>
                    <li><p>Write a formula for the number of tiles at Step <m>n</m>.</p></li>
                </ul>
            </p>
        </introduction>

        <task>
            <title>Pattern A</title>
            <statement>
            <figure xml:id="fig-seq-cross-pattern">
                <caption>Cross pattern — Steps 1 to 4.</caption>
                <image width="90%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.5]
                    % At step n the cross has a centre + 4 arms each of length n-1.
                    % NEW tiles = the 4 outermost arm tips (added at each step).
                    % Odd steps = blue, even steps = red.
                    % Step 1: centre only, blue
                    \filldraw[fill=blue!55!white, draw=black] (0,3) rectangle ++(1,1);
                    % Step 2: centre (old, blue) + 4 arm tips (new, red)
                    \filldraw[fill=blue!55!white, draw=black] (3,3) rectangle ++(1,1); % centre old
                    \filldraw[fill=red!60!white, draw=black]  (2,3) rectangle ++(1,1); % left  new
                    \filldraw[fill=red!60!white, draw=black]  (4,3) rectangle ++(1,1); % right new
                    \filldraw[fill=red!60!white, draw=black]  (3,2) rectangle ++(1,1); % down  new
                    \filldraw[fill=red!60!white, draw=black]  (3,4) rectangle ++(1,1); % up    new
                    % Step 3: centre (blue), dist-1 arms (red old), dist-2 arms (blue new)
                    \filldraw[fill=blue!55!white, draw=black] (8,3) rectangle ++(1,1); % centre
                    \filldraw[fill=red!60!white, draw=black]  (7,3) rectangle ++(1,1); % dist-1 left
                    \filldraw[fill=red!60!white, draw=black]  (9,3) rectangle ++(1,1); % dist-1 right
                    \filldraw[fill=red!60!white, draw=black]  (8,2) rectangle ++(1,1); % dist-1 down
                    \filldraw[fill=red!60!white, draw=black]  (8,4) rectangle ++(1,1); % dist-1 up
                    \filldraw[fill=blue!55!white, draw=black] (6,3) rectangle ++(1,1); % dist-2 left  new
                    \filldraw[fill=blue!55!white, draw=black] (10,3) rectangle ++(1,1);% dist-2 right new
                    \filldraw[fill=blue!55!white, draw=black] (8,1) rectangle ++(1,1); % dist-2 down  new
                    \filldraw[fill=blue!55!white, draw=black] (8,5) rectangle ++(1,1); % dist-2 up    new
                    % Step 4: centre (blue), dist-1 (red), dist-2 (blue), dist-3 (red new)
                    \filldraw[fill=blue!55!white, draw=black] (15,3) rectangle ++(1,1);
                    \filldraw[fill=red!60!white, draw=black]  (14,3) rectangle ++(1,1);
                    \filldraw[fill=red!60!white, draw=black]  (16,3) rectangle ++(1,1);
                    \filldraw[fill=red!60!white, draw=black]  (15,2) rectangle ++(1,1);
                    \filldraw[fill=red!60!white, draw=black]  (15,4) rectangle ++(1,1);
                    \filldraw[fill=blue!55!white, draw=black] (13,3) rectangle ++(1,1);
                    \filldraw[fill=blue!55!white, draw=black] (17,3) rectangle ++(1,1);
                    \filldraw[fill=blue!55!white, draw=black] (15,1) rectangle ++(1,1);
                    \filldraw[fill=blue!55!white, draw=black] (15,5) rectangle ++(1,1);
                    \filldraw[fill=red!60!white, draw=black]  (12,3) rectangle ++(1,1); % dist-3 new
                    \filldraw[fill=red!60!white, draw=black]  (18,3) rectangle ++(1,1); % dist-3 new
                    \filldraw[fill=red!60!white, draw=black]  (15,0) rectangle ++(1,1); % dist-3 new
                    \filldraw[fill=red!60!white, draw=black]  (15,6) rectangle ++(1,1); % dist-3 new
                    \node[below] at (0.5,3.0) {\small Step 1};
                    \node[below] at (3.5,2.0) {\small Step 2};
                    \node[below] at (8.5,1.0) {\small Step 3};
                    \node[below] at (15.5,0.0) {\small Step 4};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
            </statement>    
            <solution component="lesson-plan">
                <p>
                    <md>
                        T_n = 1 + (n-1)\times 4 = 4n - 3
                    </md>
                    
                </p>
            </solution>
        </task>

        <task>
            <title>Pattern B</title>
            <statement>
            <figure xml:id="fig-seq-rectangle-pattern">
                <caption>Rectangle pattern — Steps 1 to 4.</caption>
                <image width="90%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.55]
                    % Step n is an n-row by (n+1)-col rectangle.
                    % NEW tiles at step n: the top row (row=n-1) and rightmost column (col=n).
                    % Odd steps = green, even steps = violet.
                    % Step 1 (1x2): all new, green
                    \filldraw[fill=green!55, draw=black] (0,0) rectangle ++(1,1);
                    \filldraw[fill=green!55, draw=black] (1,0) rectangle ++(1,1);
                    % Step 2 (2x3, offset=3): old tiles (row=0, col 0-1) green; new tiles violet
                    \filldraw[fill=green!55,  draw=black] (3,0) rectangle ++(1,1); % old
                    \filldraw[fill=green!55,  draw=black] (4,0) rectangle ++(1,1); % old
                    \filldraw[fill=violet!60, draw=black] (5,0) rectangle ++(1,1); % new col
                    \filldraw[fill=violet!60, draw=black] (3,1) rectangle ++(1,1); % new row
                    \filldraw[fill=violet!60, draw=black] (4,1) rectangle ++(1,1); % new row
                    \filldraw[fill=violet!60, draw=black] (5,1) rectangle ++(1,1); % new corner
                    % Step 3 (3x4, offset=7): inherited from step 2, new tiles green
                    \filldraw[fill=green!55,  draw=black] (7,0)  rectangle ++(1,1); % old green
                    \filldraw[fill=green!55,  draw=black] (8,0)  rectangle ++(1,1); % old green
                    \filldraw[fill=violet!60, draw=black] (9,0)  rectangle ++(1,1); % old violet
                    \filldraw[fill=violet!60, draw=black] (7,1)  rectangle ++(1,1); % old violet
                    \filldraw[fill=violet!60, draw=black] (8,1)  rectangle ++(1,1); % old violet
                    \filldraw[fill=violet!60, draw=black] (9,1)  rectangle ++(1,1); % old violet
                    \filldraw[fill=green!55,  draw=black] (7,2)  rectangle ++(1,1); % new row
                    \filldraw[fill=green!55,  draw=black] (8,2)  rectangle ++(1,1); % new row
                    \filldraw[fill=green!55,  draw=black] (9,2)  rectangle ++(1,1); % new row
                    \filldraw[fill=green!55,  draw=black] (10,0) rectangle ++(1,1); % new col
                    \filldraw[fill=green!55,  draw=black] (10,1) rectangle ++(1,1); % new col
                    \filldraw[fill=green!55,  draw=black] (10,2) rectangle ++(1,1); % new corner
                    % Step 4 (4x5, offset=12): inherited from step 3, new tiles violet
                    \filldraw[fill=green!55,  draw=black] (12,0) rectangle ++(1,1);
                    \filldraw[fill=green!55,  draw=black] (13,0) rectangle ++(1,1);
                    \filldraw[fill=violet!60, draw=black] (14,0) rectangle ++(1,1);
                    \filldraw[fill=green!55,  draw=black] (15,0) rectangle ++(1,1); % old green (step3 new col)
                    \filldraw[fill=violet!60, draw=black] (16,0) rectangle ++(1,1); % new col
                    \filldraw[fill=violet!60, draw=black] (12,1) rectangle ++(1,1);
                    \filldraw[fill=violet!60, draw=black] (13,1) rectangle ++(1,1);
                    \filldraw[fill=violet!60, draw=black] (14,1) rectangle ++(1,1);
                    \filldraw[fill=green!55,  draw=black] (15,1) rectangle ++(1,1); % old green (step3 new col)
                    \filldraw[fill=violet!60, draw=black] (16,1) rectangle ++(1,1); % new col
                    \filldraw[fill=green!55,  draw=black] (12,2) rectangle ++(1,1);
                    \filldraw[fill=green!55,  draw=black] (13,2) rectangle ++(1,1);
                    \filldraw[fill=green!55,  draw=black] (14,2) rectangle ++(1,1);
                    \filldraw[fill=green!55,  draw=black] (15,2) rectangle ++(1,1);
                    \filldraw[fill=violet!60, draw=black] (16,2) rectangle ++(1,1); % new col
                    \filldraw[fill=violet!60, draw=black] (12,3) rectangle ++(1,1); % new row
                    \filldraw[fill=violet!60, draw=black] (13,3) rectangle ++(1,1); % new row
                    \filldraw[fill=violet!60, draw=black] (14,3) rectangle ++(1,1); % new row
                    \filldraw[fill=violet!60, draw=black] (15,3) rectangle ++(1,1); % new row
                    \filldraw[fill=violet!60, draw=black] (16,3) rectangle ++(1,1); % new corner
                    \node[below] at (1.0,-0.2) {\small Step 1};
                    \node[below] at (4.5,-0.2) {\small Step 2};
                    \node[below] at (9.0,-0.2) {\small Step 3};
                    \node[below] at (14.5,-0.2) {\small Step 4};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
            </statement>
            <solution component="lesson-plan">
                <p>
                    <md> T_n = n(n+1) </md>
                </p>
            </solution>
        </task>

        <task>
            <title>Pattern C</title>
            <statement>
            <figure xml:id="fig-seq-staircase-pattern">
                <caption>Staircase pattern — Steps 1 to 4.</caption>
                <image width="90%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.65]
                    % Tile (col,row) exists at step n when col+row &lt;= n-1.
                    % NEW tiles at step n: col+row = n-1 (outermost anti-diagonal).
                    % Odd steps = teal, even steps = orange.
                    % Step 1: single tile, col+row=0, teal
                    \filldraw[fill=teal!65, draw=black] (0,0) rectangle ++(1,1);
                    % Step 2 (x-offset 2): col+row=0 -> teal (old); col+row=1 -> orange (new)
                    \filldraw[fill=teal!65, draw=black]         (2,0) rectangle ++(1,1); % (col=0,row=0)
                    \filldraw[fill=orange!85!yellow, draw=black] (3,0) rectangle ++(1,1); % (col=1,row=0) new
                    \filldraw[fill=orange!85!yellow, draw=black] (2,1) rectangle ++(1,1); % (col=0,row=1) new
                    % Step 3 (x-offset 5): col+row=0 teal, col+row=1 orange (old), col+row=2 teal (new)
                    \filldraw[fill=teal!65, draw=black]         (5,0) rectangle ++(1,1); % (0,0)
                    \filldraw[fill=orange!85!yellow, draw=black] (6,0) rectangle ++(1,1); % (1,0)
                    \filldraw[fill=teal!65, draw=black]         (7,0) rectangle ++(1,1); % (2,0) new
                    \filldraw[fill=orange!85!yellow, draw=black] (5,1) rectangle ++(1,1); % (0,1)
                    \filldraw[fill=teal!65, draw=black]         (6,1) rectangle ++(1,1); % (1,1) new
                    \filldraw[fill=teal!65, draw=black]         (5,2) rectangle ++(1,1); % (0,2) new
                    % Step 4 (x-offset 9): col+row=0 teal, =1 orange, =2 teal (old); =3 orange (new)
                    \filldraw[fill=teal!65, draw=black]         (9,0) rectangle ++(1,1);  % (0,0)
                    \filldraw[fill=orange!85!yellow, draw=black] (10,0) rectangle ++(1,1); % (1,0)
                    \filldraw[fill=teal!65, draw=black]         (11,0) rectangle ++(1,1); % (2,0)
                    \filldraw[fill=orange!85!yellow, draw=black] (12,0) rectangle ++(1,1); % (3,0) new
                    \filldraw[fill=orange!85!yellow, draw=black] (9,1) rectangle ++(1,1);  % (0,1)
                    \filldraw[fill=teal!65, draw=black]         (10,1) rectangle ++(1,1); % (1,1)
                    \filldraw[fill=orange!85!yellow, draw=black] (11,1) rectangle ++(1,1); % (2,1) new
                    \filldraw[fill=teal!65, draw=black]         (9,2) rectangle ++(1,1);  % (0,2)
                    \filldraw[fill=orange!85!yellow, draw=black] (10,2) rectangle ++(1,1); % (1,2) new
                    \filldraw[fill=orange!85!yellow, draw=black] (9,3) rectangle ++(1,1);  % (0,3) new
                    \node[below] at (0.5,-0.2) {\small Step 1};
                    \node[below] at (3.0,-0.2) {\small Step 2};
                    \node[below] at (6.5,-0.2) {\small Step 3};
                    \node[below] at (11.0,-0.2) {\small Step 4};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
            <note component="lesson-plan">
                <p>
                    Draw learners' attention to the link with Pattern B: if you duplicate each shape and rearrange the two copies, you can get the rectangle pattern. This is a common way to derive the formula for this pattern.
                </p>
            </note>
            </statement>
            <solution component="lesson-plan">
                <p>
                    <md>T_n = \frac{n(n+1)}{2}</md>
                </p>
            </solution>
        </task>

        <task>
            <title>Pattern D</title>
            <statement>
            <figure xml:id="fig-seq-doubling-pattern">
                <caption>Doubling pattern — Steps 1 to 4.</caption>
                <image width="90%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.65]
                    % Blue = tiles carried over from the previous step. Pink = newly added tiles.
                    % Step 1: 1x1, all new -> pink
                    \filldraw[fill=pink!80, draw=black] (0,0) rectangle ++(1,1);
                    % Step 2: 1x2; left tile old (blue), right tile new (pink)
                    \filldraw[fill=blue!45!white, draw=black] (2,0) rectangle ++(1,1); % old
                    \filldraw[fill=pink!80,       draw=black] (3,0) rectangle ++(1,1); % new
                    % Step 3: 2x2; bottom row old (blue), top row new (pink)
                    \filldraw[fill=blue!45!white, draw=black] (5,0) rectangle ++(1,1); % old
                    \filldraw[fill=blue!45!white, draw=black] (6,0) rectangle ++(1,1); % old
                    \filldraw[fill=pink!80,       draw=black] (5,1) rectangle ++(1,1); % new
                    \filldraw[fill=pink!80,       draw=black] (6,1) rectangle ++(1,1); % new
                    % Step 4: 2x4; left 2x2 old (blue), right 2x2 new (pink)
                    \filldraw[fill=blue!45!white, draw=black] (8,0)  rectangle ++(1,1); % old
                    \filldraw[fill=blue!45!white, draw=black] (9,0)  rectangle ++(1,1); % old
                    \filldraw[fill=pink!80,       draw=black] (10,0) rectangle ++(1,1); % new
                    \filldraw[fill=pink!80,       draw=black] (11,0) rectangle ++(1,1); % new
                    \filldraw[fill=blue!45!white, draw=black] (8,1)  rectangle ++(1,1); % old
                    \filldraw[fill=blue!45!white, draw=black] (9,1)  rectangle ++(1,1); % old
                    \filldraw[fill=pink!80,       draw=black] (10,1) rectangle ++(1,1); % new
                    \filldraw[fill=pink!80,       draw=black] (11,1) rectangle ++(1,1); % new
                    \node[below] at (0.5,-0.2) {\small Step 1};
                    \node[below] at (3.0,-0.2) {\small Step 2};
                    \node[below] at (6.0,-0.2) {\small Step 3};
                    \node[below] at (10.0,-0.2) {\small Step 4};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
            </statement>
            <solution component="lesson-plan">
                <p>
                    <md>
                        T_n = 2^{n-1}
                    </md>
                </p>
            </solution>
        </task>

        <conclusion>
            <p>
                Share your findings with another group.
            </p>
        </conclusion>
    </activity>

     <p>
        Look around your school, rows of desks, steps on a staircase, days in a timetable. Many things in life follow an order.
     </p>


    <axiom component="lesson-plan">
        <title>Structured Instruction</title>
        <p>
            <dl>
            <li>
                <title>Suggested Time</title>
                <p>
                    5 minutes
                </p>
            </li>
            <li>
                <title>Objective</title>
                <p>
                    Connect the visual patterns to the idea of a sequence, and to the notation for sequences.
                </p>
            </li>
            <li>
                <title>Teacher's Role</title>
                <p>
                    Make sure learners understand that there is nothing special about <m>a</m>: we could also have a sequence with terms <m>s_1, s_2, s_3, \ldots</m> etc.
                </p>
            </li>
            </dl>
        </p>
    </axiom>

    <insight>
        <p>
            A <term>sequence</term> is an ordered list of numbers that follow a rule. Each number in the list is called a <term>term</term>.
        </p>
        <p>
            We can write a sequence as: <m>a_1, \; a_2, \;a_3, \; a_4, \; \ldots, a_n</m>
        </p>
        <p>
            <ul>
                <li>
                    <p>
                        <m>a_1</m> is the first term,
                    </p>
                </li>
                <li>
                    <p>
                        <m>a_2</m> is the second term,
                    </p>
                </li>
                <li>
                    <p>
                        <m>a_n</m> is the <m>n^{\text{th}}</m> term.
                    </p>
                </li>
            </ul>
        </p>
    </insight>

    <p>
        Sequences help us describe patterns, predict what comes next, and solve problems involving repeated steps.
     </p>
     <p>
        They let us turn patterns into formulas. Instead of counting every step, we can find the <m>20^{\text{th}}</m> term or the <m>100^{\text{th}}</m> term directly.
     </p>

    <xi:include href="../lesson-plan-templates/example-intro.ptx" />

    <!-- Add at least 3 examples -->
     <example>
        <statement>
            <p>
                For each of the following sequences, find the next three terms:
            </p>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                            <m>1,3,5,7,\ldots</m>
                        </p>
                    </li>
                    <li>
                        <p> 
                            <m>\frac{1}{3},\frac{1}{9},\frac{1}{27},\ldots </m>
                        </p>
                    </li>
                    <li>
                        <p>
                            <m>-3,6,-12,\ldots</m>
                        </p>
                    </li>
                    <li>
                        <p>
                            <m>1,8,27,\ldots </m>
                        </p>
                    </li>
                    
                </ol>
            </p>
        </statement>
        <solution>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                            To obtain the next term, add <m>2</m> to the preceeding term.
                        </p>
                        <p>
                           The next three terms are <m>9, 11, \;\text{and}\; 13</m> 
                        </p>
                    </li>
                    <li>
                        <p>
                            To obtain the next term, the preceeding term is multiplied by <m>\frac{1}{3} </m>
                        </p>
                        <p>
                            The next three terms are <m>\frac{1}{81},\frac{1}{243}, \;\text{and}\;\frac{1}{729} </m>
                        </p>
                    </li>
                    <li>
                        <p>
                            To obtain the <m>n^{\text{th}}</m> term, <m>n</m> is cubed.
                        </p>
                        <p>
                            The next three terms are <m>64, 125, \;\text{and}\; 216 </m>
                        </p>
                    </li>
                    <li>
                        <p>
                            The next term is obtained by multiplying the preceeding term by <m>-2</m>
                        </p>
                        <p>
                            The next three terms are <m>24, -48, \;\text{and } 96</m>
                        </p>
                    </li>
                </ol>
            </p>
        </solution>
     </example>
     <example>
        <statement>
            <p>
                The <m>n^{\text{th}}</m> term of a sequence is given by <m>2n+3</m>, find:
            </p>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                           The first term 
                        </p>
                    </li>
                    <li>
                        <p>
                            The fifth term
                        </p>
                    </li>
                    <li>
                        <p>
                            The twelfth term
                        </p>
                    </li>
                </ol>
            </p>
        </statement>
        <solution>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                            For the first term, <m>n=1</m>
                        </p>
                        <p>
                            Substituting, <m>2\times 1+3 = 5</m>
                        </p>
                    </li>
                    <li>
                        <p>
                            For the fifth term, <m>n=5</m>
                        </p>
                        <p>
                            Substituting, <m>2\times 5+3 = 13</m>
                        </p>
                    </li>
                    <li>
                        <p>
                            For the twelfth term, <m>n=12</m>
                        </p>
                        <p>
                            Substituting, <m>2\times 12+3 = 27</m>
                        </p>
                    </li>
                </ol>
            </p>
        </solution>
     </example>
     <example>
        <statement>
            <p>
                Deduce the general rule in the sequence given below; <m>2,5,8,11 ,\ldots</m>
            </p>
        </statement>
        <solution>
            <p>
                Notice that the first term is <m>2</m>, the second is <m>5</m>, the third is <m>8</m>, and the forth is <m>11</m>
            </p>
            <tabular bottom="medium" top="medium" right="medium" left="medium">
                <row header="yes">
                    <cell>Position</cell>
                    <cell><m>1</m></cell>
                    <cell><m>2</m></cell>
                    <cell><m>3</m></cell>
                    <cell><m>4</m></cell>
                    <cell><m>5</m></cell>
                </row>
                <row>
                    <cell>Term</cell>
                    <cell><m>2</m></cell>
                    <cell><m>5</m></cell>
                    <cell><m>8</m></cell>
                    <cell><m>11</m></cell>
                    <cell><m>?</m></cell>
                </row>
            </tabular>
            <p>
                Notice that the second, third, and fourth terms can be obtained by adding <m>3</m> to the previous term. 
            </p>
            <p>
                The first term is <m>2</m>, which is equivalent to <m> 2 = 3 \times 1 -1 </m>
            </p>
            <p>
                The second term <m>5 = 3 \times 2 -1</m>
            </p>
            <p>
                The third term <m>8 = 3 \times 3 -1</m>
            </p>
            <p>
                The fourth term <m>11 = 3 \times 4 -1</m>
            </p>
            <p>
                From this, the <m>n^{\text{th}}</m> term is <m>3 \times n - 1 = 3n-1</m>
            </p>
        </solution>
     </example>

    

