<?xml version="1.0" encoding="utf-8"?>

<section xml:id="sec-sum-of-geometric-sequences-i" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Sum of Geometric Sequences I</title>
    <!--  -->
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        1.0 Numbers and Algebra
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>
                        1.6 Sequences and Series
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title> 
                    <p>
                        Determine the sum of terms in arithmetic and geometric series
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        11
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>
                        40 minutes
                    </p>
                </li>
            </dl>
            </p>
        </introduction>
    </objectives>

    <!-- [LP] Add guidance on activity -->

    <axiom component="lesson-plan">
            <title>Problem-Solving and Discovery</title>
            <dl>
                <li>
                    <title>Suggested Time</title>
                    <p>
                        10 minutes
                    </p>
                </li>
                <li>
                    <title>Objective</title>
                    <p>
                        To show learners how quickly the sum of a geometric sequence can grow, and motivate the formula.
                    </p>
                </li>
            </dl>
        </axiom>

    <!-- Add Activity -->
     <activity>
        <statement>

            <p>
                A farmer places grains of rice on a board such that:
            </p>
            <p>
                <ol marker="(i)">
                    <li>
                        <p><m>1</m> grain is placed on the first square,</p>
                    </li>
                    <li>
                        <p><m>2</m> grains on the second square,</p>
                    </li>
                    <li>
                        <p><m>4</m> grains on the third square,</p>
                    </li>
                    <li>
                        <p>and the number of grains keeps doubling on each square.</p>
                    </li>
                </ol>
            </p>
            <p>
                The board has 9 squares arranged in a <m>3 \times 3</m> grid.
            </p>

            <!-- <figure xml:id="fig-rice-board-activity">
                <caption>A <m>3 \times 3</m> board showing the number of rice grains on each square.</caption>
                <image width="55%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.9]
                    % 3x3 rice board — alternating teal/orange by odd/even position
                    % Squares numbered 1-9 reading left-to-right, top-to-bottom
                    % Values: 1, 2, 4, 8, 16, 32, 64, 128, 256
                    \foreach \val/\r/\c/\sqcol in {
                        1/0/0/teal, 2/0/1/orange, 4/0/2/teal,
                        8/1/0/orange, 16/1/1/teal, 32/1/2/orange,
                        64/2/0/teal, 128/2/1/orange, 256/2/2/teal
                    } {
                        \filldraw[fill=\sqcol!50, draw=black] ({\c*1.8},{-\r*1.8}) rectangle ++(1.8,1.8);
                        \node[font=\bfseries] at ({\c*1.8+0.9},{-\r*1.8+0.9}) {\val};
                        \node[font=\tiny, gray] at ({\c*1.8+0.22},{-\r*1.8+1.58}) {\tiny sq.\,\pgfmathparse{int(\r*3+\c+1)}\pgfmathresult};
                    }
                    % Column label
                    \node[below] at (2.7,-5.6) {\small (number of grains per square)};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure> -->

            <p>
                <term>Work in groups:</term>
            </p>
            <p>
            <ol marker="(a)">
                <li>
                    <p>Write the number of grains on each of the <m>9</m> squares.</p>
                </li>
                <li>
                    <p>Find the total number of grains on the board.</p>
                </li>
                <li>
                    <p>Describe the pattern you observe.</p>
                </li>
            </ol>
            </p>
            <p>
                <term>Extension:</term>
            </p>
            <p>
                <ol marker="(i)">
                    <li>
                        <p>If the board had <m>20</m> squares, would it be efficient to add all the grains one by one? Explain.</p>
                    </li>
                    <li>
                        <p>Suggest a faster method for finding the total number of grains.</p>
                    </li>
                </ol>
            </p>
            <p>
                <term>Guided Exploration:</term>
            </p>

            <p>
                Let the total number of grains on the <m>9</m> squares be:
            </p>

            <p>
                <md>S_9 = 1 + 2 + 4 + 8 + \dots + 2^8</md>
            </p>

            <p>
                Multiply both sides by <m>2</m>.
            </p>
            <p>
                <ol marker="(i)">
                    <li>
                        <p>Write an expression for <m>2S_9</m>.</p>
                    </li>
                    <li>
                        <p>Compare <m>S_9</m> and <m>2S_9</m>. What do you notice?</p>
                    </li>
                    <li>
                        <p>Subtract the two expressions. Which terms remain?</p>
                    </li>
                    <li>
                        <p>Hence determine the value of <m>S_9</m>.</p>
                    </li>
                </ol>
            </p>

            <p>
                <term>Generalising:</term>
            </p>

            <p>
                If the first term is <m>a</m> and the common ratio is <m>r</m>, then:
            </p>

            <p>
                <md>S_n = a + ar + ar^2 + \dots + ar^{n-1}</md>
            </p>

            <p>
                <term>Task:</term> Repeat the process above to obtain a general formula for <m>S_n</m>.
            </p>

        </statement>
        
     </activity>

    <!-- [LP] Add guidance on structured lesson plan-->

    <axiom component="lesson-plan">
        <title>Structured Instruction</title>
        <p>
            <dl>
            <li>
                <title>Suggested Time</title>
                <p>
                    5 minutes
                </p>
            </li>
            <li>
                <title>Objective</title>
                <p>
                    To formalize the concepts and properties learners discovered in the anchor task.
                </p>
            </li>
            <li>
                <title>Teacher's Role</title>
                <p>
                    Emphasise that both forms of the sum (with either <m>r - 1</m> or <m>1 - r</m> on the denominator) are equivalent, and that the form with <m>1 - r</m> is more convenient when <m>|r| &lt; 1</m>.
                </p>
            </li>
            </dl>
        </p>
    </axiom>

    <insight>
        <p>
            Suppose that <m>T_n = ar^{n-1}</m> is a geometric sequence. We can find the sum of the first <m>n</m> terms by:
            <md> S_n = \frac{a\left(r^n - 1\right)}{r - 1} = \frac{a\left(1-r^n\right)}{1-r} </md>
        </p>
    </insight>

    <!-- Add further instruction (not in a block) to develop ideas as needed -->

    <xi:include href="../lesson-plan-templates/example-intro.ptx" />

    <!-- Add at least 3 examples -->
     <example>
        <statement>
            <p>
                Find the sum of the first <m>9</m> terms of the geometric sequence given as <m>8,24,72, \ldots</m>
            </p>
        </statement>
        <solution>
            <p> We have <m>a = 8</m>, <m>r = 3</m> and <m>n = 9</m>. Substituting into the formula gives:
                <md>
                    <mrow> S_n =  \amp \frac{a(r^n-1)}{r-1} </mrow>
                    <mrow>S_9 \amp =  \frac{8(3^9 - 1)}{3-1} </mrow>
                    <mrow> \amp =  \frac{8(19683-1)} {2}</mrow>
                    <mrow> \amp = 78728 </mrow>
                </md>
                
            </p>
        </solution>
     </example>
     <example>
        <statement>
            <p>
                The sum of the first three terms of a geometric series is <m>26</m>. If the common ratio is <m>3</m>, find the sum of the first six terms.
            </p>
        </statement>
        <solution>
            <p>
                <md>
                    <mrow>S_3 = 26 \amp </mrow>
                    <mrow> r \amp = 3 </mrow>
                    <mrow>n \amp = 3 </mrow>
                    <mrow> S_n \amp = \frac{a(r^n-1)}{r-1} </mrow>
                    <mrow> \text{Substituting} \amp </mrow>
                    <mrow> 26 \amp = \frac{a(3^3 - 1)}{3-1} </mrow>
                    <mrow> a \amp = \frac{26 \times 2}{26} </mrow>
                    <mrow> \amp = 2 </mrow>
                    <mrow> S_6 \amp = \frac{2(3^6 - 1)}{3-1} </mrow>
                    <mrow> \amp = 728 </mrow>
                </md>
                
            </p>
        </solution>
     </example>

    <xi:include href="../lesson-plan-templates/assessment-intro.ptx" />

    <!-- If STACK questions are included, uncomment this: -->

    <!-- <xi:include href="../lesson-plan-templates/checkpoint.ptx" /> -->

    <!-- Add STACK exercises if made -->
     <exercises>
        <exercise>
            <statement>
                <p>
                    The fourth term of a geometric sequence is <m>192</m>. If the first term of the sequence is <m>3</m>, find:
                </p>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                The common ratio.
                            </p>
                        </li>
                        <li>
                            <p>
                                The number of terms that will give a sum of <m>255</m>.
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m> r = 4</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m> n = 4</m>
                            </p>
                        </li>
                    </ol>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    A geometric series has the first term as <m>2</m>. Find the two common ratios if the sum of the first three terms is <m>26</m>.
                </p>
            </statement>
            <answer>
                <p>
                    <m> r = 3 \; \text{or} \; -4 </m>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    In a geometric progression, the sum of the <m>2^{\text{nd}} </m> and <m>3^{\text{rd}} </m> terms is <m>4</m> and the sum of <m>3^{\text{rd}} </m> and <m>4^{\text{th}} </m> terms is <m>2</m>. Find the first term and the common ratio.
                </p>
            </statement>
            <answer>
                <p>
                    <m> a = -16, r = -\frac{1}{2} </m>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The <m>2^{\text{nd}}, 4^{\text{th}},\;\text{and}\; 7^{\text{th}} </m> terms of an arithmetic progression are the first three consecutive terms of a geometric progression. Find:
                </p>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                The common ratio.
                            </p>
                        </li>
                        <li>
                            <p>
                                The sum of the first eight terms of the geometric progression. If the common difference of the arithmetic progression is <m>2</m>.
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m> r = 1\frac{1}{2} </m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>S_8 = 394.06</m>
                            </p>
                        </li>
                    </ol>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The sum of the first three terms of a geometric sequence is <m>14</m>. If the common ratio is <m>-3</m>, find the sum of the first five terms. 
                </p>
            </statement>
            <answer>
                <p>
                    <m> 122</m>
                </p>
            </answer>
        </exercise>
        <exercise>
            <introduction>
                <p>
                    The diagram shows the first two stages of constructing a Sierpinski triangle.
                    The original triangle has area <m>16 \text{ cm}^2</m>.
                    At each stage, the middle triangle of every filled triangle is removed.
                    White triangles show areas removed at Stage 1; grey triangles show areas removed at Stage 2.
                    Numbers indicate area in cm<m>^2</m>.
                </p>
                <figure xml:id="fig-sierpinski-finite-sum">
                    <caption>Removed areas at Stages 1 and 2 of the Sierpinski triangle (areas in cm<m>^2</m>).</caption>
                    <image width="85%">
                        <latex-image>
                        \begin{tikzpicture}[scale=1.5]
                        % Stage 1: big teal triangle, stage-1 middle removed (white)
                        \filldraw[fill=teal!50, draw=black] (0,0) -- (2,0) -- (1,1.732) -- cycle;
                        \filldraw[fill=white, draw=black!60] (1,0) -- (1.5,0.866) -- (0.5,0.866) -- cycle;
                        \node[font=\small] at (1,0.45) {$4$};
                        \node[below] at (1,-0.22) {\small Stage 1};

                        % Stage 2: 3 teal sub-triangles, stage-1 middle white, 3 new middles grey
                        \filldraw[fill=teal!50, draw=black] (3,0) -- (4,0) -- (3.5,0.866) -- cycle;
                        \filldraw[fill=teal!50, draw=black] (4,0) -- (5,0) -- (4.5,0.866) -- cycle;
                        \filldraw[fill=teal!50, draw=black] (3.5,0.866) -- (4.5,0.866) -- (4,1.732) -- cycle;
                        % Stage 1 removed (white, shown again):
                        \filldraw[fill=white, draw=black!60] (4,0) -- (4.5,0.866) -- (3.5,0.866) -- cycle;
                        \node[font=\small] at (4,0.45) {$4$};
                        % Stage 2 new removed (grey, 1 cm^2 each):
                        \filldraw[fill=black!12, draw=black!50] (3.5,0) -- (3.75,0.433) -- (3.25,0.433) -- cycle;
                        \node[font=\tiny] at (3.5,0.24) {$1$};
                        \filldraw[fill=black!12, draw=black!50] (4.5,0) -- (4.75,0.433) -- (4.25,0.433) -- cycle;
                        \node[font=\tiny] at (4.5,0.24) {$1$};
                        \filldraw[fill=black!12, draw=black!50] (4,0.866) -- (4.25,1.299) -- (3.75,1.299) -- cycle;
                        \node[font=\tiny] at (4,1.02) {$1$};
                        \node[below] at (4,-0.22) {\small Stage 2};
                        \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
                <p>
                    At Stage 1, one triangle of area <m>4 \text{ cm}^2</m> is removed.
                    At Stage 2, three triangles of area <m>1 \text{ cm}^2</m> each are removed (total <m>3 \text{ cm}^2</m>).
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        Write down the total area removed at Stage 1, Stage 2, and Stage 3.
                        Show that these form a geometric sequence and state the first term and common ratio.
                    </p>
                </statement>
                <answer>
                    <p>
                        Stage 1: <m>4</m>, Stage 2: <m>3</m>, Stage 3: <m>\frac{9}{4}</m>.
                        Geometric with <m>a = 4</m>, <m>r = \frac{3}{4}</m>.
                    </p>
                </answer>
                <solution>
                    <p>
                        At Stage 3, the 9 removed triangles each have area <m>\frac{1}{4} \text{ cm}^2</m>,
                        giving total <m>\frac{9}{4} \text{ cm}^2</m>.
                        <md>
                            <mrow>\frac{3}{4} \amp =\; \frac{3}{4}, \qquad \frac{9/4}{3} = \frac{3}{4}</mrow>
                        </md>
                        The common ratio is <m>r = \dfrac{3}{4}</m>.
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        Use the formula <m>S_n = \dfrac{a(1-r^n)}{1-r}</m> to find the total area removed after 4 stages.
                    </p>
                </statement>
                <answer>
                    <p>
                        <m>S_4 = \dfrac{175}{16} = 10.9375 \text{ cm}^2</m>
                    </p>
                </answer>
                <solution>
                    <p>
                        <md>
                            <mrow>S_4 \amp =\; \frac{4\!\left(1-\left(\frac{3}{4}\right)^4\right)}{1-\frac{3}{4}}</mrow>
                            <mrow> \amp =\; \frac{4\!\left(1-\frac{81}{256}\right)}{\frac{1}{4}}</mrow>
                            <mrow> \amp =\; 16\left(\frac{175}{256}\right) = \frac{175}{16} \approx 10.94 \text{ cm}^2</mrow>
                        </md>
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        Write a formula for <m>S_n</m>, the total area removed after <m>n</m> stages.
                        What fraction of the original <m>16 \text{ cm}^2</m> remains after <m>n</m> stages?
                    </p>
                </statement>
                <answer>
                    <p>
                        <m>S_n = 16\!\left(1-\left(\tfrac{3}{4}\right)^n\right)</m>; remaining fraction <m>= \left(\tfrac{3}{4}\right)^n</m>.
                    </p>
                </answer>
                <solution>
                    <p>
                        <md>
                            <mrow>S_n \amp =\; \frac{4\!\left(1-\left(\frac{3}{4}\right)^n\right)}{\frac{1}{4}} = 16\!\left(1-\left(\frac{3}{4}\right)^n\right)</mrow>
                        </md>
                        Area remaining <m>= 16 - S_n = 16\!\left(\frac{3}{4}\right)^n</m>,
                        so the fraction remaining is <m>\left(\dfrac{3}{4}\right)^n</m>.
                    </p>
                </solution>
            </task>
        </exercise>
     </exercises>

