    <!-- Add Activity -->
     <activity>
        <statement>
            <p>
                <alert>Group Exploration: Finding the Pattern</alert>
            </p>
            <p>
                Consider the sequence: <m>3, 7, 11, 15, \dots</m>
            </p>
            <p>
                <ol>
                    <li>
                        <p>Find the next three terms of the sequence.</p>
                    </li>
                    <li>
                        <p>Discuss with your group: How is each term related to the one before it?</p>
                    </li>
                    <li>
                        <p>Share your findings with other groups.</p>
                    </li>
                </ol>
            </p>
            <p>
                <alert>Challenge:</alert> Without listing all the terms, how could you find the <m>20^{\text{th}}</m> term? Can you write a general rule for the <m>n^{\text{th}}</m> term?
            </p>
        </statement>
        <solution component="lesson-plan">
            <p>
                The next term is obtained by adding <m>4</m> to the preceding term. This constant value <m>4</m> is called the <term>common difference</term> (<m>d</m>). It is the difference between any two consecutive terms:
                <md>
                    <mrow>d = 7 - 3 = 11 - 7 = 4</mrow>
                </md>
            </p>
        </solution>
     </activity>

