<?xml version="1.0" encoding="utf-8"?>

<section xml:id="sec-geometric-sequences" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Geometric Sequences</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        1.0 Numbers and Algebra
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>
                        1.6 Sequences and Series
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title> 
                    <p>
                            <ul>
                              <li>Determine nth term in a number sequences</li>
                              <li>Compute the terms and common ratio in a geometric sequence and series</li>
                            </ul>
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        11
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>
                        40 minutes
                    </p>
                </li>
            </dl>
            </p>
        </introduction>
    </objectives>

    <!-- [LP] Add guidance on activity -->

    <axiom component="lesson-plan">
        <title>Problem-Solving and Discovery</title>
        <dl>
            <li>
                <title>Suggested Time</title>
                <p>
                    10 minutes
                </p>
            </li>
            <li>
                <title>Objective</title>
                <p>
                    To engage learners in exploring and identifying patterns in geometric sequences through a visual and collaborative activity.
                </p>
            </li>
            <li>
                <title>Teacher's Role</title>
                <p>
                    Facilitate group work, encourage discussion, and guide learners to discover the concept of geometric sequences and the formula for the nth term.
                </p>
            </li>
        </dl>
    </axiom>

    <!-- Add Activity -->

    <activity>
        <statement>

            <p>
                A square is divided into <m>4</m> equal smaller squares by splitting it into a <m>2 \times 2</m> grid.
            </p>

            <p>
                At each new stage, <em>every square</em> is divided again into <m>4</m> equal smaller squares.
            </p>

            <figure xml:id="fig-square-subdivision-activity">
                <caption>Stages 1 to 4 of the square subdivision process.</caption>
                <image width="85%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.9]
                    % Each stage drawn as a fixed 2x2 outer square with internal grid lines.
                    % Stage 1: 1 square — teal
                    \filldraw[fill=teal!55, draw=black] (0,0) rectangle ++(2,2);
                    % Stage 2: 2x2 grid (4 squares) — orange
                    \filldraw[fill=teal!55, draw=black] (2.8,0) rectangle ++(2,2);
                    \draw[black] (3.8,0) -- (3.8,2);
                    \draw[black] (2.8,1) -- (4.8,1);
                    % Stage 3: 4x4 grid (16 squares) — teal
                    \filldraw[fill=teal!55, draw=black] (5.6,0) rectangle ++(2,2);
                    \foreach \i in {1,2,3} {
                        \draw[black] ({5.6+\i*0.5},0) -- ({5.6+\i*0.5},2);
                        \draw[black] (5.6,{\i*0.5}) -- (7.6,{\i*0.5});
                    }
                    % Stage 4: 8x8 grid (64 squares) — teal
                    \filldraw[fill=teal!55, draw=black] (8.4,0) rectangle ++(2,2);
                    \foreach \i in {1,...,7} {
                        \draw[black, very thin] ({8.4+\i*0.25},0) -- ({8.4+\i*0.25},2);
                        \draw[black, very thin] (8.4,{\i*0.25}) -- (10.4,{\i*0.25});
                    }
                    % Labels
                    \node[below] at (1.0,-0.2) {\small Stage 1};
                    \node[below] at (3.8,-0.2) {\small Stage 2};
                    \node[below] at (6.6,-0.2) {\small Stage 3};
                    \node[below] at (9.4,-0.2) {\small Stage 4};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>

            <p>
                <term>Work in groups:</term>
            </p>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>Count the total number of small squares at each stage.</p>
                    </li>
                    <li>
                        <p>Record your results in a table.</p>
                    </li>
                </ol>
            </p>
                <tabular left="medium" right="medium" top="medium" bottom="medium">
                    <row header="yes">
                        <cell>Stage (n)</cell>
                        <cell>Number of squares</cell>
                    </row>
                    <row>
                        <cell>1</cell>
                        <cell>1</cell>
                    </row>
                    <row>
                        <cell>2</cell>
                        <cell>?</cell>
                    </row>
                    <row>
                        <cell>3</cell>
                        <cell>?</cell>
                    </row>
                    <row>
                        <cell>4</cell>
                        <cell>?</cell>
                    </row>
                </tabular>
            <p>
                <ol marker="(i)">
                    <li>
                        <p>Describe how the number of squares changes from one stage to the next.</p>
                    </li>
                    <li>
                        <p>Write the sequence formed.</p>
                    </li>
                </ol>
            </p>

            <p>
                <term>Discussion:</term>
            </p>

            <p>
                The numbers form the sequence:
                <m>1, 4, 16, 64, \dots</m>
            </p>

            <p>
                Each term is obtained by multiplying the previous term by 4.
            </p>
            <p>
                <ol marker="(i)">
                    <li>
                        <p>What will be the number of squares at Stage 5? Stage 6?</p>
                    </li>
                    <li>
                        <p>Is it practical to keep counting for very large stages?</p>
                    </li>
                </ol>
            </p>
            <p>
                <term>Generalising:</term>
            </p>

            <p>
                Let:
            </p>
            <p>
                <ul>
                    <li>
                        <p>First term <m>= a</m></p>
                    </li>
                    <li>
                        <p>Common ratio <m>= r</m></p>
                    </li>
                </ul>
            </p>
            <p>
                <term>Task:</term>
            </p>
            <p>
                <ol marker="(i)">
                    <li>
                        <p>Write Stage 2 in terms of <m>a</m> and <m>r</m>.</p>
                    </li>
                    <li>
                        <p>Write Stage 3 in terms of <m>a</m> and <m>r</m>.</p>
                    </li>
                    <li>
                        <p>Write Stage 4 in terms of <m>a</m> and <m>r</m>.</p>
                    </li>
                    <li>
                        <p>Identify the pattern and write an expression for Stage <m>n</m>.</p>
                    </li>
                </ol>
            </p>
        </statement>
    </activity>

    <!-- [LP] Add guidance on structured lesson plan-->

    <axiom component="lesson-plan">
        <title>Structured Instruction</title>
        <p>
            <dl>
            <li>
                <title>Suggested Time</title>
                <p>
                    5 minutes
                </p>
            </li>
            <li>
                <title>Objective</title>
                <p>
                    To formalize the concepts and properties learners discovered in the anchor task.
                </p>
            </li>
            <li>
                <title> Teacher's Role</title>
                <p>
                    Make sure learners understand why the power in the formula is <m>n-1</m>, not <m>n</m> (i.e., why the first term corresponds to <m>n=1</m> and not <m>n=0</m>).
                </p>
            </li>
            </dl>
        </p>
    </axiom>

    <!-- Add insight / key takeaway directly related to activity / learner experience -->

    <insight>
        <p>
            A geometric sequence is a sequence in which each term is obtained by multiplying the previous term by a constant value called the common ratio.
        </p>
        <p>
            If the first term is <m>a</m> and the common ratio is <m>r</m>, then the <m>n^{\text{th}}</m> term <m>t_n</m> is given by:
        </p>
        <p>
            <m>t_n = ar^{n-1}</m>
        </p>
        <p>
            This formula allows us to determine any term in the sequence without listing all previous terms.
        </p>
    </insight>

    <!-- Add further instruction (not in a block) to develop ideas as needed -->

    <xi:include href="../lesson-plan-templates/example-intro.ptx" />

    <!-- Add at least 3 examples -->

    <example>
        <statement>
            <p>
                The diagram shows the first three stages of a Sierpinski triangle.
                At each new stage, the middle triangle of every filled triangle is removed,
                leaving three smaller filled triangles in its place.
            </p>
            <figure xml:id="fig-geom-sierpinski-example">
                <caption>Stages 1 to 3 of the Sierpinski triangle.</caption>
                <image width="85%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.9]
                    % Stage 1: 1 filled equilateral triangle, side 2
                    \filldraw[fill=teal!55, draw=black] (0,0) -- (2,0) -- (1,1.732) -- cycle;
                    \node[below] at (1,-0.25) {\small Stage 1};

                    % Stage 2: 3 filled triangles of side 1
                    \filldraw[fill=teal!55, draw=black] (3,0) -- (4,0) -- (3.5,0.866) -- cycle;
                    \filldraw[fill=teal!55, draw=black] (4,0) -- (5,0) -- (4.5,0.866) -- cycle;
                    \filldraw[fill=teal!55, draw=black] (3.5,0.866) -- (4.5,0.866) -- (4,1.732) -- cycle;
                    \node[below] at (4,-0.25) {\small Stage 2};

                    % Stage 3: 9 filled triangles of side 0.5
                    % BL cluster
                    \filldraw[fill=teal!55, draw=black] (6,0) -- (6.5,0) -- (6.25,0.433) -- cycle;
                    \filldraw[fill=teal!55, draw=black] (6.5,0) -- (7,0) -- (6.75,0.433) -- cycle;
                    \filldraw[fill=teal!55, draw=black] (6.25,0.433) -- (6.75,0.433) -- (6.5,0.866) -- cycle;
                    % BR cluster
                    \filldraw[fill=teal!55, draw=black] (7,0) -- (7.5,0) -- (7.25,0.433) -- cycle;
                    \filldraw[fill=teal!55, draw=black] (7.5,0) -- (8,0) -- (7.75,0.433) -- cycle;
                    \filldraw[fill=teal!55, draw=black] (7.25,0.433) -- (7.75,0.433) -- (7.5,0.866) -- cycle;
                    % Top cluster
                    \filldraw[fill=teal!55, draw=black] (6.5,0.866) -- (7,0.866) -- (6.75,1.299) -- cycle;
                    \filldraw[fill=teal!55, draw=black] (7,0.866) -- (7.5,0.866) -- (7.25,1.299) -- cycle;
                    \filldraw[fill=teal!55, draw=black] (6.75,1.299) -- (7.25,1.299) -- (7,1.732) -- cycle;
                    \node[below] at (7,-0.25) {\small Stage 3};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
            <p>
                <ol marker="(a)">
                    <li><p>Write down the first three terms of the sequence of filled triangles.</p></li>
                    <li><p>What is the common ratio? Explain why it makes geometric sense.</p></li>
                    <li><p>How many filled triangles are at Stage 4?</p></li>
                    <li><p>Write a formula for <m>T_n</m>, the number of filled triangles at Stage <m>n</m>.</p></li>
                </ol>
            </p>
        </statement>
        <solution>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                            The number of filled triangles: <m>1, 3, 9</m>.
                        </p>
                    </li>
                    <li>
                        <p>
                            <md>
                                <mrow>r \amp =\; \frac{3}{1} = \frac{9}{3} = 3</mrow>
                            </md>
                            The common ratio is <m>r = 3</m>. This makes geometric sense: at every stage,
                            each filled triangle is split into three smaller ones (the central triangle is removed),
                            so the count always triples.
                        </p>
                    </li>
                    <li>
                        <p>
                            <md>
                                <mrow>T_4 \amp =\; 1 \times 3^{4-1} = 3^3 = 27 \text{ filled triangles}</mrow>
                            </md>
                        </p>
                    </li>
                    <li>
                        <p>
                            With first term <m>a = 1</m> and common ratio <m>r = 3</m>:
                            <md>
                                <mrow>T_n \amp =\; 3^{n-1}</mrow>
                            </md>
                        </p>
                    </li>
                </ol>
            </p>
        </solution>
    </example>

    <example>
        <statement>
            <p>
                A fractal tree grows by a simple rule: at each new stage, every tip branch splits
                into two new branches. The teal branches show the current tip branches;
                grey branches are from earlier stages.
            </p>
            <figure xml:id="fig-geom-tree-example">
                <caption>Stages 1 to 4 of a fractal branching tree.</caption>
                <image width="90%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.9]
                    % Stage 1: 1 tip branch (the trunk itself)
                    \draw[teal!70!black, line width=2pt] (0.8,0) -- (0.8,1.0);
                    \filldraw[teal!70!black] (0.8,1.0) circle (3pt);
                    \node[below] at (0.8,-0.2) {\small Stage 1};

                    % Stage 2: trunk (grey) splits into 2 tip branches (teal)
                    \draw[black!40, line width=1.5pt] (3.3,0) -- (3.3,0.8);
                    \draw[teal!70!black, line width=2pt] (3.3,0.8) -- (3.0,1.42);
                    \draw[teal!70!black, line width=2pt] (3.3,0.8) -- (3.6,1.42);
                    \filldraw[teal!70!black] (3.0,1.42) circle (2.5pt);
                    \filldraw[teal!70!black] (3.6,1.42) circle (2.5pt);
                    \node[below] at (3.3,-0.2) {\small Stage 2};

                    % Stage 3: each tip splits again — 4 tip branches
                    \draw[black!40, line width=1.5pt] (6.3,0) -- (6.3,0.8);
                    \draw[black!40, line width=1.5pt] (6.3,0.8) -- (6.0,1.42);
                    \draw[black!40, line width=1.5pt] (6.3,0.8) -- (6.6,1.42);
                    \draw[teal!70!black, line width=2pt] (6.0,1.42) -- (5.78,2.0);
                    \draw[teal!70!black, line width=2pt] (6.0,1.42) -- (6.22,2.0);
                    \draw[teal!70!black, line width=2pt] (6.6,1.42) -- (6.38,2.0);
                    \draw[teal!70!black, line width=2pt] (6.6,1.42) -- (6.82,2.0);
                    \filldraw[teal!70!black] (5.78,2.0) circle (2pt);
                    \filldraw[teal!70!black] (6.22,2.0) circle (2pt);
                    \filldraw[teal!70!black] (6.38,2.0) circle (2pt);
                    \filldraw[teal!70!black] (6.82,2.0) circle (2pt);
                    \node[below] at (6.3,-0.2) {\small Stage 3};

                    % Stage 4: 8 tip branches
                    \draw[black!40, line width=1.5pt] (9.8,0) -- (9.8,0.8);
                    \draw[black!40, line width=1.5pt] (9.8,0.8) -- (9.5,1.42);
                    \draw[black!40, line width=1.5pt] (9.8,0.8) -- (10.1,1.42);
                    \draw[black!40, line width=1.5pt] (9.5,1.42) -- (9.28,2.0);
                    \draw[black!40, line width=1.5pt] (9.5,1.42) -- (9.72,2.0);
                    \draw[black!40, line width=1.5pt] (10.1,1.42) -- (9.88,2.0);
                    \draw[black!40, line width=1.5pt] (10.1,1.42) -- (10.32,2.0);
                    \draw[teal!70!black, line width=2pt] (9.28,2.0) -- (9.14,2.45);
                    \draw[teal!70!black, line width=2pt] (9.28,2.0) -- (9.42,2.45);
                    \draw[teal!70!black, line width=2pt] (9.72,2.0) -- (9.58,2.45);
                    \draw[teal!70!black, line width=2pt] (9.72,2.0) -- (9.86,2.45);
                    \draw[teal!70!black, line width=2pt] (9.88,2.0) -- (9.74,2.45);
                    \draw[teal!70!black, line width=2pt] (9.88,2.0) -- (10.02,2.45);
                    \draw[teal!70!black, line width=2pt] (10.32,2.0) -- (10.18,2.45);
                    \draw[teal!70!black, line width=2pt] (10.32,2.0) -- (10.46,2.45);
                    \filldraw[teal!70!black] (9.14,2.45) circle (1.8pt);
                    \filldraw[teal!70!black] (9.42,2.45) circle (1.8pt);
                    \filldraw[teal!70!black] (9.58,2.45) circle (1.8pt);
                    \filldraw[teal!70!black] (9.86,2.45) circle (1.8pt);
                    \filldraw[teal!70!black] (9.74,2.45) circle (1.8pt);
                    \filldraw[teal!70!black] (10.02,2.45) circle (1.8pt);
                    \filldraw[teal!70!black] (10.18,2.45) circle (1.8pt);
                    \filldraw[teal!70!black] (10.46,2.45) circle (1.8pt);
                    \node[below] at (9.8,-0.2) {\small Stage 4};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
            <p>
                <ol marker="(a)">
                    <li><p>Write down the sequence formed by the number of tip branches and state the common ratio.</p></li>
                    <li><p>Find the number of tip branches at Stage 6.</p></li>
                    <li><p>At which stage will there first be more than 100 tip branches?</p></li>
                </ol>
            </p>
        </statement>
        <solution>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                            The sequence is <m>1, 2, 4, 8, \ldots</m> with common ratio <m>r = 2</m>.
                            Each tip splits into two, so the count always doubles.
                        </p>
                    </li>
                    <li>
                        <p>
                            <md>
                                <mrow>T_6 \amp =\; 1 \times 2^{6-1} = 2^5 = 32 \text{ tip branches}</mrow>
                            </md>
                        </p>
                    </li>
                    <li>
                        <p>
                            We need <m>2^{n-1} &gt; 100</m>.
                            <md>
                                <mrow>2^6 \amp =\; 64 &lt; 100</mrow>
                                <mrow>2^7 \amp =\; 128 &gt; 100</mrow>
                            </md>
                            So <m>n - 1 = 7</m>, giving <m>n = 8</m>.
                            Stage 8 is the first stage with more than 100 tip branches.
                        </p>
                    </li>
                </ol>
            </p>
        </solution>
    </example>

    <example>
        <statement>
            <p>
                Given the geometric sequence <m>4,12,36,...</m>, find the <m>4^{\text{th}}, 5^{\text{th}},</m> and <m>n^{\text{th}} </m> terms.
            </p>
        </statement>
        <solution>
            <p>
                <md>
                    <mrow> \text{The first term,}\; a =  \amp \; 4 </mrow>
                    <mrow> \text{The common ratio,}\; r \amp = \; 3 </mrow>
                    <mrow> \therefore \;\text{the}\; 4^{\text{th}}\; \text{term}\; \amp = \; 4\times 3^{4-1} </mrow>
                    <mrow> \amp = \; 4 \times 3^3 </mrow>
                    <mrow> \amp = \; 108 </mrow>
                    <mrow> \text{The}\; 5^{\text{th}} \; \text{term}\; \amp = \; 4 \times 3^{5-1} </mrow>
                    <mrow> \amp = \; 4 \times 3^4 </mrow>
                    <mrow> \amp = \; 324 </mrow>
                    <mrow> \text{The}\; n^{\text{th}} \; \text{term}\; \amp = \; 4 \times 3^{n-1} </mrow>
                </md>
                
            </p>
        </solution>
    </example>
    <example>
        <statement>
            <p>
                The <m>4^{\text{th}}</m> term of a geometric sequence is <m>16</m>. If the first term is <m>2</m>, find:
            </p>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                            The common ratio.
                        </p>
                    </li>
                    <li>
                        <p>
                            The seventh term.
                        </p>
                    </li>
                </ol>
            </p>
        </statement>
        <solution>
            <p>
                <ol marker="(a)">
                    <li>
                    <p>
                        The common ratio <m>r</m>.
                    </p>
                        <p>
                            <md>
                                <mrow> \text{The first term,} \; a \amp = \; 2 </mrow>
                                <mrow> \text{The}4^{\text{th}}\; \text{ term is}\; 2\times r^{4-1} \amp = \; 16 </mrow>
                                <mrow>\text{Thus,} \; 2r^3 \amp = \; 16 </mrow>
                                <mrow> r^3 \amp = \; 8 </mrow>
                                <mrow> \therefore \;\text{the common ratio} \; \amp = \; 2 </mrow>
                            </md>
                        </p>
                    </li>
                    <li>
                    <p>
                        The <m>7^{\text{th}}</m> term.
                    </p>
                        <p>
                            <md>
                                <mrow>\text{The}\; 7^{\text{th}}\; \text{term} \; \amp = \; 2 \times 2^6 </mrow>
                                <mrow> \amp = \; 128 </mrow>
                            </md>
                            
                        </p>
                    </li>
                </ol>
            </p>
        </solution>
    </example>
    <example>
        <statement>
            <p>
                The fourth term of a geometric sequence is <m>8</m> and the sixth term is <m>32</m>. Find the two possible common ratios.
            </p>
        </statement>
        <solution>
            <p>
                <md>
                    <mrow>\text{The}\; 4^{\text{th}} \;\text{term is} \; ar^3 \amp = \; 8 </mrow>
                    <mrow>\text{The}\; 6^{\text{th}} \;\text{term is} \; ar^5 \amp = \; 32 </mrow>
                    <mrow>\therefore \frac{ar^5}{ar^3} \amp = \; \frac{32}{8} </mrow>
                    <mrow> r^2 \amp = \; 4</mrow>
                    <mrow> r \amp = \; \pm 2 </mrow>
                </md>
            </p>
            <p>
                The possible common ratios are <m>r = 2</m> and <m>r = -2</m>.
            </p>
        </solution>
    </example>

    <xi:include href="../lesson-plan-templates/assessment-intro.ptx" />

    <!-- If STACK questions are included, uncomment this: -->

    <!-- <xi:include href="../lesson-plan-templates/checkpoint.ptx" /> -->

    <!-- Add STACK exercises if made -->

    <!-- Add static exercises -->
    <exercises>
        <exercise>
            <statement>
                <p>
                    The ratio of the <m>10^{\text{th}}</m> to the <m>8^{\text{th}}</m> terms of a geometric sequence is <m>9</m>. Find the two possible common ratios.
                </p>
            </statement>
            <answer>
                <p>
                    <m>\pm3</m>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The third term of a geometric sequence is <m>1</m>. If the sixth term of the same sequence is <m>\frac{1}{27}</m>, write down the first four terms of the sequence.
                </p>
            </statement>
            <answer>
                <p>
                    <m>9,3,1,\frac{1}{3}</m>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The ratio of the forth to the first term of a geometric sequence is <m>\frac{1}{8}</m>. If the first term exceeds the second term by <m>5</m>, find the first and the <m>8^{\text{th}}</m> terms of the sequence.
                </p>
            </statement>
            <answer>
                <p>
                    <m>10, \frac{5}{64}</m>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The first, third, and fifth terms of a geometric sequence form arithmetic sequence. If the first term of the sequence is <m>3</m>, find the tenth term of the geometric sequence.
                </p>
            </statement>
            <answer>
                <p>
                    <m>\pm3</m>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The first term of a geometric sequence is <m>x+1</m>. if the third term of the same sequence is <m>(x+1)(x^2 - 2x +1)</m>, show that the second term is <m>x^2 -1</m>.
                </p>
            </statement>
            <answer>
                <p>
                    <md>
                        <mrow> \frac{\text{Third term}}{\text{first term}}  =\amp \; \frac{(x+1)(x^2-2x+1)}{x+1} </mrow>
                        <mrow>\frac{ar^2}{a} \amp = \; \frac{(x+1)(x^2-2x+1)}{x+1} </mrow>
                        <mrow> r^2 \amp = \; x^2-2x+1 </mrow>
                        <mrow> r \amp = \; x-1 </mrow>
                        <mrow> \text{The second term} \; \amp = \; ar </mrow>
                        <mrow>2^{\text{nd}} \;\text{term}\; \amp = \; (x+1)(x-1) </mrow>
                        <mrow>2^{\text{nd}} \;\text{term}\; \amp = \; (x^2-1) </mrow>
                    </md>
                    
                </p>
                <p>
                    The second term of the geometric sequence is <m>x^2 - 1</m>.
                </p>
            </answer>
        </exercise>

        <exercise>
            <introduction>
                <p>
                    The diagram shows the first three stages of a Sierpinski triangle.
                    At each stage, the middle triangle of every filled triangle is removed,
                    leaving three smaller filled triangles in its place.
                </p>
                <figure xml:id="fig-geom-sierpinski-exercise">
                    <caption>Stages 1 to 3 of the Sierpinski triangle.</caption>
                    <image width="85%">
                        <latex-image>
                        \begin{tikzpicture}[scale=0.9]
                        % Stage 1: 1 filled triangle, side 2
                        \filldraw[fill=teal!55, draw=black] (0,0) -- (2,0) -- (1,1.732) -- cycle;
                        \node[below] at (1,-0.25) {\small Stage 1};

                        % Stage 2: 3 filled triangles of side 1
                        \filldraw[fill=teal!55, draw=black] (3,0) -- (4,0) -- (3.5,0.866) -- cycle;
                        \filldraw[fill=teal!55, draw=black] (4,0) -- (5,0) -- (4.5,0.866) -- cycle;
                        \filldraw[fill=teal!55, draw=black] (3.5,0.866) -- (4.5,0.866) -- (4,1.732) -- cycle;
                        \node[below] at (4,-0.25) {\small Stage 2};

                        % Stage 3: 9 filled triangles of side 0.5
                        \filldraw[fill=teal!55, draw=black] (6,0) -- (6.5,0) -- (6.25,0.433) -- cycle;
                        \filldraw[fill=teal!55, draw=black] (6.5,0) -- (7,0) -- (6.75,0.433) -- cycle;
                        \filldraw[fill=teal!55, draw=black] (6.25,0.433) -- (6.75,0.433) -- (6.5,0.866) -- cycle;
                        \filldraw[fill=teal!55, draw=black] (7,0) -- (7.5,0) -- (7.25,0.433) -- cycle;
                        \filldraw[fill=teal!55, draw=black] (7.5,0) -- (8,0) -- (7.75,0.433) -- cycle;
                        \filldraw[fill=teal!55, draw=black] (7.25,0.433) -- (7.75,0.433) -- (7.5,0.866) -- cycle;
                        \filldraw[fill=teal!55, draw=black] (6.5,0.866) -- (7,0.866) -- (6.75,1.299) -- cycle;
                        \filldraw[fill=teal!55, draw=black] (7,0.866) -- (7.5,0.866) -- (7.25,1.299) -- cycle;
                        \filldraw[fill=teal!55, draw=black] (6.75,1.299) -- (7.25,1.299) -- (7,1.732) -- cycle;
                        \node[below] at (7,-0.25) {\small Stage 3};
                        \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </introduction>
            <task>
                <statement>
                    <p>
                        Count the filled triangles at each stage and write down the first three terms of the sequence.
                        What is the common ratio <m>r</m>?
                    </p>
                </statement>
                <answer>
                    <p>
                        The sequence is <m>1, 3, 9, \ldots</m> with common ratio <m>r = 3</m>.
                    </p>
                </answer>
                <solution>
                    <p>
                        <md>
                            <mrow>\text{Stage 1} \amp =\; 1</mrow>
                            <mrow>\text{Stage 2} \amp =\; 3</mrow>
                            <mrow>\text{Stage 3} \amp =\; 9 = 3^2</mrow>
                        </md>
                        Each filled triangle becomes three smaller ones, so <m>r = 3</m>.
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        Write a formula for <m>T_n</m>, the number of filled triangles at Stage <m>n</m>.
                    </p>
                </statement>
                <answer>
                    <p>
                        <m>T_n = 3^{n-1}</m>
                    </p>
                </answer>
                <solution>
                    <p>
                        With first term <m>a = 1</m> and common ratio <m>r = 3</m>:
                        <md>
                            <mrow>T_n \amp =\; 3^{n-1}</mrow>
                        </md>
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        How many filled triangles are at Stage 5?
                        At which stage are there 729 filled triangles?
                    </p>
                </statement>
                <answer>
                    <p>
                        Stage 5 has <m>81</m> filled triangles. There are 729 filled triangles at Stage 7.
                    </p>
                </answer>
                <solution>
                    <p>
                        <md>
                            <mrow>T_5 \amp =\; 3^4 = 81</mrow>
                        </md>
                        For 729 triangles: <m>3^{n-1} = 729 = 3^6</m>, so <m>n - 1 = 6</m> and <m>n = 7</m>.
                    </p>
                </solution>
            </task>
        </exercise>

        <exercise>
            <introduction>
                <p>
                    A fractal tree grows by a simple rule: at each new stage, every tip branch
                    splits into two new branches. The teal branches show the current tip branches;
                    grey branches are from earlier stages.
                </p>
                <figure xml:id="fig-geom-tree-exercise">
                    <caption>Stages 1 to 4 of a fractal branching tree.</caption>
                    <image width="90%">
                        <latex-image>
                        \begin{tikzpicture}[scale=0.9]
                        % Stage 1: 1 tip branch
                        \draw[teal!70!black, line width=2pt] (0.8,0) -- (0.8,1.0);
                        \filldraw[teal!70!black] (0.8,1.0) circle (3pt);
                        \node[below] at (0.8,-0.2) {\small Stage 1};

                        % Stage 2: 2 tip branches
                        \draw[black!40, line width=1.5pt] (3.3,0) -- (3.3,0.8);
                        \draw[teal!70!black, line width=2pt] (3.3,0.8) -- (3.0,1.42);
                        \draw[teal!70!black, line width=2pt] (3.3,0.8) -- (3.6,1.42);
                        \filldraw[teal!70!black] (3.0,1.42) circle (2.5pt);
                        \filldraw[teal!70!black] (3.6,1.42) circle (2.5pt);
                        \node[below] at (3.3,-0.2) {\small Stage 2};

                        % Stage 3: 4 tip branches
                        \draw[black!40, line width=1.5pt] (6.3,0) -- (6.3,0.8);
                        \draw[black!40, line width=1.5pt] (6.3,0.8) -- (6.0,1.42);
                        \draw[black!40, line width=1.5pt] (6.3,0.8) -- (6.6,1.42);
                        \draw[teal!70!black, line width=2pt] (6.0,1.42) -- (5.78,2.0);
                        \draw[teal!70!black, line width=2pt] (6.0,1.42) -- (6.22,2.0);
                        \draw[teal!70!black, line width=2pt] (6.6,1.42) -- (6.38,2.0);
                        \draw[teal!70!black, line width=2pt] (6.6,1.42) -- (6.82,2.0);
                        \filldraw[teal!70!black] (5.78,2.0) circle (2pt);
                        \filldraw[teal!70!black] (6.22,2.0) circle (2pt);
                        \filldraw[teal!70!black] (6.38,2.0) circle (2pt);
                        \filldraw[teal!70!black] (6.82,2.0) circle (2pt);
                        \node[below] at (6.3,-0.2) {\small Stage 3};

                        % Stage 4: 8 tip branches
                        \draw[black!40, line width=1.5pt] (9.8,0) -- (9.8,0.8);
                        \draw[black!40, line width=1.5pt] (9.8,0.8) -- (9.5,1.42);
                        \draw[black!40, line width=1.5pt] (9.8,0.8) -- (10.1,1.42);
                        \draw[black!40, line width=1.5pt] (9.5,1.42) -- (9.28,2.0);
                        \draw[black!40, line width=1.5pt] (9.5,1.42) -- (9.72,2.0);
                        \draw[black!40, line width=1.5pt] (10.1,1.42) -- (9.88,2.0);
                        \draw[black!40, line width=1.5pt] (10.1,1.42) -- (10.32,2.0);
                        \draw[teal!70!black, line width=2pt] (9.28,2.0) -- (9.14,2.45);
                        \draw[teal!70!black, line width=2pt] (9.28,2.0) -- (9.42,2.45);
                        \draw[teal!70!black, line width=2pt] (9.72,2.0) -- (9.58,2.45);
                        \draw[teal!70!black, line width=2pt] (9.72,2.0) -- (9.86,2.45);
                        \draw[teal!70!black, line width=2pt] (9.88,2.0) -- (9.74,2.45);
                        \draw[teal!70!black, line width=2pt] (9.88,2.0) -- (10.02,2.45);
                        \draw[teal!70!black, line width=2pt] (10.32,2.0) -- (10.18,2.45);
                        \draw[teal!70!black, line width=2pt] (10.32,2.0) -- (10.46,2.45);
                        \filldraw[teal!70!black] (9.14,2.45) circle (1.8pt);
                        \filldraw[teal!70!black] (9.42,2.45) circle (1.8pt);
                        \filldraw[teal!70!black] (9.58,2.45) circle (1.8pt);
                        \filldraw[teal!70!black] (9.86,2.45) circle (1.8pt);
                        \filldraw[teal!70!black] (9.74,2.45) circle (1.8pt);
                        \filldraw[teal!70!black] (10.02,2.45) circle (1.8pt);
                        \filldraw[teal!70!black] (10.18,2.45) circle (1.8pt);
                        \filldraw[teal!70!black] (10.46,2.45) circle (1.8pt);
                        \node[below] at (9.8,-0.2) {\small Stage 4};
                        \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </introduction>
            <task>
                <statement>
                    <p>
                        Count the tip branches at each stage. Write down the sequence and state the common ratio.
                    </p>
                </statement>
                <answer>
                    <p>
                        The sequence is <m>1, 2, 4, 8, \ldots</m> with common ratio <m>r = 2</m>.
                    </p>
                </answer>
                <solution>
                    <p>
                        <md>
                            <mrow>\text{Stage 1} \amp =\; 1, \quad \text{Stage 2} = 2, \quad \text{Stage 3} = 4, \quad \text{Stage 4} = 8</mrow>
                        </md>
                        Each tip splits into two, so the count doubles and <m>r = 2</m>.
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        Write a formula for <m>T_n</m>, the number of tip branches at Stage <m>n</m>.
                    </p>
                </statement>
                <answer>
                    <p>
                        <m>T_n = 2^{n-1}</m>
                    </p>
                </answer>
                <solution>
                    <p>
                        With <m>a = 1</m> and <m>r = 2</m>:
                        <md>
                            <mrow>T_n = 2^{n-1}</mrow>
                        </md>
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        At which stage will there first be <m>32</m> tip branches?
                    </p>
                </statement>
                <answer>
                    <p>
                        Stage 6.
                    </p>
                </answer>
                <solution>
                    <p>
                        Solve <m>2^{n-1} = 32 = 2^5</m>, so <m>n - 1 = 5</m> and <m>n = 6</m>.
                    </p>
                </solution>
            </task>
        </exercise>

        <exercise>
            <introduction>
                <p>
                    A large square has a smaller square drawn inside it by joining the midpoints of its four sides.
                    A smaller square is then drawn inside that one the same way, and the process continues.
                    The diagram shows five nested squares produced by this construction.
                </p>
                <figure xml:id="fig-geom-nested-squares">
                    <caption>Five nested squares, each formed by joining the midpoints of the previous square's sides.</caption>
                    <image width="55%">
                        <latex-image>
                        \begin{tikzpicture}[scale=1.3]
                        % Square 1 (outermost)
                        \filldraw[fill=teal!15, draw=black, very thick] (0,0) -- (3,0) -- (3,3) -- (0,3) -- cycle;
                        % Square 2 (rotated 45 degrees, midpoints of sq1)
                        \filldraw[fill=teal!30, draw=black, thick] (1.5,0) -- (3,1.5) -- (1.5,3) -- (0,1.5) -- cycle;
                        % Square 3 (axis-aligned, midpoints of sq2)
                        \filldraw[fill=teal!45, draw=black, thick] (0.75,0.75) -- (2.25,0.75) -- (2.25,2.25) -- (0.75,2.25) -- cycle;
                        % Square 4 (rotated 45 degrees, midpoints of sq3)
                        \filldraw[fill=teal!60, draw=black, thick] (1.5,0.75) -- (2.25,1.5) -- (1.5,2.25) -- (0.75,1.5) -- cycle;
                        % Square 5 (axis-aligned, midpoints of sq4)
                        \filldraw[fill=teal!75, draw=black, thick] (1.125,1.125) -- (1.875,1.125) -- (1.875,1.875) -- (1.125,1.875) -- cycle;
                        % Labels in visible rings
                        \node at (0.28,2.72) {\small $A_1$};
                        \node at (2.62,0.28) {\small $A_2$};
                        \node at (2.1,2.1) {\small $A_3$};
                        \node at (1.9,1.2) {\small $A_4$};
                        \node at (1.5,1.5) {\small $A_5$};
                        \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
                <p>
                    The outermost square has area <m>A_1 = 64 \text{ cm}^2</m>.
                </p>
            </introduction>
            <task>
                <statement>
                    <p>
                        By what ratio does each successive square's area reduce?
                        Explain why this must be true using the geometry of the construction.
                    </p>
                </statement>
                <answer>
                    <p>
                        Each square has half the area of the one before, so <m>r = \dfrac{1}{2}</m>.
                    </p>
                </answer>
                <solution>
                    <p>
                        The inner square's four corners are the midpoints of the outer square's sides.
                        The inner square's diagonal equals the outer square's side length <m>s</m>,
                        so the inner square has diagonal <m>s</m> and therefore area
                        <md>
                            <mrow>\frac{s^2}{2} \amp =\; \frac{1}{2} \times (\text{area of outer square})</mrow>
                        </md>
                        The common ratio is <m>r = \dfrac{1}{2}</m>.
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        Write down the areas <m>A_1, A_2, A_3, A_4</m> as a sequence.
                    </p>
                </statement>
                <answer>
                    <p>
                        <m>64, \ 32, \ 16, \ 8 \ \text{cm}^2</m>
                    </p>
                </answer>
                <solution>
                    <p>
                        <md>
                            <mrow>A_1 \amp =\; 64 \text{ cm}^2</mrow>
                            <mrow>A_2 \amp =\; 64 \times \tfrac{1}{2} = 32 \text{ cm}^2</mrow>
                            <mrow>A_3 \amp =\; 32 \times \tfrac{1}{2} = 16 \text{ cm}^2</mrow>
                            <mrow>A_4 \amp =\; 16 \times \tfrac{1}{2} = 8 \text{ cm}^2</mrow>
                        </md>
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        Write a formula for <m>A_n</m>, the area of the <m>n</m>th square.
                    </p>
                </statement>
                <answer>
                    <p>
                        <m>A_n = 64 \times \left(\dfrac{1}{2}\right)^{n-1} \text{ cm}^2</m>
                    </p>
                </answer>
                <solution>
                    <p>
                        With first term <m>a = 64</m> and common ratio <m>r = \dfrac{1}{2}</m>:
                        <md>
                            <mrow>A_n \amp =\; 64 \times \left(\frac{1}{2}\right)^{n-1} \text{ cm}^2</mrow>
                        </md>
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        Which is the first square in the sequence with area less than <m>1 \text{ cm}^2</m>?
                    </p>
                </statement>
                <answer>
                    <p>
                        The 8th square, with area <m>\frac{1}{2} \text{ cm}^2</m>.
                    </p>
                </answer>
                <solution>
                    <p>
                        We need <m>64 \times \left(\frac{1}{2}\right)^{n-1} &lt; 1</m>, that is <m>\left(\frac{1}{2}\right)^{n-1} &lt; \frac{1}{64} = \left(\frac{1}{2}\right)^6</m>.
                        <md>
                            <mrow>n - 1 \amp &gt;\; 6</mrow>
                            <mrow>n \amp &gt;\; 7</mrow>
                        </md>
                        The smallest integer value is <m>n = 8</m>.
                        Check: <m>A_8 = 64 \times \left(\frac{1}{2}\right)^7 = \frac{64}{128} = \frac{1}{2} \text{ cm}^2 &lt; 1 \text{ cm}^2</m>. <m>\checkmark</m>
                    </p>
                </solution>
            </task>
        </exercise>
    </exercises>

