    <!-- Add STACK exercises if made -->

    <!-- Add static exercises -->

    <exercises>
        <exercise>
            <title>Find a Side Using the Sine Rule</title>
            <statement>
                <p>In triangle <m>ABC</m>, <m>A=28°</m>, <m>B=67°</m> and <m>a=11</m>. Find the length of <m>b</m>.</p>
            </statement>
            <answer>
                <p><m>b=11\frac{\sin67°}{\sin28°}\approx22.8</m>.</p>
            </answer>
        </exercise>
        <exercise>
            <title>Find an Angle</title>
            <statement>
                <p>In triangle <m>ABC</m>, <m>a=15</m>, <m>b=18</m> and <m>A=42°</m>. Find angle <m>B</m>.</p>
            </statement>
            <answer>
                <p><m>\sin B=\frac{18\sin42°}{15}\approx0.804</m>, so <m>B\approx53.4°</m>.</p>
            </answer>
        </exercise>
        <exercise>
            <title>Ambiguous Case</title>
            <statement>
                <p>In triangle <m>ABC</m>, <m>A=24°</m>, <m>a=6</m> and <m>b=9</m>. Find all possible values for angle <m>B</m>.</p>
            </statement>
            <answer>
                <p><m>\sin B=\frac{9\sin24°}{6}\approx0.616</m>, so <m>B\approx38.0°</m> or <m>B=142.0°</m>.</p>
            </answer>
        </exercise>
        <exercise>
            <title>Side in an Obtuse Triangle</title>
            <statement>
                <p>In triangle <m>ABC</m>, <m>A=108°</m>, <m>B=32°</m> and <m>a=13</m>. Calculate side <m>b</m>.</p>
            </statement>
            <answer>
                <p><m>C=40°</m> and <m>b=13\frac{\sin32°}{\sin108°}\approx7.3</m>.</p>
            </answer>
        </exercise>
        <exercise>
            <title>Determine Triangle Validity</title>
            <statement>
                <p>If <m>A=44°</m>, <m>a=8</m> and <m>b=17</m>, can a triangle be formed? If yes, find <m>B</m>.</p>
            </statement>
            <answer>
                <p><m>\sin B=\frac{17\sin44°}{8}\approx1.36</m>, which is impossible, so no triangle exists.</p>
            </answer>
        </exercise>
    </exercises>

