    <!-- Add Activity -->

    <activity>
        <title>Exploring sine and cosine graphs</title>
        <statement>
            <p>
                In pairs, sketch y = sin x and y = cos x for 0° ≤ x ≤ 360° (or 0 ≤ x ≤ 2π). Label intercepts, maxima, minima, amplitude, period and any phase shifts.
            </p>
        </statement>
        <teacher-notes>
            <p>Suggested time: 15 minutes. Ask learners to convert key points to radians and to compare the phase relationship between sine and cosine.</p>
        </teacher-notes>
    </activity>

