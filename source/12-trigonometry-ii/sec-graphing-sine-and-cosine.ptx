    <!-- If STACK questions are included, uncomment this: -->

    <!-- <xi:include href="../lesson-plan-templates/checkpoint.ptx" /> -->

    <!-- Add STACK exercises if made -->

    <!-- Add static exercises -->

   <exercises>
        <exercise>
            <title>Amplitude and period</title>
            <statement>
                <p>1. Sketch <m> y = 3 \cos x </m> for <m>0° ≤ x ≤ 360°</m>. State amplitude and period.</p>
            </statement>
            <answer>
                <p>Amplitude = 3; period = 360° (2π). Maxima at (0°,3) and (360°,3); minima at (180°,-3).</p>
            </answer>
        </exercise>

        <exercise>
            <title>Frequency change</title>
            <statement>
                <p>Sketch <m> y = \sin(2x) </m> for <m>0° ≤ x ≤ 360°</m>. What is the period in degrees and radians?</p>
            </statement>
            <answer>
                <p>Period = 360°/2 = 180° (π radians).</p>
            </answer>
        </exercise>

        <exercise>
            <title>Phase shift</title>
            <statement>
                <p> Given <m> y = 2 \sin(x + 30°) − 1 </m>, state amplitude, vertical shift, horizontal shift and sketch one period.</p>
            </statement>
            <answer>
                <p>Amplitude = 2; vertical shift = −1; horizontal shift = 30° left; period = 360° (2π). Key points shift accordingly.</p>
            </answer>
        </exercise>
        
        <exercise>
            <title>Vertical shift</title>
            <statement>
                <p>Sketch <m> y = \cos x − 2 </m> for <m>0° ≤ x ≤ 360°</m>. State amplitude and vertical shift.</p>
            </statement>
            <answer>
                <p>Amplitude = 1; vertical shift = −2. The cosine graph is moved down 2 units; maxima at (0°,-1), minima at (180°,-3).</p>
            </answer>
        </exercise>

        <exercise>
            <title>Frequency and amplitude change</title>
            <statement>
                <p>Sketch <m> y = 0.5 \sin(4x) </m> for <m>0° ≤ x ≤ 360°</m>. What is:</p>
                <p>
                    <ol>
                        <li>Period in degrees and radians</li>
                        <li>Amplitude</li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol>
                        <li>Period = <m>360°/4 = 90°</m> ( <m>π/2</m> radians)</li>
                        <li>Amplitude = 0.5</li>
                    </ol>
                </p>
            </answer>
        </exercise>

        <exercise>
            <title>Equation from transformations</title>
            <statement>
                <p>6. Find an equation for a sine function with amplitude <m>2</m>, period <m>180°</m>, shifted right by <m>45°</m> and moved down <m>1</m>.</p>
            </statement>
            <answer>
                <p>General form: <m>y = 2 \sin( (360°/180°) x − 45° ) − 1</m>. Since period = 180°, frequency factor = 2, and right shift 45° gives <m>y = 2 \sin(2(x − 45°)) − 1</m>.</p>
            </answer>
        </exercise>
    </exercises>
