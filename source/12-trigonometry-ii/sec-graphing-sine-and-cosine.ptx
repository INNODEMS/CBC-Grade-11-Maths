    <xi:include href="../lesson-plan-templates/example-intro.ptx" />

    <!-- Add at least 3 examples -->

    <example>
        <title>Basic sine graph</title>
        <statement>
            <p>Sketch <m> y = \sin x </m> for <m>0° ≤ x ≤ 360°</m>. Mark the key points and state amplitude and period.</p>
        </statement>
        <solution>
            <p>Key points: <m>(0°,0)</m>, <m>(90°,1)</m>, <m>(180°,0)</m>, <m>(270°,-1)</m>, <m>(360°,0)</m>. Amplitude = 1; period = 360° (2π).</p>
        </solution>
    </example>

    <example>
        <title>Vertical stretch</title>
        <statement>
            <p>Sketch <m> y = 2 \sin x </m> for <m>0° ≤ x ≤ 360°</m>. State amplitude and period and mark key points.</p>
        </statement>
        <solution>
            <p>Amplitude = 2. Key points: <m>(0°,0)</m>, <m>(90°,2)</m>, <m>(180°,0)</m>, <m>(270°,-2)</m>, <m>(360°,0)</m>. Period = 360° (2π).</p>
        </solution>
    </example>

    <example>
        <title>Phase shift</title>
        <statement>
            <p>Sketch <m> y = \sin(x - 90°) </m>. How does this relate to <m> y = \cos x </m>?</p>
        </statement>
        <solution>
            <p> <m> y = \sin(x - 90°) </m> = <m> -\cos(90° - x) </m> which corresponds to a horizontal shift; learners should observe the phase relation that shifts sine to align with cosine key points.</p>
        </solution>
    </example>

    <example>
        <title>Frequency change</title>
        <statement>
            <p>Sketch <m> y = \sin(2x) </m> for <m>0° ≤ x ≤ 360°</m>. How does the frequency compare with <m> y = \sin x </m>?</p>
        </statement>
        <solution>
            <p><m> y = \sin(2x) </m> completes two full cycles in <m>0°–360°</m>, so the period is 180° (π). The graph oscillates twice as quickly as <m> y = \sin x </m>.</p>
        </solution>
    </example>

    <example>
        <title>Reflection and vertical shift</title>
        <statement>
            <p>Sketch <m> y = -\cos x + 1 </m> for <m>0° ≤ x ≤ 360°</m>. State :
                </p>
                <p>
                    <ol>
                        <li>Amplitude</li>
                        <li>Period</li>
                        <li>Vertical shift</li>
                        <li>Reflections</li>
                    </ol>
                </p>
        </statement>
        <solution>
            <p>
                <ol>
                    <li>Amplitude = 1</li>
                    <li>Period = 360° (2π)</li>
                    <li>Vertical shift = +1</li>
                    <li>Reflection across x-axis (negative sign)</li>
                </ol>
            </p>

        </solution>
    </example>
     
