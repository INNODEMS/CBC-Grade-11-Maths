    <!-- Add static exercises -->

    
       <exercises>
    <exercise>
        <title> Finding Distance Between Two Ships</title>
        <statement>
            <p>
                Two ships leave a port at the same time. Ship A travels <m>15\text{ km}</m> in one direction while Ship B travels <m>20\text{ km}</m> in a direction that makes an angle of <m>42^\circ</m> with Ship A's path. How far apart are the two ships?
            </p>
        </statement>
        <answer>
            <p>
                Using the Cosine Rule with <m>a=15</m>, <m>b=20</m>, and <m>C=42^\circ</m>:
            </p>
            <md>
                <mrow>c\approx13.42\text{ km}</mrow>
            </md>
        </answer>
    </exercise>

    <exercise>
        <title>Calculating a Roof Beam Length</title>
        <statement>
            <p>
                A roof is being built with two support beams meeting at a point. One beam extends <m>8\text{ m}</m> horizontally and the other extends <m>6\text{ m}</m> at an angle of <m>65^\circ</m> to the first beam. A connecting beam is needed to join the endpoints of these two support beams. What is the length of the connecting beam?
            </p>
        </statement>
        <answer>
            <md>
                <mrow>c\approx7.72\text{ m}</mrow>
            </md>
        </answer>
    </exercise>

    <exercise>
        <title> Finding Land Boundaries</title>
        <statement>
            <p>
                A surveyor measures distances from a fixed point to two corners of a triangular plot of land. The distances are <m>120\text{ m}</m> and <m>85\text{ m}</m>, and the angle between these measurements is <m>58^\circ</m>. What is the straight-line distance between the two corners?
            </p>
        </statement>
        <answer>
            <md>
                <mrow>c\approx104.0\text{ m}</mrow>
            </md>
        </answer>
    </exercise>

    <exercise>
        <title> Finding the Angle of Flight Paths</title>
        <statement>
            <p>
                An airplane flies from Airport A to Airport B, covering a distance of <m>450\text{ km}</m>. From Airport A, Airport C is <m>380\text{ km}</m> away, and from Airport B, Airport C is <m>520\text{ km}</m> away. Find the angle at Airport B in the triangle formed by the three airports.
            </p>
        </statement>
        <answer>
            <md>
                <mrow>B=\cos^{-1}(0.7016)\approx45.5^\circ</mrow>
            </md>
        </answer>
    </exercise>

    <exercise>
        <title> Finding the Distance in a Race Course</title>
        <statement>
            <p>
                A triangular race course has two sides measuring <m>2.5\text{ km}</m> and <m>3.2\text{ km}</m>, with an included angle of <m>72^\circ</m> at the starting point. Athletes must run a direct path from the end of the second side back to the starting point. How far must they run on this final leg?
            </p>
        </statement>
        <answer>
            <md>
                <mrow>c\approx3.37\text{ km}</mrow>
            </md>
        </answer>
    </exercise>
</exercises>
    

