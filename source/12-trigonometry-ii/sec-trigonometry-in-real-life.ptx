<section xml:id="sec-trigonometry-in-real-life" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Trigonometry in Real Life</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        2.0 Measurement and Geometry
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>
                        2.5 Trigonometry II
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title> 
                    <p>
                        Appreciate the use of trigonometry in real life situations
                    </p>
                </li>
