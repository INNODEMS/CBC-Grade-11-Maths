    <!-- Add insight / key takeaway directly related to activity / learner experience -->

    <insight>
        <p>
            The <term>Cosine Rule</term> relates the lengths of the sides of any triangle to the cosine of one of its angles.
        </p>

        <p>
            For a triangle <m>\triangle ABC</m>:
        </p>
           <p>
              <md>
                  c^2=a^2+b^2-2ab\cos C
              </md>
        </p>
        <p>
            Similarly,
        </p>
        <p>
            <md>
            <mrow>a^2=b^2+c^2-2bc\cos A</mrow>
            <mrow>b^2=a^2+c^2-2ac\cos B</mrow>
        </md>
        </p>
        <p>
            The Cosine Rule is particularly useful when:
            <ul>
                <li><p>Two sides and the included angle are known (SAS).</p></li>
                <li><p>All three sides are known and an angle is required (SSS).</p></li>
            </ul>
        </p>

    </insight>

    <!-- Add further instruction (not in a block) to develop ideas as needed -->

    <xi:include href="../lesson-plan-templates/example-intro.ptx" />

    <!-- Add at least 3 examples -->

    <example>
        <title>Finding an Unknown Side</title>

        <statement>
            <p>
                In <m>\triangle ABC</m>,<m>a=8\text{ cm}</m>,<m>b=10\text{ cm}</m>,and
                <m>C=60^\circ</m>.Find the length of side <m>c</m>.
            </p>
        </statement>
        <solution>
            <p>
                <p>
                Apply the Cosine Rule:
            </p>

            <md>
                <mrow>c^2=8^2+10^2-2(8)(10)\cos60^\circ</mrow>
                <mrow>c^2=64+100-160(0.5)</mrow>
                <mrow>c^2=84</mrow>
                <mrow>c=\sqrt{84}</mrow>
            </md>

            <p>
                Therefore,
            </p>

            <md>
                c\approx9.17\text{ cm}
            </md>

            </p>
        </solution> 
    </example>

    <example>
        <title>Finding an Unknown Angle</title>

        <statement>
              <p>
                  In a triangle,<m>a=7\text{ cm}</m>,<m>b=9\text{ cm}</m>, and<m>c=11\text{ cm}</m>.
                 Find angle <m>C</m>.
              </p>
        </statement>
        <solution>
            <p>
                Rearrange the Cosine Rule:
            </p>

            <me>
                \cos C=\frac{a^2+b^2-c^2}{2ab}
            </me>

            <p>
                Substitute the values:
            </p>
           <p>
             <md>
                <mrow>\cos C=\frac{7^2+9^2-11^2}{2(7)(9)}</mrow>
                <mrow>\cos C=\frac{49+81-121}{126}</mrow>
                <mrow>\cos C=\frac{9}{126}</mrow>
                <mrow>\cos C\approx0.0714</mrow>
            </md>
           </p>
            <p>
                Therefore,
            </p>
            <p>
              <md>
                  C=\cos^{-1}(0.0714)\approx85.9^\circ
               </md>
            </p>  
        </solution>
    </example>

    <example>
        <title>Finding the Diagonal of a Field</title>

        <statement>
            <p>
                Two sides of a triangular field measure<m>120\text{ m}</m> and<m>150\text{ m}</m>.
                The included angle is<m>70^\circ</m>.Find the length of the third side.
            </p>
        </statement>
         <solution>
            <p>
                Using the Cosine Rule:
            </p>
            <p>
                  <md>
                     <mrow>c^2=120^2+150^2-2(120)(150)\cos70^\circ</mrow>
                       <mrow>c^2\approx24611.6</mrow>
                     <mrow>c\approx156.9</mrow>
                 </md>
            </p>
            <p>
                Therefore, the third side is approximately
                <m>157\text{ m}</m>.
            </p>
        </solution>
    </example>

