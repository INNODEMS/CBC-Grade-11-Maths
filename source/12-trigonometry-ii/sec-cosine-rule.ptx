    <!-- Add Activity -->

    <!-- Need to create activities -->

    <activity>
        <title>Investigating the Cosine Rule</title>

        <statement>
            <p>
                Work in groups.
            </p>

            <ol marker="(a)">
                <li>
                    <p>
                        Draw an acute triangle and label its sides <m>a</m>, <m>b</m>, and <m>c</m>.
                    </p>
                </li>
                <li>
                    <p>
                        Measure the lengths of the three sides and one angle, say <m>C</m>.
                    </p>
                </li>

                <li>
                    <p>
                        Calculate:
                        <md>
                            a^2+b^2-2ab\cos C
                        </md>
                    </p>
                </li>
                 <li>
                    <p>
                        Compare your answer with <m>c^2</m>. What do you notice?
                    </p>
                </li>
            </ol>
    </activity> 

