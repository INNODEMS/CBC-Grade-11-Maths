    <!-- If STACK questions are included, uncomment this: -->

    <!-- <xi:include href="../lesson-plan-templates/checkpoint.ptx" /> -->

    <exercises>
        <exercise>
            <title>Graphing Tangent</title>
            <statement>
                <p>Sketch the graph of <m>y=\tan x</m> for <m>0°&lt; x &lt;360°</m>. Mark all vertical asymptotes and one full period.</p>
            </statement>
            <answer>
                <p>Asymptotes at <m>90°</m> and <m>270°</m>; period is 180° (one period appears between each pair of asymptotes).</p>
                <figure>
                    <caption>Sketch of <m>y=\tan x</m> for <m>0°&lt; x &lt;360°</m> with vertical asymptotes at <m>90°</m> and <m>270°</m>.</caption>
                    <image width="70%">
                        <latex-image>
                            \pgfplotsset{compat=newest}
                            \begin{tikzpicture}
                            \begin{axis}[
                                axis lines=middle,
                                xlabel={$x$},
                                ylabel={$y$},
                                xmin=0, xmax=360,
                                ymin=-8, ymax=8,
                                xtick={0,90,180,270,360},
                                xticklabels={$0^\circ$,$90^\circ$,$180^\circ$,$270^\circ$,$360^\circ$},
                                ytick={-6,-4,-2,0,2,4,6},
                                domain=0:360,
                                samples=400,
                                width=8cm, height=5cm
                            ]
                            \addplot[blue, thick] ({x},{tan(x)});
                            \addplot[dashed, red] coordinates {(90,-8) (90,8)};
                            \addplot[dashed, red] coordinates {(270,-8) (270,8)};
                            \end{axis}
                            \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </answer>
        </exercise>
        <exercise>
            <title>Evaluate Using Reference Angles</title>
            <statement>
                <p>Evaluate (exact where possible): <m>\tan30°</m>, <m>\tan150°</m>, <m>\tan330°</m>, <m>\tan270°</m>.</p>
            </statement>
            <answer>
                <p><m>\tan30°=\dfrac{1}{\sqrt{3}},\; \tan150°=-\dfrac{1}{\sqrt{3}},\; \tan330°=-\dfrac{1}{\sqrt{3}},\; \tan270°\text{ is undefined.}</m></p>
            </answer>
        </exercise>
        <exercise>
            <title>Solving Tangent Equations</title>
            <statement>
                <p>Find all solutions to <m>\tan x=-1</m> for <m>0°\le x &lt;360°</m>.</p>
            </statement>
            <answer>
                <p>Reference angle <m>45°</m>; tangent negative in Q2 and Q4: <m>x=135°</m> and <m>x=315°</m>.</p>
            </answer>
        </exercise>
        <exercise>
            <title>Transformations: Vertical Stretch</title>
            <statement>
                <p>Sketch one period of <m>y=-\tan x + 1</m>. State the midline and the vertical asymptotes.</p>
            </statement>
            <answer>
                <p>Midline is <m>y=1</m>. Vertical asymptotes unchanged at <m>\tfrac{\pi}{2}+k\pi</m>; the graph is reflected and translated up by 1.</p>
                <figure>
                    <caption>Graph of <m>y=-\tan x + 1</m> for one period, showing the midline at <m>y=1</m> and vertical asymptotes at <m>x=\pm\tfrac{\pi}{2}</m>.</caption>
                    <image width="70%">
                        <latex-image>
                            \pgfplotsset{compat=newest}
                            \begin{tikzpicture}
                            \begin{axis}[
                                axis lines=middle,
                                xlabel={$x$},
                                ylabel={$y$},
                                xmin=-1.7, xmax=1.7,
                                ymin=-6.5, ymax=6.5,
                                xtick={-1.5708,0,1.5708},
                                xticklabels={$-\tfrac{\pi}{2}$,$0$,$\tfrac{\pi}{2}$},
                                ytick={-5,-3,-1,1,3,5},
                                domain=-1.55:1.55,
                                samples=200,
                                width=8cm, height=5cm
                            ]
                            \addplot[blue, thick] ({x},{-tan(deg(x)) + 1});
                            \addplot[dashed, red] coordinates {(-1.5708,-6.5) (-1.5708,6.5)};
                            \addplot[dashed, red] coordinates {(1.5708,-6.5) (1.5708,6.5)};
                            \addplot[dashed, gray] coordinates {(-1.7,1) (1.7,1)};
                            \end{axis}
                            \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </answer>
        </exercise>
        <exercise>
            <title>Solve Tangent Equations</title>
            <statement>
                <p>Solve <m>\tan\theta=\sqrt{3}</m> for <m>0\le \theta &lt;360°</m>.</p>
            </statement>
            <answer>
                <p>Solutions: <m>\theta=60°</m> and <m>\theta=240°</m>.</p>
            </answer>
        </exercise>
    </exercises>

