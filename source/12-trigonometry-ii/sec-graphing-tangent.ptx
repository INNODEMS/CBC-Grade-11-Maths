    <!-- Add Activity -->

    <activity>
        <title>Tangent Graph Investigation</title>
        <statement>
            <p>
                In small groups, investigate the graph of <m>y=\tan x</m> for angles in degrees and radians. Use a graphing tool or sketch by hand.
                <ol marker="(a)">
                    <li>
                        <p>Plot the graph for one period of tangent, identifying the intercepts and vertical asymptotes.</p>
                    </li>
                    <li>
                        <p>Record the period and explain why the period of tangent is <m>\pi</m> (or <m>180°</m>), not <m>2\pi</m>.</p>
                    </li>
                    <li>
                        <p>Describe how the function behaves as it approaches a vertical asymptote from the left and from the right.</p>
                    </li>
                    <li>
                        <p>Compare the graphs of <m>y=\tan x</m> and <m>y=\sin x</m>, noting symmetry and where each is defined.</p>
                    </li>
                </ol>
            </p>
        </statement>
        <notes component="lesson-plan">
            <p>
                Encourage learners to mark asymptotes at <m>\tfrac{\pi}{2} + k\pi</m> (or <m>90° + k\cdot180°</m>) and to sketch one period centred on the origin. Provide a digital graph for comparison where available.
            </p>
        </notes>
    </activity>

