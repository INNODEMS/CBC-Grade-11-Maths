<?xml version="1.0" encoding="utf-8"?>

<section xml:id="sec-trigonometry-and-the-unit-circle" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Trigonometry and the Unit Circle</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        2.0 Measurement and Geometry
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>
                        2.5 Trigonometry II
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title>
                    <p>
                        Determine trigonometric ratios of angles using a unit circle
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        11
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>
                        40 minutes
                    </p>
                </li>
            </dl>
            </p>
        </introduction>
    </objectives>

    <axiom component="lesson-plan">
        <title>Problem-Solving and Discovery</title>
        <p>
            <dl>
            <li>
                <title>Suggested Time</title>
                <p>
                    12 minutes
                </p>
            </li>
            <li>
                <title>Objective</title>
                <p>
                    To discover, through coordinate geometry, the equation of a circle centred at the origin and use it to motivate the unit circle.
                </p>
            </li>
            </dl>
        </p>
        <ul>
            <li>
                <p>
                    Avoid revealing the equation <m>x^2 + y^2 = r^2</m> too early<mdash/>let Learners conjecture it from the specific case <m>r = 5</m>.
                </p>
            </li>
        </ul>
    </axiom>

