    <!-- Add STACK exercises if made -->

    <!-- Add static exercises -->
<exercises>
        <exercise>
            <statement><p>Simplify <m>12\sqrt{7} - 9\sqrt{7}</m>.</p></statement>
            <solution>
                <p>
                    Since both terms contain the same radicand <m>7</m>, they are like surds. Subtract the coefficients directly:
                    <md>
                        <mrow>12\sqrt{7} - 9\sqrt{7} \amp = (12 - 9)\sqrt{7}</mrow>
                        <mrow>\amp = 3\sqrt{7}</mrow>
                    </md>
                </p>
            </solution>
        </exercise>
        <exercise>
            <statement><p>Find the simplest form of <m>\sqrt{8} + \sqrt{32}</m>.</p></statement>
            <solution>
                <p>
                    Simplify each radical by identifying the highest perfect square factors:
                    <md>
                        <mrow>\sqrt{8} \amp = \sqrt{4 \times 2} = \sqrt{4} \times \sqrt{2} = 2\sqrt{2}</mrow>
                        <mrow>\sqrt{32} \amp = \sqrt{16 \times 2} = \sqrt{16} \times \sqrt{2} = 4\sqrt{2}</mrow>
                    </md>
                    Now combine the simplified like terms:
                    <md>
                        <mrow>\sqrt{8} + \sqrt{32} \amp = 2\sqrt{2} + 4\sqrt{2}</mrow>
                        <mrow>\amp = (2 + 4)\sqrt{2}</mrow>
                        <mrow>\amp = 6\sqrt{2}</mrow>
                    </md>
                </p>
            </solution>
        </exercise>
        <exercise>
            <statement><p>Express <m>5\sqrt{3} + 2\sqrt{12} - \sqrt{27}</m> in simplest form.</p></statement>
            <solution>
                <p>
                    Analyze each radical term step by step. The first term, <m>5\sqrt{3}</m>, is already in its simplest form.
                </p>
                <p>
                    Simplify the second term, <m>2\sqrt{12}</m>:
                    <md>
                        <mrow>2\sqrt{12} \amp = 2\sqrt{4 \times 3}</mrow>
                        <mrow>\amp = 2 \times 2 \times \sqrt{3}</mrow>
                        <mrow>\amp = 4\sqrt{3}</mrow>
                    </md>
                </p>
                <p>
                    Simplify the third term, <m>\sqrt{27}</m>:
                    <md>
                        <mrow>\sqrt{27} \amp = \sqrt{9 \times 3}</mrow>
                        <mrow>\amp = 3\sqrt{3}</mrow>
                    </md>
                </p>
                <p>
                    Combine all values together using operations on their coefficients:
                    <md>
                        <mrow>5\sqrt{3} + 2\sqrt{12} - \sqrt{27} \amp = 5\sqrt{3} + 4\sqrt{3} - 3\sqrt{3}</mrow>
                        <mrow>\amp = (5 + 4 - 3)\sqrt{3}</mrow>
                        <mrow>\amp = 6\sqrt{3}</mrow>
                    </md>
                </p>
            </solution>
        </exercise>
        <exercise>
            <statement><p>A triangle has sides of <m>\sqrt{24}</m> units, <m>\sqrt{54}</m> units, and <m>\sqrt{6}</m> units. Calculate its perimeter.</p></statement>
            <solution>
                <p>
                    The perimeter is the sum of all three side lengths: <m>P = \sqrt{24} + \sqrt{54} + \sqrt{6}</m>.
                </p>
                <p>
                    Simplify <m>\sqrt{24}</m> and <m>\sqrt{54}</m> to see if they can be written with a radicand of <m>6</m>:
                    <md>
                        <mrow>\sqrt{24} \amp = \sqrt{4 \times 6} = 2\sqrt{6}</mrow>
                        <mrow>\sqrt{54} \amp = \sqrt{9 \times 6} = 3\sqrt{6}</mrow>
                    </md>
                </p>
                <p>
                    Sum the simplified values together (treating the lone <m>\sqrt{6}</m> as having an implicit coefficient of <m>1</m>):
                    <md>
                        <mrow>P \amp = 2\sqrt{6} + 3\sqrt{6} + 1\sqrt{6}</mrow>
                        <mrow>\amp = (2 + 3 + 1)\sqrt{6}</mrow>
                        <mrow>\amp = 6\sqrt{6}\text{ units}</mrow>
                    </md>
                </p>
            </solution>
        </exercise>
        <exercise>
            <statement><p>Verify that <m>\sqrt{45} - \sqrt{20}</m> is equal to <m>\sqrt{5}</m>.</p></statement>
            <solution>
                <p>
                    To verify this claim, simplify both components on the left hand side of the expression:
                    <md>
                        <mrow>\sqrt{45} \amp = \sqrt{9 \times 5} = 3\sqrt{5}</mrow>
                        <mrow>\sqrt{20} \amp = \sqrt{4 \times 5} = 2\sqrt{5}</mrow>
                    </md>
                    Subtract the simplified expressions:
                    <md>
                        <mrow>\sqrt{45} - \sqrt{20} \amp = 3\sqrt{5} - 2\sqrt{5}</mrow>
                        <mrow>\amp = (3 - 2)\sqrt{5}</mrow>
                        <mrow>\amp = 1\sqrt{5}</mrow>
                        <mrow>\amp = \sqrt{5}</mrow>
                    </md>
                    The left hand side simplifies exactly to <m>\sqrt{5}</m>, which matches the target value.
                </p>
            </solution>
        </exercise>
    </exercises>
