    <!-- Add static exercises -->

   <exercises>
      <exercise>
        <statement><p>Simplify <m>\sqrt{5} \times \sqrt{20}</m>.</p></statement>
        <solution>
            <p>
                Combine the terms under a single radical using the product rule:
                <md>
                    <mrow>\sqrt{5} \times \sqrt{20} \amp = \sqrt{5 \times 20}</mrow>
                    <mrow>\amp = \sqrt{100}</mrow>
                    <mrow>\amp = 10</mrow>
                </md>
            </p>
        </solution>
      </exercise>
      <exercise>
        <statement><p>Simplify <m>\frac{\sqrt{48}}{\sqrt{6}}</m>.</p></statement>
        <solution>
            <p>
                Combine the terms into a single quotient radical expression using the division rule:
                <md>
                    <mrow>\frac{\sqrt{48}}{\sqrt{6}} \amp = \sqrt{\frac{48}{6}}</mrow>
                    <mrow>\amp = \sqrt{8}</mrow>
                </md>
                Now simplify the remaining surd <m>\sqrt{8}</m> by factoring out its largest perfect square component:
                <md>
                    <mrow>\sqrt{8} \amp = \sqrt{4 \times 2}</mrow>
                    <mrow>\amp = \sqrt{4} \times \sqrt{2}</mrow>
                    <mrow>\amp = 2\sqrt{2}</mrow>
                </md>
            </p>
        </solution>
      </exercise>
      <exercise>
        <statement><p>Expand and simplify: <m>\sqrt{3}(\sqrt{3} - \sqrt{2})</m>.</p></statement>
        <solution>
            <p>
                Distribute the <m>\sqrt{3}</m> across the terms within the parentheses and apply the multiplication laws:
                <md>
                    <mrow>\sqrt{3}(\sqrt{3} - \sqrt{2}) \amp = (\sqrt{3} \times \sqrt{3}) - (\sqrt{3} \times \sqrt{2})</mrow>
                    <mrow>\amp = \sqrt{3 \times 3} - \sqrt{3 \times 2}</mrow>
                    <mrow>\amp = \sqrt{9} - \sqrt{6}</mrow>
                    <mrow>\amp = 3 - \sqrt{6}</mrow>
                </md>
                Since 6 has no perfect square factors, this cannot be simplified any further.
            </p>
        </solution>
      </exercise>
      <exercise>
        <statement><p>What is the value of <m>(2\sqrt{7})^2</m>?</p></statement>
        <solution>
            <p>
                Apply the exponent to both the integer coefficient and the radical term separately:
                <md>
                    <mrow>(2\sqrt{7})^2 \amp = 2^2 \times (\sqrt{7})^2</mrow>
                    <mrow>\amp = 4 \times (\sqrt{7} \times \sqrt{7})</mrow>
                    <mrow>\amp = 4 \times \sqrt{49}</mrow>
                    <mrow>\amp = 4 \times 7</mrow>
                    <mrow>\amp = 28</mrow>
                </md>
            </p>
        </solution>
      </exercise>
      <exercise>
        <statement><p>Divide <m>10\sqrt{24}</m> by <m>2\sqrt{3}</m>.</p></statement>
        <solution>
            <p>
                Set up the division as a fraction, dividing whole numbers by whole numbers and radicals by radicals:
                <md>
                    <mrow>\frac{10\sqrt{24}}{2\sqrt{3}} \amp = \left(\frac{10}{2}\right) \times \sqrt{\frac{24}{3}}</mrow>
                    <mrow>\amp = 5 \times \sqrt{8}</mrow>
                    <mrow>\amp = 5\sqrt{8}</mrow>
                </md>
                Next, simplify the radical component <m>\sqrt{8}</m> by extracting the perfect square factor 4:
                <md>
                    <mrow>5\sqrt{8} \amp = 5\sqrt{4 \times 2}</mrow>
                    <mrow>\amp = 5 \times \sqrt{4} \times \sqrt{2}</mrow>
                    <mrow>\amp = 5 \times 2 \times \sqrt{2}</mrow>
                    <mrow>\amp = 10\sqrt{2}</mrow>
                </md>
            </p>
        </solution>
      </exercise>
      <exercise>
        <statement>
          <p>
            A rectangular carpet has an area of <m>\sqrt{108}</m> square meters. If the width of the carpet is <m>\sqrt{3}</m> meters, find the length of the carpet in its simplest form.
          </p>
        </statement>
        <solution>
          <p>
            Calculate the length by setting up a division of the area by the given width: 
            <md>\text{Length} = \frac{\text{Area}}{\text{Width}} = \frac{\sqrt{108}}{\sqrt{3}}</md>
            Apply the division rule to evaluate the expression inside a single square root sign:
            <md>
                <mrow>\text{Length} \amp = \sqrt{\frac{108}{3}}</mrow>
                <mrow>\amp = \sqrt{36}</mrow>
                <mrow>\amp = 6\text{ meters}</mrow>
            </md>
          </p>
        </solution>
      </exercise>

      <exercise>
        <statement>
          <p>
            In a physics experiment, a learner finds that the velocity of a particle is given by <m>v = \sqrt{5} \times \sqrt{15}</m> meters per second. Simplify this velocity and express it as a single surd in its simplest form.
          </p>
        </statement>
        <solution>
          <p>
            Multiply the radical parameters together using the product rule:
            <md>
                <mrow>v \amp = \sqrt{5 \times 15}</mrow>
                <mrow>\amp = \sqrt{75}</mrow>
            </md>
            Simplify <m>\sqrt{75}</m> by finding the largest square factor component, which is 25:
            <md>
                <mrow>v \amp = \sqrt{25 \times 3}</mrow>
                <mrow>\amp = \sqrt{25} \times \sqrt{3}</mrow>
                <mrow>\amp = 5\sqrt{3}\text{ m/s}</mrow>
            </md>
          </p>
        </solution>
      </exercise>

      <exercise>
        <statement>
          <p>
            To promote sustainable food systems, biology students layout a rectangular organic vegetable cooperative plot with a total area of <m>\sqrt{150}</m> square meters. If the width of their garden plot measures exactly <m>\sqrt{6}</m> meters, find its length in simplest radical terms.
          </p>
        </statement>
        <solution>
          <p>
            Set up the operational equation to solve for length by dividing the area by the width parameter:
            <md>\text{Length} = \frac{\sqrt{150}}{\sqrt{6}}</md>
            Apply the quotient law for surds to simplify the expression under a single radical sign:
            <md>
                <mrow>\text{Length} \amp = \sqrt{\frac{150}{6}}</mrow>
                <mrow>\amp = \sqrt{25}</mrow>
                <mrow>\amp = 5\text{ meters}</mrow>
            </md>
          </p>
        </solution>
      </exercise>

      <exercise>
        <statement>
          <p>
            An environmental researcher uses a conservation drone to chart animal migration tracks over a thick forest canopy. The square study area cleared by the drone signal tracking beam has a side length of <m>3\sqrt{6}</m> kilometers. Find the area of this square research corridor.
          </p>
        </statement>
        <solution>
          <p>
            The area of a square is calculated by squaring its side length: <m>\text{Area} = \text{side}^2</m>.
            <md>\text{Area} = (3\sqrt{6})^2</md>
            Distribute the power across both parts of the expression and evaluate step by step:
            <md>
                <mrow>\text{Area} \amp = 3^2 \times (\sqrt{6})^2</mrow>
                <mrow>\amp = 9 \times (\sqrt{6} \times \sqrt{6})</mrow>
                <mrow>\amp = 9 \times \sqrt{36}</mrow>
                <mrow>\amp = 9 \times 6</mrow>
                <mrow>\amp = 54\text{ square kilometers}</mrow>
            </md>
          </p>
        </solution>
      </exercise>
    </exercises>


