<!-- This text is added at near the end of plans to show the types of assessment -->
<axiom component="lesson-plan">
    <title>Assessment</title>
    <title>Assessment methods</title>
    <dl>
        <li>
            <title>Formative (During Lesson)</title>
            <p>
                <ol>
                    <li><alert>Observation:</alert> Teacher circulates during the anchor task, listening to group discussions.</li>
                    <li><alert>Questioning:</alert> Teacher asks probing questions to check for understanding.</li>
                    <li><alert>Exit Ticket:</alert> A short, independent task at the end of the lesson.</li>
                </ol>
            </p>
            <p>
                To monitor learner progress in real-time, provide immediate feedback, and adjust instruction as needed.
            </p>
        </li>
        <li>
            <title>Summative (After Lesson)</title>
            <p>
                <ol>
                    <li>Homework assignment with more complex problems.</li>
                    <li>Future quiz/test questions.</li>
                </ol>
            </p>
            <p>
                To evaluate mastery of the learning objectives after instruction and practice.
            </p>
        </li>
    </dl>
</axiom>