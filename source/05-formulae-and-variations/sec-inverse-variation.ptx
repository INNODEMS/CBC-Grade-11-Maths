    <!-- Add STACK exercises if made -->

    <exercises>
        <exercise>
            <statement>
                <p>It is known that <m>y \propto \frac{1}{x}</m>. If <m>y = 20</m> when <m>x = 3</m>, find <m>y</m> when <m>x = \frac{1}{2}</m>.</p>
                <figure xml:id="fig-inverse-exercise-graph">
                    <caption>Graph of the inverse variation for the exercise showing the relationship between <m>y</m> and <m>x</m>.</caption>
                    <image width="100%">
                        <latex-image>
                            \begin{tikzpicture}
                            \begin{axis}[
                                grid=both,
                                minor grid style={draw=gray!15, line width=0.2pt},
                                major grid style={draw=gray!40, line width=0.4pt},
                                minor tick num=1,
                                xtick distance=1,
                                ytick distance=10,
                                axis lines=left,
                                ylabel={y},
                                xlabel={x},
                                xmin=0, xmax=10, ymin=0, ymax=70,
                                width=6.5cm, height=7cm,
                                tick label style={font=\small},
                                label style={font=\small}
                            ]
                            \addplot[red, samples=100, domain=0.5:10] {60/x};
                            \addplot[only marks, mark=*, blue, mark size=2pt] coordinates {(1,60) (2,30) (3,20) (4,15) (5,12) (6,10) (10,6)};
                            \end{axis}
                            \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </statement>
            <answer>
                <p><strong>Answer: <m>y = 120</m></strong></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>Given that <m>p \propto \frac{1}{q}</m> and that when <m>p = 8, q = 25</m>, find:</p>
                <p>(a) the equation connecting <m>p</m> and <m>q</m>.</p>
                <p>(b) <m>p</m> when <m>q = 10</m>.</p>
            </statement>
            <answer>
                <p>(a) <strong>Answer: Equation: <m>p = \frac{200}{q}</m></strong></p>
                <p>(b) <strong>Answer: <m>p = 20</m></strong></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>A quantity <m>y</m> varies inversely as a quantity <m>x</m>. Copy and complete the table:</p>
                <tabular halign="center">
                    <row header="yes">
                        <cell><m>x</m></cell>
                        <cell>2</cell>
                        <cell>4</cell>
                        <cell>8</cell>
                        <cell>16</cell>
                    </row>
                    <row>
                        <cell><m>y</m></cell>
                        <cell>16</cell>
                        <cell>—</cell>
                        <cell>—</cell>
                        <cell>2</cell>
                    </row>
                </tabular>
                <p>(a) Find the constant of proportionality.</p>
                <p>(b) Describe the shape of the graph if <m>y</m> is plotted against <m>x</m>.</p>
            </statement>
            <answer>
                <p>(a) <strong>Answer: <m>k = 32</m></strong></p>
                <p>(b) <strong>Answer: A rectangular hyperbola</strong></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>The data below follows the relationship <m>y = \frac{k}{x}</m>.</p>
                <tabular halign="center">
                    <row header="yes">
                        <cell><m>x</m></cell>
                        <cell>1</cell>
                        <cell>2</cell>
                        <cell>5</cell>
                        <cell>10</cell>
                    </row>
                    <row>
                        <cell><m>1/x</m></cell>
                        <cell>1.0</cell>
                        <cell>0.5</cell>
                        <cell>0.2</cell>
                        <cell>0.1</cell>
                    </row>
                    <row>
                        <cell><m>y</m></cell>
                        <cell>50</cell>
                        <cell>25</cell>
                        <cell>10</cell>
                        <cell>5</cell>
                    </row>
                </tabular>
                <p>If you were to draw a graph of <m>y</m> against <m>\frac{1}{x}</m>, what would be the gradient (slope) of the resulting line?</p>
            </statement>
            <answer>
                <p><strong>Answer: The gradient is 50.</strong></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>The pressure (<m>P</m>) of a gas varies inversely as the volume (<m>V</m>). When <m>V = 10, P = 2</m>.</p>
                <p>(a) Find the equation relating <m>P</m> and <m>V</m>.</p>
                <p>(b) If the volume is doubled, what happens to the pressure? Show this using the graph.</p>
            </statement>
            <answer>
                <p>(a) <strong>Answer: Equation: <m>P = \frac{20}{V}</m></strong></p>
                <p>(b) <strong>Answer: The pressure is halved.</strong></p>
                <figure xml:id="fig-inverse-pressure-volume-exercise">
                    <caption>Graph of <m>P = \frac{20}{V}</m> for the inverse variation exercise.</caption>
                    <image width="100%">
                        <latex-image>
                            \begin{tikzpicture}
                            \begin{axis}[
                                grid=both,
                                minor grid style={draw=gray!15, line width=0.2pt},
                                major grid style={draw=gray!40, line width=0.4pt},
                                minor tick num=1,
                                xtick distance=2,
                                ytick distance=2,
                                axis lines=left,
                                ylabel={Pressure ($P$)},
                                xlabel={Volume ($V$)},
                                xmin=0, xmax=22, ymin=0, ymax=12,
                                width=6.5cm, height=7cm,
                                tick label style={font=\small},
                                label style={font=\small}
                            ]
                            \addplot[red, samples=200, domain=0.5:20] {20/x};
                            \addplot[only marks, mark=*, blue, mark size=2pt] coordinates {(10,2) (20,1)};
                            \end{axis}
                            \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </answer>
        </exercise>
    </exercises>

    <axiom component="lesson-plan">
    <title>Differentiation</title>`
<table>
    <title>Differentiation</title>
    <tabular halign="left">
        <row header="yes" bottom="minor">
            <cell>Learner Group</cell>
            <cell>Strategy &amp; Learning Experience</cell>
            <cell></cell>
        </row>
        <row>
            <cell>Struggling Learners (Support)</cell>
            <cell>
                <line>Provide completed examples of inverse variation tables before asking learners to complete similar tasks independently.</line>
                <line>Use concrete materials such as tiles, counters, or rectangular arrays to reinforce the idea of a constant product.</line>
                <line>Guide learners with prompts such as "What number do the two values multiply to?" and provide structured worksheets with step-by-step scaffolding.</line>
            </cell>
            <cell></cell>
        </row>
        <row>
            <cell>On-Level Learners (Core)</cell>
            <cell>
                <line>The core lesson activities as described above.</line>
            </cell>
            <cell></cell>
        </row>
        <row>
            <cell>Advanced Learners (Challenge)</cell>
            <cell>
                <line>Challenge learners to derive inverse variation equations from unfamiliar real-life contexts such as speed and time, pressure and volume, or workers and completion time.</line>
                <line>Ask learners to explain why the graph of an inverse variation never touches the coordinate axes.</line>
                <line>Provide extension tasks involving graph transformations, including plotting <m>y</m> against <m>\frac{1}{x}</m> and interpreting the gradient as the constant of proportionality.</line>
            </cell>
            <cell></cell>
        </row>
    </tabular>
</table>
</axiom>


