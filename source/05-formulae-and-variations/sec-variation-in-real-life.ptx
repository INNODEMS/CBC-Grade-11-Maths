<?xml version="1.0" encoding="utf-8"?>

<section xml:id="sec-variation-in-real-life" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Variation in Real Life</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>1.0 Numbers and Algebra</p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>1.5 Formulae and Variations</p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title> 
                    <p>
                        <ul>
                          <li>Apply variations to real life situations</li>
                          <li>Appreciate the use of variations in day-to-day life</li>
                        </ul>
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>11</p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>40 minutes</p>
                </li>
            </dl>
            </p>
        </introduction>
    </objectives>

  <axiom component="lesson-plan">
    <title>Problem-Solving and Discovery</title>
    <dl>
        <li>
            <title>Suggested Time</title>
            <p>
                15 minutes
            </p>
        </li>
        <li>
            <title>Objective</title>
            <p>
                To enable learners to interpret real-life data, identify fixed and variable components, and connect tables of values to graphical and algebraic models.
            </p>
        </li>
        <li>
            <title>Teacher's Role</title>
            <p>
                Facilitate discussion around the taxi fare scenario and encourage learners to explain what each value in the table represents. Guide learners in plotting points accurately, identifying patterns in the data, and interpreting the meaning of the graph in the context of transport costs. Use questioning to help learners recognize that the graph represents a real-world pricing model consisting of a fixed booking fee and a distance-dependent charge.
            </p>
        </li>
    </dl>
</axiom>

<activity>
        <statement>
            <p>
                <strong>Activity: From Tables to Graphs</strong>
            </p>
            <p>
                A taxi service in Nairobi charges a base "booking fee" of 200 Ksh and an additional 100 Ksh for every kilometer traveled.
            </p>
            <table>
                <title>Taxi Fare Data</title>
                <tabular halign="center">
                    <row header="yes" bottom="minor">
                        <cell>Distance (<m>d</m>) in km</cell>
                        <cell>0</cell>
                        <cell>2</cell>
                        <cell>4</cell>
                        <cell>6</cell>
                        <cell>8</cell>
                    </row>
                    <row>
                        <cell>Total Cost (<m>C</m>) in Ksh</cell>
                        <cell>200</cell>
                        <cell>400</cell>
                        <cell>600</cell>
                        <cell>800</cell>
                        <cell>1000</cell>
                    </row>
                </tabular>
            </table>
            <p>
                <strong>Steps:</strong>
                <ol>
                    <li>Plot the Total Cost (<m>C</m>) on the vertical axis and Distance (<m>d</m>) on the horizontal axis.</li>
                    <li>Connect the points with a straight line.</li>
                    <li>Identify the point where the line crosses the vertical axis. What does this value represent?</li>
                </ol>
            </p>
            <figure xml:id="fig-taxi-fare-activity">
                <caption>Taxi fare: <m>C = 100d + 200</m>, showing base booking fee of 200 Ksh plus 100 Ksh per km.</caption>
                <image width="100%">
                    <latex-image>
                        \begin{tikzpicture}
                        \begin{axis}[
                            grid=both,
                            minor grid style={draw=gray!15, line width=0.2pt},
                            major grid style={draw=gray!40, line width=0.4pt},
                            minor tick num=1,
                            xtick distance=2,
                            ytick distance=200,
                            axis lines=left,
                            ylabel={Cost ($C$) Ksh},
                            xlabel={Distance ($d$) km},
                            xmin=0, xmax=10, ymin=0, ymax=1200,
                            width=6.5cm, height=7cm,
                            tick label style={font=\small},
                            label style={font=\small}
                        ]
                        \addplot[red, samples=2, domain=0:10] {100*x + 200};
                        \addplot[only marks, mark=*, blue, mark size=2pt] coordinates {(0,200) (2,400) (4,600) (6,800) (8,1000)};
                        \end{axis}
                        \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
        </statement>
    </activity>

   <axiom component="lesson-plan">
    <title>Structured Instruction</title>
    <p>
        <dl>
            <li>
                <title>Suggested Time</title>
                <p>
                    10 minutes
                </p>
            </li>
            <li>
                <title>Objective</title>
                <p>
                    To consolidate learners' understanding of how variation models are applied in everyday situations and how tables, graphs, and equations represent the same relationship.
                </p>
            </li>
        </dl>
    </p>
    <paragraphs>
        <title>Key Takeaways &amp; Teacher Connection</title>
        <ol>
            <li>
                <p>
                    <alert>Connecting to Learner Work:</alert> Refer learners to the taxi fare graph and ask them to explain the meaning of the point <m>(0,200)</m>. Reinforce that the booking fee is charged even before any distance is travelled.
                </p>
            </li>
            <li>
                <p>
                    Guide learners to recognize that tables, graphs, and equations are different representations of the same relationship. Each representation provides useful information about the situation being modelled.
                </p>
            </li>
            <li>
                <p>
                    Review how the equation <m>C = 100d + 200</m> captures both the variable charge (100 Ksh per kilometre) and the fixed booking fee (200 Ksh).
                </p>
            </li>
            <li>
                <p>
                    Connect this lesson to previous learning by identifying where direct, inverse, joint, combined, and partial variation appear in everyday contexts such as farming, transport, utility billing, construction, and business.
                </p>
            </li>
            <li>
                <p>
                    Emphasize that mathematical models allow people to predict costs, compare alternatives, make budgets, and support decision-making in real-life situations.
                </p>
            </li>
            <li>
                <p>
                    Encourage learners to evaluate whether a mathematical model is realistic by interpreting its parameters and relating them to the context from which the data was collected.
                </p>
            </li>
        </ol>
    </paragraphs>
</axiom>

    <insight>
        <title>Variation in Real-Life Contexts</title>
        <p>
            In real life, most pricing and cost structures follow the pattern of <strong>partial variation</strong>: they consist of a <em>fixed component</em> plus a <em>variable component</em>.
        </p>
        <p>
            <ol>
                <li>
                    <p>
                        <alert>The Fixed Component:</alert> This is charged regardless of consumption or usage. Examples include booking fees, standing charges, mobilization fees, setup costs, or insurance charges.
                    </p>
                </li>
                <li>
                    <p>
                        <alert>The Variable Component:</alert> This changes based on the quantity used or produced. Examples include per-kilometer charges, per-unit costs, per-hour rates, or commission percentages.
                    </p>
                </li>
                <li>
                    <p>
                        <alert>The Equation:</alert> <me>\\text{Total Cost} = \\text{(Rate)} \\times \\text{(Quantity)} + \\text{(Fixed Fee)}</me>
                    </p>
                </li>
            </ol>
        </p>
        <figure xml:id="fig-real-life-variation-concept">
            <caption>General real-life variation model: Total Cost = 250 + 150 × Quantity, where 250 Ksh is the fixed cost and 150 Ksh is the rate per unit.</caption>
            <image width="100%">
                <latex-image>
                    \begin{tikzpicture}
                    \begin{axis}[
                        grid=both,
                        minor grid style={draw=gray!15, line width=0.2pt},
                        major grid style={draw=gray!40, line width=0.4pt},
                        minor tick num=1,
                        xtick distance=1,
                        ytick distance=200,
                        axis lines=left,
                        ylabel={Total Cost (Ksh)},
                        xlabel={Quantity},
                        xmin=0, xmax=6, ymin=0, ymax=1200,
                        width=6.5cm, height=7cm,
                        tick label style={font=\small},
                        label style={font=\small}
                    ]
                    \addplot[red, samples=2, domain=0:5.5] {150*x + 250};
                    \addplot[only marks, mark=*, blue, mark size=2pt] coordinates {(0,250) (1,400) (2,550) (3,700) (4,850) (5,1000)};
                    \end{axis}
                    \end{tikzpicture}
                </latex-image>
            </image>
        </figure>
    </insight>

    

    <xi:include href="../lesson-plan-templates/example-intro.ptx" />

    <example>
        <statement>
            <p><strong>1. Agribusiness:</strong> The cost of tilling a farm (<m>C</m>) is partly constant and partly varies as the area (<m>A</m>) in acres. If tilling 2 acres costs 4,500 Ksh and 6 acres costs 10,500 Ksh, find the cost of tilling 10 acres.</p>
        </statement>
        <solution>
            <p>
                Let <m>C = kA + b</m>.
                Subtracting the equations <m>10500 = 6k + b</m> and <m>4500 = 2k + b</m> gives <m>4k = 6000</m>, so <m>k = 1500</m>.
                Substitute into the first equation: <m>4500 = 2(1500) + b</m>, so <m>b = 1500</m>.
                For 10 acres: <me>C = 1500(10) + 1500 = 16,500 \text{ Ksh}</me>
            </p>
            <figure xml:id="fig-agribusiness-tilling">
                <caption>Agribusiness: Farm tilling cost <m>C = 1500A + 1500</m>, showing fixed mobilization fee of 1,500 Ksh.</caption>
                <image width="100%">
                    <latex-image>
                        \begin{tikzpicture}
                        \begin{axis}[
                            grid=both,
                            minor grid style={draw=gray!15, line width=0.2pt},
                            major grid style={draw=gray!40, line width=0.4pt},
                            minor tick num=1,
                            xtick distance=1,
                            ytick distance=1500,
                            axis lines=left,
                            ylabel={Cost ($C$) Ksh},
                            xlabel={Area ($A$) acres},
                            xmin=0, xmax=11, ymin=0, ymax=18000,
                            width=6.5cm, height=7cm,
                            tick label style={font=\small},
                            label style={font=\small}
                        ]
                        \addplot[red, samples=2, domain=0:10] {1500*x + 1500};
                        \addplot[only marks, mark=*, blue, mark size=2pt] coordinates {(0,1500) (2,4500) (6,10500) (10,16500)};
                        \end{axis}
                        \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
        </solution>
    </example>

    <example>
        <statement>
            <p><strong>2. Utility Bills:</strong> A water bill in Nakuru has a fixed standing charge and a variable rate per unit. If 20 units cost 850 Ksh and 35 units cost 1,300 Ksh, calculate the bill for 50 units.</p>
        </statement>
        <solution>
            <p>
                The difference in cost for 15 units is 450 Ksh, so the rate <m>k = 30 \text{ Ksh/unit}</m>.
                Fixed charge <m>b = 850 - 20(30) = 250 \text{ Ksh}</m>.
                For 50 units: <me>C = 30(50) + 250 = 1,750 \text{ Ksh}</me>
            </p>
            <figure xml:id="fig-water-bill-nakuru">
                <caption>Utility bills: Water bill <m>C = 30u + 250</m>, showing standing charge of 250 Ksh.</caption>
                <image width="100%">
                    <latex-image>
                        \begin{tikzpicture}
                        \begin{axis}[
                            grid=both,
                            minor grid style={draw=gray!15, line width=0.2pt},
                            major grid style={draw=gray!40, line width=0.4pt},
                            minor tick num=1,
                            xtick distance=5,
                            ytick distance=250,
                            axis lines=left,
                            ylabel={Cost ($C$) Ksh},
                            xlabel={Units ($u$)},
                            xmin=0, xmax=55, ymin=0, ymax=2000,
                            width=6.5cm, height=7cm,
                            tick label style={font=\small},
                            label style={font=\small}
                        ]
                        \addplot[red, samples=2, domain=0:50] {30*x + 250};
                        \addplot[only marks, mark=*, blue, mark size=2pt] coordinates {(0,250) (20,850) (35,1300) (50,1750)};
                        \end{axis}
                        \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
        </solution>
    </example>

    <example>
        <statement>
            <p><strong>3. Logistics:</strong> A courier company charges 2,500 Ksh flat for insurance and 150 Ksh per kg for transport. Find the total cost to ship a 45 kg crate.</p>
        </statement>
        <solution>
            <p>
                Equation: <m>T = 150w + 2500</m>.
                For <m>w = 45</m>:
                <me>T = 150(45) + 2500 = 6750 + 2500 = 9,250 \text{ Ksh}</me>
            </p>
            <figure xml:id="fig-courier-logistics">
                <caption>Logistics: Courier shipping cost <m>T = 150w + 2500</m>, showing insurance fee of 2,500 Ksh.</caption>
                <image width="100%">
                    <latex-image>
                        \begin{tikzpicture}
                        \begin{axis}[
                            grid=both,
                            minor grid style={draw=gray!15, line width=0.2pt},
                            major grid style={draw=gray!40, line width=0.4pt},
                            minor tick num=1,
                            xtick distance=5,
                            ytick distance=500,
                            axis lines=left,
                            ylabel={Cost ($T$) Ksh},
                            xlabel={Weight ($w$) kg},
                            xmin=0, xmax=50, ymin=0, ymax=10000,
                            width=6.5cm, height=7cm,
                            tick label style={font=\small},
                            label style={font=\small}
                        ]
                        \addplot[red, samples=2, domain=0:48] {150*x + 2500};
                        \addplot[only marks, mark=*, blue, mark size=2pt] coordinates {(0,2500) (10,4000) (30,7000) (45,9250)};
                        \end{axis}
                        \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
        </solution>
    </example>

    <example>
        <statement>
            <p><strong>4. Construction:</strong> A contractor charges a fixed mobilization fee and a cost per meter to build a stone wall. 10 meters cost 15,000 Ksh, while 25 meters cost 30,000 Ksh. Find the fixed fee.</p>
        </statement>
        <solution>
            <p>
                Difference of 15 meters costs 15,000 Ksh, so <m>k = 1000 \text{ Ksh/m}</m>.
                Using <m>15000 = 10(1000) + b</m>:
                <me>b = 15000 - 10000 = 5,000 \text{ Ksh}</me>
            </p>
            <figure xml:id="fig-stone-wall-construction">
                <caption>Construction: Stone wall cost <m>C = 1000m + 5000</m>, showing mobilization fee of 5,000 Ksh.</caption>
                <image width="100%">
                    <latex-image>
                        \begin{tikzpicture}
                        \begin{axis}[
                            grid=both,
                            minor grid style={draw=gray!15, line width=0.2pt},
                            major grid style={draw=gray!40, line width=0.4pt},
                            minor tick num=1,
                            xtick distance=5,
                            ytick distance=5000,
                            axis lines=left,
                            ylabel={Cost ($C$) Ksh},
                            xlabel={Length ($m$) meters},
                            xmin=0, xmax=30, ymin=0, ymax=32000,
                            width=6.5cm, height=7cm,
                            tick label style={font=\small},
                            label style={font=\small}
                        ]
                        \addplot[red, samples=2, domain=0:27] {1000*x + 5000};
                        \addplot[only marks, mark=*, blue, mark size=2pt] coordinates {(0,5000) (10,15000) (25,30000)};
                        \end{axis}
                        \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
        </solution>
    </example>

    <example>
        <statement>
            <p><strong>5. Employment:</strong> A salesman earns a basic salary plus a 10% commission on sales. If he earns 25,000 Ksh for selling goods worth 100,000 Ksh, find his basic salary.</p>
        </statement>
        <solution>
            <p>
                Commission = <m>0.1 \times 100000 = 10,000 \text{ Ksh}</m>.
                Basic Salary = <m>25000 - 10000 = 15,000 \text{ Ksh}</m>.
            </p>
        </solution>
    </example>

    <xi:include href="../lesson-plan-templates/assessment-intro.ptx" />

    <exercises>
        <exercise>
            <statement>
                <p>A printing business charges a fixed setup fee of 3,000 Ksh and 50 Ksh per brochure. Write the equation for the total cost and calculate the cost for 500 brochures.</p>
            </statement>
            <solution>
                <p>
                    <me>C = 50n + 3000</me>
                    <me>C = 50(500) + 3000 = 25000 + 3000 = 28,000 \text{ Ksh}</me>
                </p>
            </solution>
        </exercise>

        <exercise>
            <statement>
                <p> A certain borehole drilling company in Kajiado charges a fixed fee of 60,000 Ksh and 3,500 Ksh per meter. If a farmer paid 410,000 Ksh, how deep was the borehole?</p>
            </statement>
            <solution>
                <p>
                    <me>410000 = 3500d + 60000</me>
                    <me>350000 = 3500d \text{ so } d = 100 \text{ meters}</me>
                </p>
            </solution>
        </exercise>

        <exercise>
            <statement>
                <p>The cost (<m>C</m>) of feeding students at a camp is partly constant and partly varies as the number of students (<m>n</m>). Feeding 50 students costs 12,000 Ksh, while 80 students costs 18,000 Ksh. Find the cost for 120 students.</p>
            </statement>
            <solution>
                <p>
                    Difference for 30 students is 6,000 Ksh, so <m>k = 200</m>.
                    <m>b = 12000 - 50(200) = 2,000</m>.
                    For 120 students: <me>C = 200(120) + 2000 = 26,000 \text{ Ksh}</me>
                </p>
                <figure xml:id="fig-camp-feeding-cost">
                    <caption>Camp feeding: Cost <m>C = 200n + 2000</m>, showing fixed facility cost of 2,000 Ksh.</caption>
                    <image width="100%">
                        <latex-image>
                            \begin{tikzpicture}
                            \begin{axis}[
                                grid=both,
                                minor grid style={draw=gray!15, line width=0.2pt},
                                major grid style={draw=gray!40, line width=0.4pt},
                                minor tick num=1,
                                xtick distance=20,
                                ytick distance=5000,
                                axis lines=left,
                                ylabel={Cost ($C$) Ksh},
                                xlabel={Number of Students ($n$)},
                                xmin=0, xmax=140, ymin=0, ymax=28000,
                                width=6.5cm, height=7cm,
                                tick label style={font=\small},
                                label style={font=\small}
                            ]
                            \addplot[red, samples=2, domain=0:130] {200*x + 2000};
                            \addplot[only marks, mark=*, blue, mark size=2pt] coordinates {(0,2000) (50,12000) (80,18000) (120,26000)};
                            \end{axis}
                            \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </solution>
        </exercise>

        <exercise>
            <statement>
                <p>An internet service provider charges a monthly fee and a rate per GB used. A user pays 1,200 Ksh for 10 GB and 2,000 Ksh for 30 GB. What is the monthly standing charge?</p>
            </statement>
            <solution>
                <p>
                    Difference of 20 GB costs 800 Ksh, so <m>k = 40 \text{ Ksh/GB}</m>.
                    Standing charge <m>b = 1200 - 10(40) = 800 \text{ Ksh}</m>.
                </p>
            </solution>
        </exercise>

        <exercise>
            <statement>
                <p>A dairy farmer's daily production cost is 5,000 Ksh plus 20 Ksh per liter of milk produced. If the total cost one day was 9,400 Ksh, how many liters were produced?</p>
            </statement>
            <solution>
                <p>
                    <me>9400 = 20L + 5000</me>
                    <me>4400 = 20L \text{ so } L = 220 \text{ liters}</me>
                </p>
            </solution>
        </exercise>
    </exercises>

    <axiom component="lesson-plan">
    <title>Differentiation</title>

    <table>
        <title>Differentiation Strategies</title>
        <tabular halign="left">
            <row header="yes" bottom="minor">
                <cell>Learner Group</cell>
                <cell>Strategy &amp; Learning Experience</cell>
            </row>

            <row>
                <cell>Struggling Learners (Support)</cell>
                <cell>
                    <line>Provide guided questions that help learners identify fixed costs, rates of change, and relevant variables in each context.</line>
                    <line>Use colour-coding to distinguish fixed and variable components in tables, graphs, and equations.</line>
                    <line>Allow learners to work with familiar local examples such as taxi fares, mobile money charges, water bills, and market transport costs before moving to abstract problems.</line>
                </cell>
            </row>

            <row>
                <cell>On-Level Learners (Core)</cell>
                <cell>
                    <line>The core lesson activities as described above.</line>
                </cell>
            </row>

            <row>
                <cell>Advanced Learners (Challenge)</cell>
                <cell>
                    <line>Challenge learners to create their own real-life variation scenario, collect sample data, and develop a table, graph, and equation that model the relationship.</line>
                    <line>Ask learners to compare multiple pricing models and determine which offers the best value under different conditions.</line>
                    <line>Provide open-ended modelling tasks requiring learners to justify assumptions, interpret parameters, and evaluate the suitability of their mathematical models.</line>
                </cell>
            </row>

        </tabular>
    </table>
</axiom>

    <xi:include href="../lesson-plan-templates/assessment-methods.ptx" />
