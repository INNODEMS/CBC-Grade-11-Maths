    <!-- Add static exercises -->

    <exercises xml:id="exercise-range-function">
        <exercise>
            <statement>
                <p>
                    Find the range of each of the following functions.
                </p>
                <p>
                    <ol marker="(a)" cols="2">

                        <li>
                            <p>
                                <m>f(x)=3x-5</m>
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>g(x)=x^2+2</m>
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>h(x)=\sqrt{x}</m>
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>p(x)=|x-4|</m>
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>q(x)=2^x</m>
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>r(x)=\dfrac{1}{x} + 3</m>
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>s(x)=-x^2</m>
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>t(x)=\sqrt{x+5}-1</m>
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>u(x)=e^x - 2</m>
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>v(x)=7</m>
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)" cols="2">
                        <li>
                            <p>All real numbers</p>
                        </li>
                        <li>
                            <p><m>y \geq 2</m></p>
                        </li>
                        <li>
                            <p><m>y \geq 0</m></p>
                        </li>
                        <li>
                            <p><m>y \geq 0</m></p>
                        </li>
                        <li>
                            <p><m>y \gt 0</m></p>
                        </li>
                        <li>
                            <p>All real numbers where <m>y \neq 3</m></p>
                        </li>
                        <li>
                            <p><m>y \leq 0</m></p>
                        </li>
                        <li>
                            <p><m>y \geq -1</m></p>
                        </li>
                        <li>
                            <p><m>y \gt -2</m></p>
                        </li>
                        <li>
                            <p>The only output is <m>y = 7</m></p>
                        </li>
                    </ol>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    Find the range of <m>f(x) = x^2 - 9</m>.
                </p>
            </statement>
            <answer>
                <p><m>y \geq -9</m></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>
                    Determine the range of <m>g(x) = -x^2 + 5</m>.
                </p>
            </statement>
            <answer>
                <p><m>y \leq 5</m></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>
                    Calculate the range of <m>h(x) = \sqrt{x - 3}</m>.
                </p>
            </statement>
            <answer>
                <p><m>y \geq 0</m></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>
                    Find the range of <m>p(x) = 3^x + 1</m>.
                </p>
            </statement>
            <answer>
                <p><m>y \gt 1</m></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>
                    Determine the range of <m>q(x) = \dfrac{2}{x} - 4</m>.
                </p>
            </statement>
            <answer>
                <p>All real numbers where <m>y \neq -4</m></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>
                    Calculate the range of <m>r(x) = |2x + 1|</m>.
                </p>
            </statement>
            <answer>
                <p><m>y \geq 0</m></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>
                    Find the range of <m>s(x) = -(x-2)^2 + 6</m>.
                </p>
            </statement>
            <answer>
                <p><m>y \leq 6</m></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>
                    Determine the range of <m>t(x) = \sqrt{4 - x}</m>.
                </p>
            </statement>
            <answer>
                <p><m>y \geq 0</m></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>
                    The graph below shows a function <m>w(x)</m>. Determine the range of the function from the graph.
                </p>
                <figure xml:id="fig-range-exercise-graph">
                    <caption>Graph of <m>w(x)</m> for an exercise on reading the range.</caption>
                    <image xml:id="tikz-range-exercise-graph" width="65%">
                        <shortdescription>A curve starting at a filled dot at y equals negative 3 and ending at an open dot at y equals 5.</shortdescription>
                        <latex-image>
                            \begin{tikzpicture}[scale=0.9]
                                \draw[->, thick] (-4,0) -- (6,0) node[below] {$x$};
                                \draw[->, thick] (0,-4) -- (0,6) node[left] {$y$};
                                \draw (0.1, -3) -- (-0.1, -3) node[left] {$-3$};
                                \draw (0.1,  5) -- (-0.1,  5) node[left] {$5$};
                                \draw[very thick, blue]
                                    (-3,-3) .. controls (0,2) and (2,1) .. (4,5);
                                \filldraw[blue] (-3,-3) circle (2.5pt);
                                \filldraw[fill=white, draw=blue, thick] (4,5) circle (2.5pt);
                                \draw[dashed, gray] (0,-3) -- (-3,-3);
                                \draw[dashed, gray] (0,5)  -- (4,5);
                            \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </statement>
            <answer>
                <p><m>-3 \leq y \lt 5</m></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>
                    A ball is thrown upwards and its height in metres above the ground after <m>t</m> seconds is given by <m>H(t) = -5t^2 + 20t</m>, where <m>t \geq 0</m>. Find the range of <m>H</m> for the time the ball is in the air, and explain what the maximum value of the range means in this context.
                </p>
            </statement>
            <answer>
                <p>
                    The vertex occurs at <m>t = 2</m>, giving a maximum height of <m>H(2) = 20</m> metres. The ball starts and ends at ground level, so the range is <m>0 \leq H \leq 20</m>. The maximum value of 20 means the ball reaches a height of 20 metres at its highest point.
                </p>
            </answer>
        </exercise>
        
    </exercises>


    <!-- [LP] Add information on how to differentiate  -->

    <axiom component="lesson-plan">
        <title>Differentiation</title>
        <table>
            <title>Differentiation Strategies</title>
            <tabular halign="left">
                <row header="yes" bottom="minor">
                    <cell>Learner Group</cell>
                    <cell>Strategy and Learning Experience</cell>
                </row>
                <row bottom="minor">
                    <cell>Struggling Learners (Support)</cell>
                    <cell>
                        Keep the range summary table from the insight block visible throughout the lesson. Encourage these learners to begin every question by identifying the function type (linear, quadratic, square root, etc.) before attempting any calculation. Focus their practice on the graphical examples first (reading the range directly from a graph) before moving to algebraic questions. Exercises (a) to (e) in Exercise 1 are appropriate starting points.
                    </cell>
                </row>
                <row bottom="minor">
                    <cell>On-Level Learners (Core)</cell>
                    <cell>
                        The core lesson activities as described above.
                    </cell>
                </row>
                <row bottom="minor">
                    <cell>Advanced Learners (Challenge)</cell>
                    <cell>
                        Ask these learners to work with composite restrictions, such as finding the range of <m>f(x) = \dfrac{1}{\sqrt{x-2}} + 3</m>, where they must consider both the square root rule and the effect of the rational form on the output. They can also be challenged to sketch their own graph for a given range, for example "draw a function whose range is <m>-1 \leq y \lt 4</m>," and explain their reasoning.
                    </cell>
                </row>
            </tabular>
        </table>
    </axiom>


    <xi:include href="../lesson-plan-templates/assessment-methods.ptx" />

    <xi:include href="../lesson-plan-templates/reflection.ptx"/>

    
</section>
