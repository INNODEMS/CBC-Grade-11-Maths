    <!-- Add STACK exercises if made -->

    <!-- Add static exercises -->

    <exercises xml:id="exercises-inverse-polynomials-1">
        <exercise>
            <statement>
                <p>
                    For each of the following functions, determine the inverse function where possible.
                </p>
                <p>
                    <ol marker="(a)" cols="2">
                        <li>
                            <p><m>f(x) = 3x + 6</m></p>
                        </li>

                        <li>
                            <p><m>g(x) = x^3 - 8</m></p>
                        </li>

                        <li>
                            <p><m>p(x) = -2x^7 + 4</m></p>
                        </li>

                        <li>
                            <p><m>k(x) = x^4 - 3</m></p>
                        </li>
                    </ol>
                </p>
            </statement>

            <answer>
                <p>
                    <ol marker="(a)" cols="2">
                        <li><p><m>f^{-1}(x)=\frac{1}{3}x-2</m></p></li>
                        <li><p><m>g^{-1}(x)=\sqrt[3]{x+8}</m></p></li>
                        <li><p><m>p^{-1}(x)=\sqrt[7]{-\frac{1}{2}(x-4)}</m></p></li>
                        <li><p>No inverse function</p></li>
                    </ol>
                </p>
            </answer>

            <solution>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                Let <m>y=3x+6</m>.
                            </p>

                            <p>
                            <md>
                                <mrow>y \amp = 3x+6</mrow>
                                <mrow>x \amp = 3y+6</mrow>
                                <mrow>x-6 \amp = 3y</mrow>
                                <mrow>y \amp = \frac{x-6}{3}</mrow>
                                <mrow>y \amp = \frac{1}{3}x-2</mrow>
                            </md>
                            </p>

                            <p>
                                Therefore,
                                <m>f^{-1}(x)=\frac{1}{3}x-2</m>.
                            </p>
                        </li>

                        <li>
                            <p>
                                Let <m>y=x^3-8</m>.
                            </p>

                            <p>
                            <md>
                                <mrow>y \amp = x^3-8</mrow>
                                <mrow>x \amp = y^3-8</mrow>
                                <mrow>x+8 \amp = y^3</mrow>
                                <mrow>y \amp = \sqrt[3]{x+8}</mrow>
                            </md>
                            </p>

                            <p>
                                Therefore,
                                <m>g^{-1}(x)=\sqrt[3]{x+8}</m>.
                            </p>
                        </li>

                        <li>
                            <p>
                                Let <m>y=-2x^7+4</m>.
                            </p>

                            <p>
                            <md>
                                <mrow>y \amp = -2x^7+4</mrow>
                                <mrow>x \amp = -2y^7+4</mrow>
                                <mrow>x-4 \amp = -2y^7</mrow>
                                <mrow>\frac{x-4}{-2} \amp = y^7</mrow>
                                <mrow>y \amp = \sqrt[7]{-\frac{1}{2}(x-4)}</mrow>
                            </md>
                            </p>
                        </li>

                        <li>
                            <p>
                                The function <m>k(x)=x^4-3</m> has an even degree and is not one-to-one.
                            </p>

                            <p>
                                Since different values of <m>x</m> can produce the same output, the function fails the horizontal line test and therefore does not have an inverse function over all real numbers.
                            </p>
                        </li>
                    </ol>
                </p>
            </solution>
        </exercise>

        <exercise>
            <statement>
                <p>
                    The graph below represents the function <m>y=x^3</m> together with the line <m>y=x</m>.
                </p>

                <figure xml:id="fig-cubic-and-line">
                    <caption>Graph of <m>y=x^3</m> and the line <m>y=x</m></caption>
                    <image width="50%" xml:id="img-cubic-and-line">
                        <shortdescription>A graph of the cubic function y = x^3 along with a dashed diagonal line representing y = x.</shortdescription>
                        <latex-image>
                            \begin{tikzpicture}[scale=0.7]
                                \draw[-&gt;] (-3,0)--(3,0) node[right]{$x$};
                                \draw[-&gt;] (0,-3)--(0,3) node[above]{$y$};
                                \draw[dashed] (-3,-3)--(3,3);
                                \draw[domain=-1.4:1.4,smooth,thick] plot (\x,{\x*\x*\x});
                                \node[right] at (1.2,1.7){$y=x^3$};
                                \node[right] at (2,2.2){$y=x$};
                            \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>

                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                Write the inverse function of <m>y=x^3</m>.
                            </p>
                        </li>

                        <li>
                            <p>
                                Describe the relationship between a function and its inverse graphically.
                            </p>
                        </li>

                        <li>
                            <p>
                                Explain why <m>y=x^3</m> has an inverse function.
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>

            <answer>
                <p>
                    <ol marker="(a)">
                        <li><p><m>y=\sqrt[3]{x}</m></p></li>
                        <li><p>The graphs are reflections in the line <m>y=x</m>.</p></li>
                        <li><p>The function is one-to-one.</p></li>
                    </ol>
                </p>
            </answer>

            <solution>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                
                            </p>
                            <p>
                                <md>
                                    <mrow>y \amp = x^3</mrow>
                                    <mrow>x \amp = y^3</mrow>
                                    <mrow>y \amp = \sqrt[3]{x}</mrow>
                                </md>
                            </p>
                        </li>

                        <li>
                            <p>
                                A function and its inverse are mirror images of each other in the line <m>y=x</m>.
                            </p>
                        </li>

                        <li>
                            <p>
                                Every horizontal line intersects the graph only once, so the function is one-to-one and therefore has an inverse.
                            </p>
                        </li>
                    </ol>
                </p>
            </solution>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The graph below represents the function <m>y=x^2</m>.
                </p>
                <figure xml:id="fig-parabola-inverse-test">
                    <caption>Graph of <m>y=x^2</m> and the horizontal line test</caption>
                    <image width="50%" xml:id="img-parabola-inverse-test">
                        <shortdescription>A graph of the parabola y = x^2 with a horizontal dashed line at y = 1 intersecting the curve at two points.</shortdescription>
                        <latex-image>
                            \begin{tikzpicture}[scale=0.7]
                                \draw[-&gt;] (-3,0)--(3,0) node[right]{$x$};
                                \draw[-&gt;] (0,-1)--(0,5) node[above]{$y$};
                                \draw[domain=-2:2,smooth,thick] plot (\x,{\x*\x});
                                \draw[dashed] (-2,1)--(2,1);
                                \node[right] at (1.5,4){$y=x^2$};
                            \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                Explain why the function does not have an inverse over all real numbers.
                            </p>
                        </li>
                        <li>
                            <p>
                                State a suitable restriction on the domain.
                            </p>
                        </li>
                        <li>
                            <p>
                                Write the inverse function for the restricted domain.
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)">
                        <li><p>The function is not one-to-one.</p></li>
                        <li><p><m>x\geq0</m></p></li>
                        <li><p><m>f^{-1}(x)=\sqrt{x}</m></p></li>
                    </ol>
                </p>
            </answer>
            <solution>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                The dashed horizontal line cuts the graph at two points. This means different values of <m>x</m> produce the same output.
                            </p>
                            <p>
                                Therefore, the function fails the horizontal line test and is not one-to-one.
                            </p>
                        </li>
                        <li>
                            <p>
                                Restricting the domain to <m>x\geq0</m> makes the function one-to-one.
                            </p>
                        </li>
                        <li>
                            <md>
                                <mrow>y \amp = x^2</mrow>
                                <mrow>x \amp = y^2</mrow>
                                <mrow>y \amp = \sqrt{x}</mrow>
                            </md>
                        </li>
                    </ol>
                </p>
            </solution>
        </exercise>
        <exercise>
            <statement>
                <p>
                    A taxi company charges a fixed booking fee of KSh <m>200</m> and an additional KSh <m>50</m> per kilometre travelled.
                </p>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                Write a function representing the total fare.
                            </p>
                        </li>

                        <li>
                            <p>
                                Find the inverse function.
                            </p>
                        </li>

                        <li>
                            <p>
                                Use the inverse function to determine the distance travelled if the fare was KSh <m>950</m>.
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>

            <answer>
                <p>
                    <ol marker="(a)">
                        <li><p><m>F(x)=50x+200</m></p></li>
                        <li><p><m>F^{-1}(x)=\frac{x-200}{50}</m></p></li>
                        <li><p><m>15</m> km</p></li>
                    </ol>
                </p>
            </answer>
            <solution>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                The total fare equals the booking fee plus the cost per kilometre.
                            </p>

                            <p>
                                <md>F(x)=50x+200</md>
                            </p>
                        </li>

                        <li>
                            <p>
                            <md>
                                <mrow>y \amp = 50x+200</mrow>
                                <mrow>x \amp = 50y+200</mrow>
                                <mrow>x-200 \amp = 50y</mrow>
                                <mrow>y \amp = \frac{x-200}{50}</mrow>
                            </md>
                            </p>
                        </li>

                        <li>
                            <p>
                                Substitute <m>x=950</m> into the inverse function.
                            </p>

                            <p>
                            <md>
                                <mrow>F^{-1}(950) \amp = \frac{950-200}{50}</mrow>
                                <mrow>\amp = \frac{750}{50}</mrow>
                                <mrow>\amp = 15</mrow>
                            </md>
                            </p>

                            <p>
                                Therefore, the taxi travelled <m>15</m> km.
                            </p>
                        </li>
                    </ol>
                </p>
            </solution>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The relationship between temperature in degrees Celsius and degrees Fahrenheit is given by
                    <m>F(C)=\frac{9}{5}C+32</m>.
                </p>

                <ol marker="(a)">
                    <li>
                        <p>
                            Determine the inverse function.
                        </p>
                    </li>

                    <li>
                        <p>
                            Use the inverse function to convert <m>95^\circ F</m> to degrees Celsius.
                        </p>
                    </li>

                    <li>
                        <p>
                            Explain the practical meaning of the inverse function in this context.
                        </p>
                    </li>
                </ol>
            </statement>

            <answer>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p><m>F^{-1}(x)=\frac{5}{9}(x-32)</m></p>
                        </li>

                        <li>
                            <p><m>35^\circ C</m></p>
                        </li>

                        <li>
                            <p>
                                The inverse function converts temperatures from Fahrenheit to Celsius.
                            </p>
                        </li>
                    </ol>
                </p>
            </answer>

            <solution>
                <p>  
                    <ol marker="(a)">

                        <li>
                            <p>
                                Start by writing the function in terms of <m>y</m>.
                            </p>

                            <p>
                                <md>y=\frac{9}{5}x+32</md>
                            </p>

                            <p>
                                Interchange <m>x</m> and <m>y</m>.
                            </p>

                            <p>
                                <md>x=\frac{9}{5}y+32</md>
                            </p>

                            <p>
                                Solve the equation for <m>y</m>.
                            </p>

                            <p>
                            <md>
                                <mrow>x-32 \amp = \frac{9}{5}y</mrow>
                                <mrow>\frac{5}{9}(x-32) \amp = y</mrow>
                            </md>
                            </p>

                            <p>
                                Therefore,
                            </p>

                            <p>
                                <md>F^{-1}(x)=\frac{5}{9}(x-32)</md>
                            </p>
                        </li>

                        <li>
                            <p>
                                Substitute <m>x=95</m> into the inverse function.
                            </p>

                            <p>
                            <md>
                                <mrow>F^{-1}(95) \amp = \frac{5}{9}(95-32)</mrow>
                                <mrow>\amp = \frac{5}{9}(63)</mrow>
                                <mrow>\amp = 35</mrow>
                            </md>
                            </p>

                            <p>
                                Therefore,
                                <m>95^\circ F = 35^\circ C</m>.
                            </p>
                        </li>

                        <li>
                            <p>
                                The inverse function changes temperatures measured in Fahrenheit back into degrees Celsius.
                            </p>
                        </li>

                    </ol>
                </p>
            </solution>
        </exercise>
        
    </exercises>

    <!-- [LP] Add information on how to differentiate  -->

    <axiom component="lesson-plan">
        <title>Differentiation</title>
        <table>
            <title>Differentiation Strategies</title>
            <tabular halign="left">
                <row header="yes" bottom="minor">
                    <cell>Learner Group</cell>
                    <cell>Strategy and Learning Experience</cell>
                </row>
                <row>
                    <cell>Struggling Learners (Support)</cell>
                    <cell>
                        Focus the card activity on <m>f(x) = 2x + 6</m> only and allow students to use a flow diagram to track the operations applied and the operations reversed. Provide a worked example of the four algebraic steps before asking students to attempt their own. Restrict practice to linear functions until the method is secure.
                    </cell>
                </row>
                <row>
                    <cell>On-Level Learners (Core)</cell>
                    <cell>
                        The core lesson activities as described above.
                    </cell>
                </row>
                <row>
                    <cell>Advanced Learners (Challenge)</cell>
                    <cell>
                        Ask advanced learners to investigate what happens when you apply a function and then its inverse in sequence, that is, compute <m>f^{-1}(f(x))</m> and <m>f(f^{-1}(x))</m> and explain the result. You can also challenge them to find conditions on <m>a</m>, <m>n</m>, and <m>c</m> that determine whether a polynomial of the form <m>ax^n + c</m> has an inverse over all real numbers.
                    </cell>
                </row>
            </tabular>
        </table>
    </axiom>

    <xi:include href="../lesson-plan-templates/assessment-methods.ptx" />

    <xi:include href="../lesson-plan-templates/reflection.ptx"/>
    
    



    


</section>
