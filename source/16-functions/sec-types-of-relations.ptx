    <!-- <xi:include href="../lesson-plan-templates/checkpoint.ptx" /> -->

    <!-- Add STACK exercises if made -->

    <!-- Add static exercises -->

    <exercises xml:id="exercises-types-of-relations">
        <exercise>
            <statement>
                <p>State whether the relation below is one-to-one, many-to-one, one-to-many, or many-to-many.</p>
                <p>
                    <md>\{(1,2), (2,4), (3,6)\}</md>
                </p>
            </statement>
            <answer>
                <p>One-to-One</p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>Classify the following relation:</p>
                <p>
                    <md>\{(1,5), (2,5), (3,5)\}</md>
                </p>
            </statement>
            <answer>
                <p>Many-to-One</p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>Determine the type of relation:</p>
                <p>
                    <md>\{(1,2), (1,4), (1,6)\}</md>
                </p>
            </statement>
            <answer>
                <p>One-to-Many</p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>State the type of relation represented by:</p>
                <p>
                    <md>\{(1,2), (1,3), (2,3), (2,4)\}</md>
                </p>
            </statement>
            <answer>
                <p>Many-to-Many</p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>Which of the following relations are functions?</p>
                <p>
                    <ol marker="a">
                    <li><md>\{(1,2), (2,3), (3,4)\}</md></li>
                    <li><md>\{(1,2), (1,3), (2,4)\}</md></li>
                </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="a">
                    <li><p>Function</p></li>
                    <li><p>Not a function</p></li>
                </ol>
                </p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>Explain why a circle fails the vertical line test.</p>
            </statement>
            <answer>
                <p>Most vertical lines drawn through the domain of the circle will intersect the graph at exactly two points, meaning a single input (<m>x</m>-value) maps to two different outputs (<m>y</m>-values).</p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>Determine whether the function <m>f(x) = x^3</m> passes the horizontal line test.</p>
            </statement>
            <answer>
                <p>Yes. Every horizontal line intersects the graph of <m>y = x^3</m> exactly once, proving that the function is one-to-one.</p>
            </answer>
        </exercise>

    </exercises>

