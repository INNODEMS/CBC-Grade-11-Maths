    // Ensure .ptx files open in the default text editor (not a visual/preview editor)
    "workbench.editorAssociations": [
        {
            "viewType": "default",
            "filenamePattern": "*.ptx"
        }
    ],
    // Also associate .ptx files with XML language for proper syntax highlighting
    "files.associations": {
        "*.ptx": "xml"
    }
}
