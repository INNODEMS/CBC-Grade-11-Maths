    <questionvariables>
      <text><![CDATA[stack_include_contrib("prooflib.mac");


A: matrix([1/2,1/5],[1/5,9/10]);
I2: ident(2);
x_symbol: matrix([N_n],[M_n]);
x0: matrix([100],[40]);

x1: ev(A.x0,simp);
x2: ev(A.x1,simp);

IA: ev(I2-A,simp);
IAinv: ev(invert(IA),simp);
xtotal: ev(IAinv.x0,simp);

/* Sum of absolute entry errors for numerical matrix checking. */
materr2x1(S,T) := abs(S[1,1]-T[1,1]) + abs(S[2,1]-T[2,1]);
materr2x2(S,T) := abs(S[1,1]-T[1,1]) + abs(S[1,2]-T[1,2]) + abs(S[2,1]-T[2,1]) + abs(S[2,2]-T[2,2]);

proof_steps: [
 ["define", "We begin with the finite case. For \\(n\\geq 1\\), define \\(S_n=I+A+A^2+\\cdots+A^n\\) (1)."],
 ["multiply", "Multiply on the left by \\(A\\): \\(AS_n=A + A^2 + A^3 + \\cdots +A^{n+1}\\) (2)."],
 ["subtract", "To cancel most terms, subtract (2) from (1): \\(S_n - AS_n = I - A^{n+1}\\)"],
 ["factorise", "We can factor the left by using the identity matrix \\(I\\): \\((I-A)S_n=I-A^{n+1}\\)."],
 ["inverse", "Assuming that \\(I-A\\) is invertible, then we can left multiply by \\((I-A)^{-1}\\): \\((I-A)^{-1}(I-A)S_n=(I-A)^{-1}(I-A^{n+1})\\)."],
 ["identity", "Since a matrix multiplied by its inverse is the identity: \\(S_n=(I-A)^{-1}(I-A^{n+1})\\)."],
 ["limit", "As \\(n\\) grows, if \\(A^{n+1}\\to 0\\), then \\(I-A^{n+1}\\to I\\) and so \\(S_n\\to (I-A)^{-1}\\)"],
 ["conclude", "Hence \\(I+A+A^2+\\cdots=(I-A)^{-1}\\)."]
];

taProof: proof("define","multiply","subtract", "factorise", "inverse", "identity", "conclude");
proof_steps: random_permutation(proof_steps);]]></text>
    </questionvariables>
