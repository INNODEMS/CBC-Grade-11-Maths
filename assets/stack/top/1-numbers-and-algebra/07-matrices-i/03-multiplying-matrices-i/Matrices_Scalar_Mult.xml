<quiz>
  <question type="stack">
    <name>
      <text>Scalar multiplication of a 2x2 matrix</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Let \({\bf A}\) be the following matrix:</p>
<p>\[{\bf A} = {@amatrix@}\]</p>
<p>Find the scalar multiple \({@sc@}{\bf A}\). Enter exact integers in each cell.</p>
<p>[[input:ans1]] [[validation:ans1]]</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p><b>Worked Solution:</b></p>
<p>To find the scalar multiple \({@sc@}{\bf A}\), multiply each entry of the matrix \({\bf A}\) by the scalar \({@sc@}\):</p>
<p>\[{@sc@}{\bf A} = {@sc@}{@amatrix@} = {@mul_tex@} = \boxed{{@correctanswer@}}\]</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <stackversion>
      <text>2026010500</text>
    </stackversion>
    <questionvariables>
      <text><![CDATA[neg_pos : rand(4) + 1;
a11 : if is(neg_pos = 1) then rand_with_step(-6, -1, 1) else rand_with_prohib(-6, 6, [0]);
a12 : if is(neg_pos = 2) then rand_with_step(-6, -1, 1) else rand_with_prohib(-6, 6, [0]);
a21 : if is(neg_pos = 3) then rand_with_step(-6, -1, 1) else rand_with_prohib(-6, 6, [0]);
a22 : if is(neg_pos = 4) then rand_with_step(-6, -1, 1) else rand_with_prohib(-6, 6, [0]);
amatrix : matrix([a11, a12], [a21, a22]);

sc : rand_with_prohib(-7, 7, [-1, 0, 1]);

correctanswer : sc * amatrix;
wrongsign : -sc * amatrix;
wrongadd : amatrix + matrix([sc, sc], [sc, sc]);
wrongother : amatrix + matrix([1, 1], [1, 1]);
if is(wrongother = correctanswer) or is(wrongother = wrongsign) or is(wrongother = wrongadd) then wrongother : amatrix + matrix([2, 2], [2, 2]);

fmt_mul(k, x) := if is(x < 0) then sconcat(k, " \\times (", x, ")") else sconcat(k, " \\times ", x);
mul_tex : sconcat("\\begin{bmatrix} ", fmt_mul(sc, a11), " & ", fmt_mul(sc, a12), " \\\\ ", fmt_mul(sc, a21), " & ", fmt_mul(sc, a22), " \\end{bmatrix}");]]></text>
    </questionvariables>
    <specificfeedback format="html">
      <text><![CDATA[<p>[[feedback:Result]]</p>]]></text>
    </specificfeedback>
    <questionnote format="html">
      <text>\({\bf A} = {@amatrix@}, \; {@sc@}{\bf A} = {@correctanswer@}\)</text>
    </questionnote>
