    <questionvariables>
      <text>s1 : rand_with_prohib(-3,3,[0]);
s2 : rand_with_prohib(-3,3,[0]);
t  : rand_with_prohib(-2,2,[0]);
r  : rand_with_prohib(-2,2,[t]);
A  : matrix([s1+r*t*s2, r*s2],[t*s2, s2]);
Ai : invert(A);
x1 : rand_with_prohib(-4,4,[0]);
x2 : rand_with_prohib(-4,4,[0]);
xx : matrix([x1],[x2]);
ta1 : ev(A . xx, simp);
ta2 : ev(Ai . ta1, simp);
wrongy : ev(transpose(A) . xx, simp);
wrongx : ev(A . ta1, simp);</text>
    </questionvariables>
