    <questionvariables>
      <text><![CDATA[/* Loop-free selection across millions of unique matrices with distinct entries */
dims : [[2,3], [2,4], [3,2], [3,3], [3,4], [4,2], [4,3], [4,4]];
dim : rand(dims);
m : dim[1];
n : dim[2];

/* Populate MM with distinct integers from -12 to 12 so entries never collide */
pool : random_permutation(makelist(k, k, -12, 12));
MM : genmatrix(lambda([ii, jj], pool[(ii - 1)*n + jj]), m, n);

/* Select 3 distinct off-diagonal positions (i != j) so row/column order is always genuinely tested */
offdiag : sublist(
  create_list([ii, jj], ii, 1, m, jj, 1, n),
  lambda([p], p[1] # p[2])
);
chosen : random_permutation(offdiag);
p1 : chosen[1];
p2 : chosen[2];
p3 : chosen[3];

i1 : p1[1];
j1 : p1[2];
i2 : p2[1];
j2 : p2[2];
i3 : p3[1];
j3 : p3[2];

ta1 : MM[i1, j1];
ta2 : MM[i2, j2];
ta3 : MM[i3, j3];

/* Transpose distractors (strictly distinct from ta_k whenever (j_k, i_k) lies inside A) */
tr1 : if (j1 <= m and i1 <= n) then MM[j1, i1] else ta1 - 1000;
tr2 : if (j2 <= m and i2 <= n) then MM[j2, i2] else ta2 - 1000;
tr3 : if (j3 <= m and i3 <= n) then MM[j3, i3] else ta3 - 1000;]]></text>
    </questionvariables>
