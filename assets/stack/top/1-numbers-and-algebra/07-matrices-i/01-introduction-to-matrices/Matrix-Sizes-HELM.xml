      <text>dims1 : rand([[2,3],[2,4],[2,5],[3,2],[3,4],[3,5],[4,2],[4,3],[4,5],[5,2],[5,3],[5,4]]);
m1 : dims1[1];
n1 : dims1[2];
all_dims2 : [[2,3],[2,4],[2,5],[2,6],[3,2],[3,4],[3,5],[3,6],[4,2],[4,3],[4,5],[4,6],[5,2],[5,3],[5,4],[5,6],[6,2],[6,3],[6,4],[6,5]];
dims2 : rand(delete(dims1, all_dims2));
m2 : dims2[1];
n2 : dims2[2];
mat1 : genmatrix(lambda([ii, jj], rand(10)), m1, n1);
mat2 : genmatrix(lambda([ii, jj], rand(10)), m2, n2);
tamat11 : m1;
tamat12 : n1;
tamat21 : m2;
tamat22 : n2;</text>
