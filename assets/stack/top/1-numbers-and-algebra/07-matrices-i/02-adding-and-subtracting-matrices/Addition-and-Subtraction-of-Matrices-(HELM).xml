    <questionvariables>
      <text><![CDATA[a11 : rand_with_prohib(-5, 8, [0]);
a12 : rand_with_prohib(-5, 8, [0]);
a21 : rand_with_prohib(-5, 8, [0]);
a22 : rand_with_prohib(-5, 8, [0]);
if is(matrix([a11, a12], [a21, a22]) = matrix([2, 2], [2, 2])) then a11 : 3;
mat1 : matrix([a11, a12], [a21, a22]);

b11 : rand_with_prohib(-5, 8, [0, a11, -a11, 3*a11]);
b12 : rand_with_prohib(-5, 8, [0, a12, -a12]);
b21 : rand_with_prohib(-5, 8, [0, a21, -a21]);
b22 : rand_with_prohib(-5, 8, [0, a22, -a22]);
if is(matrix([b11, b12], [b21, b22]) = matrix([2, 2], [2, 2])) then b11 : if is(a11 = 3) then 4 else 3;
mat2 : matrix([b11, b12], [b21, b22]);

ta1 : mat1 + mat2;
ta2 : mat1 - mat2;
ta3 : mat2 - mat1;
ta4 : 2 * mat1;
mat_plus_2 : mat1 + matrix([2, 2], [2, 2]);

/* Clean LaTeX strings for intermediate element-wise steps */
fmt_add(x, y) := if is(y < 0) then sconcat(x, " - ", abs(y)) else sconcat(x, " + ", y);
fmt_sub(x, y) := if is(y < 0) then sconcat(x, " - (", y, ")") else sconcat(x, " - ", y);

sum_tex : sconcat("\\begin{bmatrix} ", fmt_add(a11, b11), " & ", fmt_add(a12, b12), " \\\\ ", fmt_add(a21, b21), " & ", fmt_add(a22, b22), " \\end{bmatrix}");
sub1_tex : sconcat("\\begin{bmatrix} ", fmt_sub(a11, b11), " & ", fmt_sub(a12, b12), " \\\\ ", fmt_sub(a21, b21), " & ", fmt_sub(a22, b22), " \\end{bmatrix}");
sub2_tex : sconcat("\\begin{bmatrix} ", fmt_sub(b11, a11), " & ", fmt_sub(b12, a12), " \\\\ ", fmt_sub(b21, a21), " & ", fmt_sub(b22, a22), " \\end{bmatrix}");
mul_tex : sconcat("\\begin{bmatrix} 2 \\times ", a11, " & 2 \\times ", a12, " \\\\ 2 \\times ", a21, " & 2 \\times ", a22, " \\end{bmatrix}");]]></text>
    </questionvariables>
