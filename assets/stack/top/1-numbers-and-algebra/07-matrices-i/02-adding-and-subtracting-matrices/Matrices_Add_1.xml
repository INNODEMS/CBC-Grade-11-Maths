<quiz>
  <question type="stack">
    <name>
      <text>Addition of two 2x2 matrices</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Let \({\bf A}\) and \({\bf B}\) be the following matrices:</p>
<p>\[{\bf A} = {@matrixa@}, \qquad {\bf B} = {@matrixb@}\]</p>
<p>Find the sum \({\bf A + B}\). Enter exact integers in each cell.</p>
<p>[[input:ans1]] [[validation:ans1]]</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p><b>Worked Solution:</b></p>
<p>To add two matrices of the same order, add the entries in corresponding positions:</p>
<p>\[{\bf A} + {\bf B} = {@matrixa@} + {@matrixb@}\]</p>
<p>\[= \begin{bmatrix} {#t11#} &amp; {#t12#} \\ {#t21#} &amp; {#t22#} \end{bmatrix} = \boxed{{@correctanswer@}}\]</p>]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <stackversion>
      <text>2018080600</text>
    </stackversion>
    <questionvariables>
      <text><![CDATA[a11 : rand_with_prohib(-6, 6, [0]);
a12 : rand_with_prohib(-6, 6, [0]);
a21 : rand_with_prohib(-6, 6, [0]);
a22 : rand_with_prohib(-6, 6, [0]);
matrixa : matrix([a11, a12], [a21, a22]);

neg_pos : rand(4) + 1;
b11 : if is(neg_pos = 1) then rand_with_step(-6, -1, 1) else rand_with_prohib(-6, 6, [0]);
b12 : if is(neg_pos = 2) then rand_with_step(-6, -1, 1) else rand_with_prohib(-6, 6, [0]);
b21 : if is(neg_pos = 3) then rand_with_step(-6, -1, 1) else rand_with_prohib(-6, 6, [0]);
b22 : if is(neg_pos = 4) then rand_with_step(-6, -1, 1) else rand_with_prohib(-6, 6, [0]);
matrixb : matrix([b11, b12], [b21, b22]);

t11 : if is(b11 + abs(b11) = 0) then sconcat(a11, " - ", abs(b11)) else sconcat(a11, " + ", b11);
t12 : if is(b12 + abs(b12) = 0) then sconcat(a12, " - ", abs(b12)) else sconcat(a12, " + ", b12);
t21 : if is(b21 + abs(b21) = 0) then sconcat(a21, " - ", abs(b21)) else sconcat(a21, " + ", b21);
t22 : if is(b22 + abs(b22) = 0) then sconcat(a22, " - ", abs(b22)) else sconcat(a22, " + ", b22);

correctanswer : matrixa + matrixb;
wronganswer : matrixa - matrixb;
wrongother : matrixa + 2*matrixb;]]></text>
    </questionvariables>
