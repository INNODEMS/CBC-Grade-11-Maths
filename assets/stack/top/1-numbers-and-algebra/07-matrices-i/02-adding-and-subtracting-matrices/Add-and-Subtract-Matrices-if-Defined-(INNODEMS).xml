    <questionvariables>
      <text><![CDATA[/* Two distinct shapes; X,W use shape1, Y,Z use shape2. */
shapes : [[2,2],[2,3],[3,2],[3,3]];
s1 : rand(shapes);
s2 : rand(delete(s1, shapes));
r1 : s1[1];
c1 : s1[2];
r2 : s2[1];
c2 : s2[2];

X : genmatrix(lambda([i,j], rand(13)-4), r1, c1);
W : genmatrix(lambda([i,j], rand(13)-4), r1, c1);
Y : genmatrix(lambda([i,j], rand(13)-4), r2, c2);
Z : genmatrix(lambda([i,j], rand(13)-4), r2, c2);
ones1 : genmatrix(lambda([i,j], 1), r1, c1);
ones2 : genmatrix(lambda([i,j], 1), r2, c2);

/* Guard against degenerate zero matrices or identical pairs so all branches stay distinct */
if zeromatrixp(W) then W[1,1] : 1;
if is(X = W) then X[1,1] : X[1,1] + 1;
if zeromatrixp(X + W) then X : X + ones1;

if zeromatrixp(Y) then Y[1,1] : 1;
if zeromatrixp(Z) then Z[1,1] : 1;
if is(Y = Z) then Y[1,1] : Y[1,1] + 1;
if zeromatrixp(Y + Z) then Y[1,1] : Y[1,1] + 1;
if zeromatrixp(Y - Z) then Y : Y + ones2;

/* Model answers */
ansA : X + W;
ansB : zeromatrix(r2, c2);
ansC : Y - Z;
ansD : zeromatrix(r1, c1);

/* Misconception / helper matrices */
YpZ : Y + Z;
XmW : X - W;
ZmY : Z - Y;
genA : ansA + ones1;
if zeromatrixp(genA) or is(genA = XmW) then genA : genA + ones1;
genB : YpZ + ones2;
if zeromatrixp(genB) then genB : genB + ones2;

/* Build clean LaTeX intermediate step matrices without auto-simplification */
join_amp(L) := apply(sconcat, rest(apply(append, makelist([" & ", x], x, L))));
join_nl(L) := apply(sconcat, rest(apply(append, makelist([" \\\\ ", x], x, L))));

rowA_str(i) := join_amp(makelist(
  if is(W[i,j] < 0) then sconcat(X[i,j], " - ", abs(W[i,j])) else sconcat(X[i,j], " + ", W[i,j]),
  j, 1, c1
));
stepA_tex : sconcat("\\begin{bmatrix} ", join_nl(makelist(rowA_str(i), i, 1, r1)), " \\end{bmatrix}");

rowC_str(i) := join_amp(makelist(
  if is(Z[i,j] < 0) then sconcat(Y[i,j], " - (", Z[i,j], ")") else sconcat(Y[i,j], " - ", Z[i,j]),
  j, 1, c2
));
stepC_tex : sconcat("\\begin{bmatrix} ", join_nl(makelist(rowC_str(i), i, 1, r2)), " \\end{bmatrix}");]]></text>
    </questionvariables>
