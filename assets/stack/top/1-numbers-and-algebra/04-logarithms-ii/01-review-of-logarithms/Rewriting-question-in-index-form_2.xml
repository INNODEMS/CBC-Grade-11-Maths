    <questionvariables>
      <text>a: 2 + rand(8);
n: rand(sublist([2,3,4,5], lambda([t], t # a)));   /* n = a would make swapping the base and the exponent give the right answer */
b: a^n;
k: 1 + rand(3);   /* 0.1, 0.01 or 0.001: larger k prints in e-notation */
ta1: a; ta2: n; ta3: b;
ta4: 10; ta5: -k; ta6: 10^(-k);</text>
    </questionvariables>
    <specificfeedback format="html">
