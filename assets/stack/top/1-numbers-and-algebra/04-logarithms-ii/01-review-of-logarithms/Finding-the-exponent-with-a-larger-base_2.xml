B: c^p;
q: rand(sublist(makelist(i,i,1,7), lambda([t], mod(t,p) # 0)));
ta1: q/p;
r: rand(sublist(makelist(i,i,1,4), lambda([t], mod(t,p) # 0 and t # q)));
ta2: -r/p;</text>
    </questionvariables>
