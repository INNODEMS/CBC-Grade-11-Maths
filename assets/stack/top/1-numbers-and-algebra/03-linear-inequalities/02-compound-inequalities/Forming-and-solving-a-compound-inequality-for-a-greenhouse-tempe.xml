/* Temperature Bounds */
L : rand_with_step(12, 16, 1);
U : rand_with_step(24, 29, 1);
H : rand_with_step(8, 12, 1);

/* Target Answers */
ta1 : L - H;
ta2 : U - H;

/* Mistake Catchers */
/* Mistake: Added the heater temp instead of subtracting */
m1_L : L + H;
m1_U : U + H;]]></text>
