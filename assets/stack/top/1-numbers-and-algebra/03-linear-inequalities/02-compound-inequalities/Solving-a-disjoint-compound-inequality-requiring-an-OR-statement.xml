    <questionvariables>
      <text><![CDATA[/* Reverse engineer to ensure clean integer limits */
ta1 : rand_with_step(-2, 3, 1);
ta2 : rand_with_step(5, 10, 1);

/* First Equation: ax - b <= c  => ax <= c+b => x <= ta1 */
a : rand_with_step(2, 5, 1);
b : rand_with_step(1, 8, 1);
c : a * ta1 - b;

/* Second Equation: dx + e > f => dx > f-e => x > ta2 */
d : rand_with_step(2, 5, 1);
e : rand_with_step(1, 8, 1);
f : d * ta2 + e;

/* Mistake Catchers */
m1_ans1 : (c - b) / a; /* subbed instead of added */
m1_ans2 : (f + e) / d; /* added instead of subbed */]]></text>
    </questionvariables>
