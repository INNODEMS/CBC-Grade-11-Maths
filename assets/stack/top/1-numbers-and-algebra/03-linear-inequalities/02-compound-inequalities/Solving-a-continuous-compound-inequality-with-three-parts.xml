    <questionvariables>
      <text><![CDATA[/* Reverse engineer to ensure clean integer limits */
ta1 : rand_with_step(-6, 2, 1);
ta2 : rand_with_step(3, 9, 1);

/* Middle expression coefficients: ax + b */
a : rand_with_step(2, 5, 1);
b_val : rand([-5, -4, -3, -2, -1, 1, 2, 3, 4, 5]);

/* Calculate the outer bounds */
L : a * ta1 + b_val;
U : a * ta2 + b_val;

/* Display helpers for the constant b */
abs_b : abs(b_val);
sign_b : if is(b_val > 0) then "+" else "-";

/* Worked solution helpers */
inv_sign : if is(b_val > 0) then "-" else "+";
op_word : if is(b_val > 0) then "subtracting" else "adding";
prep_word : if is(b_val > 0) then "from" else "to";
L_step1 : L - b_val;
U_step1 : U - b_val;

/* Mistake Catchers */
/* Mistake 1: Added b instead of subtracting (or vice versa) */
m1_L : (L + b_val) / a;
m1_U : (U + b_val) / a;

/* Mistake 2: Handled b correctly, but forgot to divide by a */
m2_L : L_step1;
m2_U : U_step1;]]></text>
    </questionvariables>
