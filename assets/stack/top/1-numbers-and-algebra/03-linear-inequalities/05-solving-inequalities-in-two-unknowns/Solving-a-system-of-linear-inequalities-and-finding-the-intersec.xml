    <questionvariables>
      <text><![CDATA[/* Randomize the intersection point */
x0 : rand_with_step(-4, 4, 1);
y0 : rand_with_step(-4, 4, 1);

/* Randomize distinct slopes */
m1 : rand([-2, -1, 1, 2]);
m2 : rand(listify(setdifference({-3, -2, -1, 1, 2, 3}, {m1})));

/* Calculate y-intercepts to force the intersection at (x0, y0) */
c1 : y0 - m1*x0;
c2 : y0 - m2*x0;

/* Define the algebraic equations */
eq1 : m1*x + c1;
eq2 : m2*x + c2;

/* Target Answers for Part a */
ta1 : x0;
ta2 : y0;

/* Graph Line 1 Targets */
ta3 : [x0, y0];
ta4 : [x0 + 1, y0 + m1];

/* Graph Line 2 Targets */
ta5 : [x0, y0];
ta6 : [x0 + 1, y0 + m2];

/* Safely compute a point inside the feasible region */
dx : if m1 > m2 then 2 else -2;
rx : x0 + dx;
ry : if m1 > m2 then y0 + m1 + m2 else y0 - m1 - m2;

ta7 : [rx, ry];
ta7_wrong : [rx, ry + 15];]]></text>
