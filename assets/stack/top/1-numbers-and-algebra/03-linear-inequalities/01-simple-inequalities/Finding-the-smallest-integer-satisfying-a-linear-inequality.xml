    <questionvariables>
      <text><![CDATA[/* Randomise parameters */
a : rand_with_step(5, 9, 1);
c : rand_with_step(1, 3, 1);
b : rand_with_step(3, 9, 1);
d : rand_with_step(2, 8, 1);

num : d + b;
den : a - c;

/* Ensure the result is a fraction to force the integer rounding logic */
d : if is(mod(num, den) = 0) then d + 1 else d;
num : d + b;

frac : num / den;
disp_dec : dispdp(float(frac), 2);

ta1 : x >= frac;

/* Since it is >=, the smallest integer is the ceiling of the fraction */
ta2 : ceiling(float(frac));

/* Mistake catchers */
wrong_int : floor(float(frac));]]></text>
    </questionvariables>
