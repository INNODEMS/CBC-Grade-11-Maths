    <questionvariables>
      <text><![CDATA[/* Local Context Names */
names : ["Mwakidize", "Nafula", "Kiplagat", "Mutua", "Akinyi"];
fname : rand(names);
items : ["bags of dairy meal", "bags of planting fertilizer", "bags of chick mash"];
item : rand(items);

/* Budget Variables */
budget_temp : rand_with_step(3000, 6000, 100);
transport : rand_with_step(300, 600, 50);
cost : rand_with_step(400, 750, 50);

/* Force the calculation to yield a decimal to test rounding logic */
raw_val : float((budget_temp - transport) / cost);
budget : if is(round(raw_val) = raw_val) then budget_temp + cost/2 else budget_temp;

/* Recalculate with final B */
raw_val : float((budget - transport) / cost);
disp_raw_n : dispdp(raw_val, 2);

/* Target Answers */
ta_num : floor(raw_val);
ta_ineq : transport + cost*n <= budget; 

/* Mistake Catchers */
m1_ineq : cost*n <= budget;    /* Forgot transport cost */
m_up : ceiling(raw_val); /* Rounded UP instead of DOWN, exceeding budget */]]></text>
    </questionvariables>
