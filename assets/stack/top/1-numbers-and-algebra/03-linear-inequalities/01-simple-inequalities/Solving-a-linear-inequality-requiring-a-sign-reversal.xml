    <questionvariables>
      <text><![CDATA[/* Reverse engineer to ensure clean integer answers */
x_val : rand_with_step(-5, 6, 1);

/* We will use a negative coefficient to force the student to flip the inequality sign */
b : rand_with_step(2, 6, 1); 
a : rand_with_step(-8, 12, 1);

/* We want the equation to be a - b * x > c */
c : a - b * x_val;

/* Teacher's exact answer */
ta1 : x < x_val;

/* Mistake Catchers */
/* Mistake 1: Forgot to flip the inequality sign */
mistake_sign : x > x_val;]]></text>
    </questionvariables>
