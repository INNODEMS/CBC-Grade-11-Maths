    <questionvariables>
      <text><![CDATA[/* Dynamically generate variables to yield 14,000+ variants */
R : rand([2, 3, 4, 5, 6, 7, 8]);
y_val : rand_with_step(5, 50, 1);

/* The minimum neem required is R * y_val */
min_neem : R * y_val;

/* Generate a random buffer so the tank isn't perfectly full at the minimum ratio */
buffer : rand_with_step(10, 100, 2);

/* The maximum neem allowed is min_neem + buffer */
max_neem : min_neem + buffer;

/* Reverse-engineer the total tank capacity */
C : max_neem + y_val;

/* Define target answers */
ta1 : x + y <= C;
ta2 : x >= R * y;
ta3 : min_neem;
ta4 : max_neem;

/* Predefine error-catching variants safely to avoid unescaped < > symbols in the XML */
ta1_strict : x + y < C;
ta1_flipped : x + y >= C;

ta2_strict : x > R * y;
ta2_flipped : x <= R * y;]]></text>
    </questionvariables>
