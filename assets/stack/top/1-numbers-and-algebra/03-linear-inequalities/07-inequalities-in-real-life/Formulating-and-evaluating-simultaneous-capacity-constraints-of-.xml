    <questionvariables>
      <text><![CDATA[/* Generate two strictly distinct integer limits to guarantee a clear "bottleneck" */
y1 : rand([5, 6, 7, 8, 9]);
y2 : rand([12, 13, 14, 15, 16]);

/* Randomly assign which resource is the actual bottleneck */
swap : rand([true, false]);
limit_T : if swap then y1 else y2;
limit_L : if swap then y2 else y1;

/* Randomize coefficients independently (Yields 143,000+ variants) */
x0 : rand([10, 12, 14, 15, 16, 18, 20]);
A : rand([2, 3, 4, 5]);
B : rand([2, 3, 4, 5]);
C_coef : rand([2, 3, 4, 5]);
D : rand([2, 3, 4, 5]);

/* Reverse-engineer the capacity totals so the limits calculate back to perfect integers */
W : A*x0 + B*limit_T;
H : C_coef*x0 + D*limit_L;

/* Define target answers */
ta1 : A*x + B*y <= W;
ta2 : C_coef*x + D*y <= H;
ta3 : min(limit_T, limit_L);

/* Define common incorrect responses to catch securely in PRT */
ta1_wrong : A*x + B*y >= W;
ta2_wrong : C_coef*x + D*y >= H;
ta3_wrong : max(limit_T, limit_L);]]></text>
    </questionvariables>
