    <questionvariables>
      <text><![CDATA[/* Use 20 predefined tuples [W, A, B, N] to allow for more deployable variants. */
/* Every tuple guarantees clean division for N/B, and ensures N/B <= W so the serving is physically possible. */
tuples : [
    [100, 3, 5, 360], 
    [120, 2, 6, 300], 
    [150, 4, 5, 400], 
    [100, 2, 8, 320],
    [80,  3, 4, 240],
    [110, 5, 6, 330],
    [130, 3, 5, 450],
    [140, 2, 7, 350],
    [90,  4, 6, 360],
    [160, 5, 8, 480],
    [125, 3, 5, 375],
    [105, 4, 7, 280],
    [115, 2, 5, 250],
    [135, 3, 9, 450],
    [145, 5, 4, 400],
    [95,  2, 4, 200],
    [155, 6, 5, 450],
    [85,  3, 5, 250],
    [100, 4, 8, 320],
    [120, 3, 4, 360]
];
tup : rand(tuples);
W : tup[1];
A : tup[2];
B : tup[3];
N : tup[4];

/* Define target answers */
ta1 : x + y <= W;
ta2 : A*x + B*y >= N;
ta3 : N / B;]]></text>
