    [155, 6, 5, 450],
    [85,  3, 5, 250],
    [100, 4, 8, 320],
    [120, 3, 4, 360]
];
tup : rand(tuples);
W : tup[1];
A : tup[2];
B : tup[3];
N : tup[4];

/* Define target answers */
ta1 : x + y <= W;
ta2 : A*x + B*y >= N;
ta3 : N / B;]]></text>
