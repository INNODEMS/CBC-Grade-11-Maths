    <questionvariables>
      <text><![CDATA[/* Reverse engineer to ensure clean integer answers within the [-6, 6] graph bounds */
bound : rand_with_step(-4, 4, 1);

a : rand_with_step(2, 5, 1); 
b : rand_with_step(1, 8, 1);

/* We want the equation to be a*x + b < c */
c : a * bound + b;

/* Teacher's exact answers */
ta1 : x < bound;
ta2 : [bound, 0]; /* The coordinate of the dragged point on the x-axis */

/* Mistake Catchers for Algebra */
wrong_sign : x > bound;
wrong_c : c + b;
wrong_bound : wrong_c / a;
wrong_op : x < wrong_bound;]]></text>
    </questionvariables>
