    <questionvariables>
      <text>m: rand(2) + 1;
u: rand(3) + 2;
k: rand(3) + 1;
w: 2*u + k;
p: m + u;
q: m + w;
dm: 2*u*(rand(3) + 1);
A: u^2*dm;
dv: k*dm;
tm: A;
tp: A + u*dv;
tq: A + w*dv;
r: tp/tm;
S4: tm*(r^4 - 1)/(r - 1);
tot: ((w+1)/2)*(2*A + w*dv);
c3: ((w+1)/2)*(2*u^2/k + w);

ta1: u^2*d/k;
ta2: dv;
ta3: A;
ta4: r;
ta5: S4;</text>
    </questionvariables>
