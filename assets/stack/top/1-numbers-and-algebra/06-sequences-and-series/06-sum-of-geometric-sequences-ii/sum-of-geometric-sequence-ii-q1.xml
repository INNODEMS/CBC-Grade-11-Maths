    <questionvariables>
      <text>b: rand(2) + 2;
c: rand(7) + 2;
num: rand(6) + 3;
a: c*(b - 1)*b^(num-1);
r: 1/b;

t1: a;
t2: a*r;
t3: a*r^2;

ta1: a/(1 - r);
ta2: a*(1 - r^num)/(1 - r);
ta3: ta1 - ta2;</text>
