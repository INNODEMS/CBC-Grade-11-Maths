    <questionvariables>
      <text>a: rand(3) + 2;
r: rand(3) + 2;
xx: rand(5) + 2;

t1: a;
t2: a*r;
t3: a*r^2;

c1: t1 - xx;
c2: t2 - xx;
c3: t3 - xx;

e1: x + c1;
e2: x + c2;
e3: x + c3;

lhs: expand(e2^2);
rhs: expand(e1*e3);
coef: 2*c2 - c1 - c3;
cons: c2^2 - c1*c3;

k: rand(3) + 6;
cap: a*r^(k-2)*(r+1)/2;
n_exact: float(1 + log(cap/a)/log(r));
n_disp: float(round(n_exact*100)/100);
n_low: k - 1;

ta1: xx;
ta2: r;
ta3: a*r^(n-1);
ta4: k;</text>
    </questionvariables>
