    <questionvariables>
      <text>a: rand(3) + 2;
r: rand(2) + 2;

t1: a;
t2: a*r;
t3: a*r^2;

m: rand(2) + 4;
Sm: a*(r^m - 1)/(r - 1);

k: rand(3) + 5;
target: a*(r^k - 1)/(r - 1);
Rt: r^k;

k2: rand(3) + 8;
j: floor(r^(k2-1)/2);
Rq: r^(k2-1) + j*(r - 1);
cap: a*(Rq - 1)/(r - 1);
n_exact: float(log(Rq)/log(r));
n_disp: float(round(n_exact*100)/100);

ta1: r;
ta2: Sm;
ta3: k;
ta4: k2;</text>
