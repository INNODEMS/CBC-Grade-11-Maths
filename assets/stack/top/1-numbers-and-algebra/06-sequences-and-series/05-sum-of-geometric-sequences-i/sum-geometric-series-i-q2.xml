    <questionvariables>
      <text>a: rand(6) + 4;
r: rand(4) + 3;
p: rand(3) + 2;
q: p + 2;

tp: a*r^(p-1);
tq: a*r^(q-1);
quot: tq/tp;

N: rand(3) + 6;
s: rand(2) + 3;
SN: a*(r^N - 1)/(r - 1);
Ss1: a*(r^(s-1) - 1)/(r - 1);

ta1: r;
ta2: a;
ta3: SN;
ta4: SN - Ss1;</text>
