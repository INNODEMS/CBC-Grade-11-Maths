    <questionvariables>
      <text><![CDATA[/* Randomisation: a pool of three situations for each type of variation.
   Each variant picks two of each type (8 situations) and shuffles their order.
   Item format: [id, situation, type index, hint, worked-solution reason].
   Type index: 1 = direct, 2 = inverse, 3 = joint, 4 = combined. */
poolD : [
  ["D1", "The cost of maize varies with its mass, so doubling the mass doubles the cost.", 1, "How many quantities does the cost depend on here? When the mass doubles, does the cost go up or down?", "The cost \\(C\\) depends on one quantity, the mass \\(m\\), and doubling the mass doubles the cost: \\(C = km\\)."],
  ["D2", "The fuel a generator uses varies with the number of hours it runs.", 1, "How many quantities does the fuel used depend on? If the generator runs for twice as long, what happens to the fuel used?", "The fuel used \\(F\\) depends on one quantity, the number of hours \\(h\\), and running twice as long uses twice the fuel: \\(F = kh\\)."],
  ["D3", "A casual worker's pay varies with the number of hours worked, so working twice as long earns twice as much.", 1, "How many quantities does the pay depend on? If the hours double, what happens to the pay?", "The pay \\(W\\) depends on one quantity, the number of hours \\(h\\), and doubling the hours doubles the pay: \\(W = kh\\)."]
];
poolI : [
  ["I1", "The number of days to dig a trench falls as more workers are added.", 2, "How many quantities affect the number of days? As the number of workers goes up, what happens to the number of days?", "The number of days \\(D\\) depends on one quantity, the number of workers \\(w\\), and more workers means fewer days: \\(D = \\dfrac{k}{w}\\)."],
  ["I2", "For a fixed distance, the faster you travel, the less time the journey takes.", 2, "How many quantities affect the journey time here? As the speed goes up, what happens to the time?", "For a fixed distance, the time \\(t\\) depends on one quantity, the speed \\(s\\), and a higher speed means less time: \\(t = \\dfrac{k}{s}\\)."],
  ["I3", "A fixed harvest of maize is shared equally, so each family's share falls as more families share it.", 2, "How many quantities affect each family's share? As the number of families goes up, what happens to the share?", "Each family's share \\(S\\) depends on one quantity, the number of families \\(n\\), and more families means a smaller share: \\(S = \\dfrac{k}{n}\\)."]
];
poolJ : [
  ["J1", "The cost of painting a wall varies with its length and with its height.", 3, "How many quantities does the cost depend on? Does making either of them bigger make the cost smaller?", "The cost \\(C\\) depends on two quantities, the length \\(l\\) and the height \\(h\\), and increases with both: \\(C = klh\\)."],
  ["J2", "The simple interest earned varies with the principal and with the time.", 3, "How many quantities does the interest depend on? Does making either of them bigger make the interest smaller?", "The interest \\(I\\) depends on two quantities, the principal \\(P\\) and the time \\(t\\), and increases with both: \\(I = kPt\\)."],
  ["J3", "The total cost of school uniforms varies with the number of students and with the price of one uniform.", 3, "How many quantities does the total cost depend on? Does making either of them bigger make the total cost smaller?", "The total cost \\(C\\) depends on two quantities, the number of students \\(n\\) and the price of one uniform \\(p\\), and increases with both: \\(C = knp\\)."]
];
poolC : [
  ["C1", "The fare each matatu passenger pays rises with the distance but falls as more passengers share the cost.", 4, "The fare depends on two quantities. Does it change in the same direction with both of them?", "The fare \\(F\\) increases with the distance \\(d\\) but decreases as the number of passengers \\(n\\) increases: \\(F = \\dfrac{kd}{n}\\)."],
  ["C2", "The time to harvest a tea plot rises with its area but falls as more pickers are added.", 4, "The time depends on two quantities. Does it change in the same direction with both of them?", "The harvest time \\(T\\) increases with the area \\(A\\) but decreases as the number of pickers \\(p\\) increases: \\(T = \\dfrac{kA}{p}\\)."],
  ["C3", "The time to fill a water tank rises with its volume but falls as more taps are opened.", 4, "The time depends on two quantities. Does it change in the same direction with both of them?", "The time \\(t\\) increases with the volume \\(V\\) but decreases as the number of taps \\(n\\) increases: \\(t = \\dfrac{kV}{n}\\)."]
];
items : random_permutation(append(rand_selection(poolD,2), rand_selection(poolI,2), rand_selection(poolJ,2), rand_selection(poolC,2)));
/* Dropdown values and the option list shown for each type. */
keys : [dir, inv, jnt, cmb];
labs : ["Direct", "Inverse", "Joint", "Combined"];
opts : [[dir, false, "Direct variation"], [inv, false, "Inverse variation"], [jnt, false, "Joint variation"], [cmb, false, "Combined variation"]];
optD : [[dir, true, "Direct variation"], opts[2], opts[3], opts[4]];
optI : [opts[1], [inv, true, "Inverse variation"], opts[3], opts[4]];
optJ : [opts[1], opts[2], [jnt, true, "Joint variation"], opts[4]];
optC : [opts[1], opts[2], opts[3], [cmb, true, "Combined variation"]];
optsL : [optD, optI, optJ, optC];
/* Classic confusions, used only in the question tests: direct to inverse, joint to combined. */
cmap : [2, 1, 4, 3];
/* Situation 1 */
st1 : items[1][2];
tc1 : keys[items[1][3]];
ta1 : optsL[items[1][3]];
hint1 : items[1][4];
