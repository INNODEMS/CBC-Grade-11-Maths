aa : pr[1];
bb : pr[2];
cc : pr[3];
ex : aa*x^2+bb*x+cc;
hh : bb/(2*aa);                    /* x^2 + (b/a)x = (x+h)^2 - h^2 */
qq : cc-aa*hh^2;                   /* constant in a(x+h)^2 + q */
cta : aa*(x+hh)^2+qq;
dd : bb^2-4*aa*cc;
ta1 : (-bb+sqrt(dd))/(2*aa);
ta2 : (-bb-sqrt(dd))/(2*aa);
ts : {ta1, ta2};
/* Misconceptions */
w_noa  : aa*(x+hh)^2-hh^2+cc;      /* subtracted h^2 without multiplying by a */
w_sign : aa*(x-hh)^2+qq;           /* the sign error the old version had */
ts_neg : {-ta1, -ta2};
ts_one : {ta1};
ts_wrong : {ta1, ta2+1};]]></text>
