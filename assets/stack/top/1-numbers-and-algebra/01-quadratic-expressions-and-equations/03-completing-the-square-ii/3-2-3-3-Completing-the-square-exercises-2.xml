aa : pr[1];
r1 : pr[2];
mm : pr[3];
ex : expand((x-r1)*(aa*x-mm));
bb : coeff(ex,x,1);
cc : coeff(ex,x,0);
hh : bb/(2*aa);
rhs1 : hh^2-cc/aa;                 /* (x+h)^2 = rhs1, a perfect square of a fraction */
sq : sqrt(rhs1);
ts : [r1, mm/aa];
ts_neg : [-r1, -mm/aa];
ts_one : [r1];
ts_wrong : [r1, mm/aa+1];</text>
