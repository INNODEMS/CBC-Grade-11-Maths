    <questionvariables>
      <text>/* Symbolic derivation: a, b, c stay as free variables (the general result). */
ta1 : -c/a;                       /* Step 1: RHS after moving the constant */
ta2 : b^2/(4*a^2);                /* Step 2: term added to complete the square */
ta3 : (b^2-4*a*c)/(4*a^2);        /* Step 3: simplified RHS as a single fraction */
ta4 : {(-b-sqrt(b^2-4*a*c))/(2*a), (-b+sqrt(b^2-4*a*c))/(2*a)};  /* Step 4: solution set */
/* Common misconceptions, used to give targeted feedback. */
w1_sign   : c/a;                  /* forgot to negate the moved constant */
w2_half   : b/(2*a);              /* took half but forgot to square */
w2_nohalf : (b/a)^2;              /* squared b/a without halving first */
w3_4c     : (b^2-4*c)/(4*a^2);    /* used 4c instead of 4ac in the numerator */
w4_denom  : {(-b+sqrt(b^2-4*a*c)/(2*a)), (-b-sqrt(b^2-4*a*c)/(2*a))};  /* only the root divided by 2a */</text>
    </questionvariables>
