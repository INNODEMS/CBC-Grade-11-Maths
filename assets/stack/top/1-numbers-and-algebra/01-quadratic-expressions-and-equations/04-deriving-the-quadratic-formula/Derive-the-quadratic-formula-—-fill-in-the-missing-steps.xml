    <questionvariables>
      <text>/* Symbolic derivation: a, b, c stay as letters (the general result). Fixed question. */
ta1 : -c/a;                       /* Step 1: right-hand side after moving the constant */
ta2 : b^2/(4*a^2);                /* Step 2: term added to complete the square */
ta3 : (b^2-4*a*c)/(4*a^2);        /* Step 3: right-hand side as a single fraction */
ta4 : {(-b-sqrt(b^2-4*a*c))/(2*a), (-b+sqrt(b^2-4*a*c))/(2*a)};
/* Misconceptions */
w1_sign   : c/a;                  /* did not change the sign of the moved constant */
w2_half   : b/(2*a);              /* halved but did not square */
w2_nohalf : (b/a)^2;              /* squared without halving */
w3_4c     : (b^2-4*c)/(4*a^2);    /* 4c instead of 4ac */
w4_denom  : {-b+sqrt(b^2-4*a*c)/(2*a), -b-sqrt(b^2-4*a*c)/(2*a)};   /* only the root divided by 2a */
w4_one    : {(-b+sqrt(b^2-4*a*c))/(2*a)};</text>
