    <questionvariables>
      <text>r1 : rand_with_prohib(-4,4,[]);
r2 : rand_with_prohib(-4,4,[r1,-r1]);   /* distinct, and r1 + r2 is not 0, so the line is not horizontal */
cc : rand_with_prohib(-5,5,[]);
mm : r1+r2;                             /* slope of the line */
kk : cc-r1*r2;                          /* intercept of the line */
line : mm*x+kk;
para : x^2+cc;
quadexpr : expand(para-line);           /* x^2 - mm*x + r1*r2 = (x-r1)(x-r2) */
xset : {r1, r2};
y1 : ev(line, x=r1);
y2 : ev(line, x=r2);
cpairs : {[r1, y1], [r2, y2]};
/* Misconceptions */
w1_add : expand(para+line);             /* added the line instead of subtracting */
xset_neg : {-r1, -r2};                  /* wrong signs when reading roots from factors */
xset_one : {r1};
xset_wrong : {r1, r2+10};               /* +10 keeps two distinct elements on every seed */
cpairs_swap : {[r1, y2], [r2, y1]};     /* right values, wrong pairing */
cpairs_wrong : {[r1, y1], [r2, y2+1]};</text>
    </questionvariables>
