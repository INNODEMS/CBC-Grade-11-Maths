    <questionvariables>
      <text>ww : rand(7)+3;                    /* width 3..9 */
dd : rand(5)+2;                    /* length is dd more than width */
LL : ww+dd;                        /* length */
AA : ww*LL;                        /* area */
/* Targets for flexible marking of the equations in part (a) */
lin_target  : x-y-dd;              /* x = y + dd */
swap_target : y-x-dd;              /* y = x + dd: length and width swapped */
area_target : x*y-AA;
per_target1 : x+y-AA;              /* confused area with perimeter */
per_target2 : 2*x+2*y-AA;
ta1 : x = y+dd;
ta2 : x*y = AA;
/* Misconception values for part (b) */
negroot : -LL;                     /* negative root of y^2 + dd*y - AA = 0 */</text>
    </questionvariables>
