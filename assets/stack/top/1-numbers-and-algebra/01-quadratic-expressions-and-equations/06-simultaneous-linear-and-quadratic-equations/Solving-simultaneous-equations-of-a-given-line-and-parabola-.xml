kk : if is(mm = -1 and kk = 2*hh) then kk+1 else kk;
line : mm*x+kk;
pp : mm-2*hh;
qq : kk+hh^2-dd;
para : x^2+pp*x+qq;
quadexpr : expand(para-line);       /* x^2 - 2hx + (h^2 - d) */
xset : [hh+sqrt(dd), hh-sqrt(dd)];
yset : [mm*(hh+sqrt(dd))+kk, mm*(hh-sqrt(dd))+kk];
/* Misconceptions */
xset_neg : [-hh+sqrt(dd), -hh-sqrt(dd)];
xset_one : [hh+sqrt(dd)];
yset_x   : xset;                    /* gave the x-values again */
yset_one : [mm*(hh+sqrt(dd))+kk];
/* Order-free versions for marking: students may give the two values in either order. */
xs : setify(xset);
ys : setify(yset);
yset_wrong : [mm*(hh+sqrt(dd))+kk, mm*(hh-sqrt(dd))+kk+1];
xset_wrong : [hh+sqrt(dd), hh-sqrt(dd)+1];]]></text>
