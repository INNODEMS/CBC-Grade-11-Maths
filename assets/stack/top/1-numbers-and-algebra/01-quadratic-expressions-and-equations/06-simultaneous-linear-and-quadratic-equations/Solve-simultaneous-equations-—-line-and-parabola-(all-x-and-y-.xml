    <questionvariables>
      <text>r1 : rand_with_prohib(-4,4,[]);
r2 : rand_with_prohib(-4,4,[r1,-r1]);   /* distinct and not the negative of r1 */
cc : rand_with_prohib(-5,5,[]);         /* parabola constant */
mm : r1 + r2;                           /* line slope */
kk : cc - r1*r2;                        /* line intercept */
line : mm*x + kk;                       /* RHS of y = line */
para : x^2 + cc;                        /* RHS of y = parabola */
quadexpr : expand(para - line);         /* x^2 - mm*x + r1*r2 = (x-r1)(x-r2) */
xset : {r1, r2};
xset_neg : {-r1, -r2};                  /* sign-of-roots misconception */
y1 : ev(line, x=r1);
y2 : ev(line, x=r2);
yset : {y1, y2};</text>
    </questionvariables>
