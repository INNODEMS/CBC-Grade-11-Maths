    <questionvariables>
      <text><![CDATA[aa : rand(8)+2;              /* a in 2..9; a=7 gives x^2-14x+49 */
expr : x^2 - 2*aa*x + aa^2;   /* always the perfect square (x-a)^2 */
/* Part (a): dropdown model answer [value, correct, display]. Always "Yes". */
ta1 : [[optyes, true, "Yes, it is a perfect-square trinomial."], [optno, false, "No, it is not a perfect-square trinomial."]];
/* Part (b): the completed square (expression to the left of = 0). */
ta2 : (x-aa)^2;
w2_sign  : (x+aa)^2;          /* wrong sign: used (x+a) */
w2_const : (x-aa^2)^2;        /* used the constant term as a */
/* Part (c): the repeated root. */
ta3 : aa;
w3_neg : -aa;                 /* sign slip */
w3_two : {aa, -aa};           /* treated it as two distinct roots */]]></text>
    </questionvariables>
