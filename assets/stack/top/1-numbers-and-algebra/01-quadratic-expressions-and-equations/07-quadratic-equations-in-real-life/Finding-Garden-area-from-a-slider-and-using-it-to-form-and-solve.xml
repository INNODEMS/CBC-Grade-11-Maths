    <questionvariables>
      <text>dd : rand_with_prohib(2,5,[]);   /* length is dd m longer than width */
xstart : 4;                      /* initial slider width (an example, not an answer) */
wex : xstart;                    /* example width for the displayed worked solution */
Aex : wex*(wex+dd);              /* example area */
/* Example model answers (display only; real marking uses the slider value ans0). */
tans1 : x^2 + dd*x - Aex;
tans2 : wex;
tans3 : wex + dd;</text>
