    <questionvariables>
      <text>/* 9 x 10 - 3 (where b = 2*a) = 87 unique non-colliding variants */
a : rand([2, 3, 4, 5, 6, 7, 8, 9, 10]);
c : 2 * a;
b : rand_with_prohib(2, 15, [4, 8, 9, 12, c]);

a_sq : a^2;
n : a_sq * b;

/* Correct doubled and simplified length */
ta1 : c * sqrt(b);

/* Distractors for targeted PRT feedback */
ta_forgot_double : a * sqrt(b);
ta_inside_double : sqrt(2 * n);</text>
