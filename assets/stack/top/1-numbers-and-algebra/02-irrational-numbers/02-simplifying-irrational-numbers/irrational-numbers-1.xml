    </stackversion>
    <questionvariables>
      <text>/* Perfect square factors to choose from */
squares: [4,9,16,25];
a: squares[rand(length(squares))+1];

/* Square-free number (2-7, excluding 4) to multiply with */
b: rand(6)+2;
while member(b, [4]) do b: rand(6)+2;

/* The number the student is asked to simplify */
number: a * b;

/* Correct fully-simplified answer, e.g. sqrt(16)*sqrt(3) = 4*sqrt(3) */
ta1: sqrt(a) * sqrt(b);

ta2: sqrt(b) * a;</text>
