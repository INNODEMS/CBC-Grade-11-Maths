    <questionvariables>
      <text>/* 9 perfect squares x 10 square-free integers = 90 unique non-colliding variants */
root_a : rand([2, 3, 4, 5, 6, 7, 8, 9, 10]);
a : root_a^2;

b : rand([2, 3, 5, 6, 7, 10, 11, 13, 14, 15]);

/* The number the student is asked to simplify */
number : a * b;

/* Correct fully-simplified answer, e.g. sqrt(16)*sqrt(3) = 4*sqrt(3) */
ta1 : root_a * sqrt(b);

/* Distractors for targeted PRT feedback */
ta2 : a * sqrt(b);
ta3 : root_a * b;</text>
