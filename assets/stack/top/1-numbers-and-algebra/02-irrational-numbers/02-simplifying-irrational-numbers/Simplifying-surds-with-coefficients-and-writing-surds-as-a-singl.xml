    <questionvariables>
      <text><![CDATA[/* Part (a): 4 x 5 x 7 = 140 combinations */
k : rand([3, 4, 5, 6]);
a : rand([2, 3, 4, 5, 6]);
b : rand([2, 3, 5, 6, 7, 10, 11]);
a_sq : a^2;
n1 : a_sq * b;
ka : k * a;
ta1 : ka * sqrt(b);

/* Part (a) distractors */
ta1_add : (k + a) * sqrt(b);
ta1_no_k : a * sqrt(b);
ta1_no_root : ka * b;

/* Part (b): 8 x 7 = 56 combinations (total > 7,800 non-colliding variants) */
p : rand([2, 3, 4, 5, 6, 7, 8, 9]);
q : rand_with_prohib(2, 13, [4, 8, 9, 12, p]);
p_sq : p^2;
ta2 : p_sq * q;

/* Part (b) distractors (strictly distinct across 100% of seeds) */
ta2_no_sq : p * q;
ta2_sq_q : p * q^2;
ta2_add : p_sq + q;]]></text>
    </questionvariables>
