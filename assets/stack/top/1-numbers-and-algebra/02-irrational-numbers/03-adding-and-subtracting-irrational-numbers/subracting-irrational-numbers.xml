    <questionvariables>
      <text>/* 15 square-free radicands x 20 valid pairs (a, b) = 300 unique non-colliding variants */
n : rand([2, 3, 5, 6, 7, 10, 11, 13, 14, 15, 17, 19, 21, 22, 23]);
a : rand([5, 6, 7, 8, 9]);
b : rand_with_prohib(2, a - 2, []);

a2 : a^2;
b2 : b^2;
x : a2 * n;
y : b2 * n;
c : a - b;

/* Correct fully simplified answer */
ta1 : c * sqrt(n);

/* Distractors for targeted PRT feedback */
diffxy : x - y;
w1 : sqrt(diffxy);
w2 : (a + b) * sqrt(n);
w3 : (b - a) * sqrt(n);
w4 : c * n;</text>
    </questionvariables>
