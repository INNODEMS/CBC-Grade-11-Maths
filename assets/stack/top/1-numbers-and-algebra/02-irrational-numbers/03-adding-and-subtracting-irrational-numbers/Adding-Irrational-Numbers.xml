    <questionvariables>
      <text>/* 15 square-free radicands x 5 x 4 distinct square factors = 300 unique non-colliding variants */
n : rand([2, 3, 5, 6, 7, 10, 11, 13, 14, 15, 17, 19, 21, 22, 23]);
a : rand([2, 3, 4, 5, 6]);
b : rand_with_prohib(2, 6, [a]);

a2 : a^2;
b2 : b^2;
x : a2 * n;
y : b2 * n;
c : a + b;

/* Correct fully simplified answer */
ta1 : c * sqrt(n);

/* Distractors for targeted PRT feedback */
sumxy : x + y;
w1 : sqrt(sumxy);
w2 : c * sqrt(2 * n);
w3 : abs(a - b) * sqrt(n);
w4 : c * n;</text>
    </questionvariables>
