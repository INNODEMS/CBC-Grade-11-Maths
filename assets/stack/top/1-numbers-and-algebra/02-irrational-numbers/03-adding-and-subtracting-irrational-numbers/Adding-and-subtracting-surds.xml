    <questionvariables>
      <text><![CDATA[/* 15 x 4 x 3 x 6 x 6 x 2 = 12,960 unique non-colliding variants */
plist : [2, 3, 5, 6, 7, 10, 11, 13, 14, 15, 17, 19, 21, 22, 23];
p : rand(plist);

a1 : rand([2, 3, 4, 5]);
a2 : rand_with_prohib(2, 5, [a1]);
a1_sq : a1^2;
a2_sq : a2^2;

A : rand([2, 3, 4, 5, 6, 7]);
Bmag : rand([2, 3, 4, 5, 6, 7]);
sgn : rand([-1, 1]);

/* Deterministic guard ensuring coeff != 0 and all distractors stay strictly distinct */
if (A*a1 + sgn*Bmag*a2 = 0) or (A*(a1 - 1) + sgn*Bmag*(a2 - 1) = 0) or (a1 + sgn*a2 = A*a1 + sgn*Bmag*a2) then A : A + 2;

m1 : a1_sq * p;
m2 : a2_sq * p;
term1 : A * a1;
term2 : Bmag * a2;
coeff : term1 + sgn * term2;
signchar : if sgn = 1 then "+" else "-";

/* Distractors for prt1 (coefficient a) */
ta1_wrong_sign : term1 - sgn * term2;
ta1_no_simp : A + sgn * Bmag;
ta1_no_coeff : a1 + sgn * a2;

/* Distractors for prt2 (radicand b) */
ta2_comb_rad : m1 + sgn * m2;
ta2_sqrt : sqrt(p);]]></text>
    </questionvariables>
