      <text><![CDATA[plist: [2,3,5,6,7,10,11,13,14,15,17,19,21,22,23];
p: plist[1+rand(length(plist))];
a1: 1+rand(4);
a2: 1+rand(4);
while a2=a1 do a2: 1+rand(4);
A: 1+rand(6);
Bmag: 1+rand(6);
sgn: if rand(2)=0 then 1 else -1;
m1: a1^2*p;
m2: a2^2*p;
coeff: A*a1 + sgn*Bmag*a2;
while coeff=0 do (
  sgn: if rand(2)=0 then 1 else -1,
  Bmag: 1+rand(6),
  coeff: A*a1 + sgn*Bmag*a2
);
signchar: if sgn=1 then "+" else "-";]]></text>
