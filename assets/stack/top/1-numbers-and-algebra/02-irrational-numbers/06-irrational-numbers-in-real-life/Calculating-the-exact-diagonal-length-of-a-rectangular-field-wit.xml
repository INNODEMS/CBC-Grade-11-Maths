    <questionvariables>
      <text><![CDATA[/* Loop-free selection across 300+ unique non-colliding variants */
T : [
  [3, 4, 5], [4, 3, 5],
  [5, 12, 13], [12, 5, 13],
  [6, 8, 10], [8, 6, 10],
  [8, 15, 17], [15, 8, 17],
  [7, 24, 25], [24, 7, 25],
  [9, 12, 15], [12, 9, 15],
  [12, 16, 20], [16, 12, 20],
  [9, 40, 41], [40, 9, 41],
  [20, 21, 29], [21, 20, 29]
];
triple : rand(T);
a : triple[1];
b : triple[2];
c : triple[3];

/* Require gcd(c, n) = 1 so Maxima never collapses c*sqrt(n) into fractional exponents */
S : [2, 3, 5, 6, 7, 10, 11, 13, 14, 15, 17, 19, 21, 22, 23, 26, 29, 30];
nlist : sublist(S, lambda([x], gcd(c, x) = 1));
n : rand(nlist);

/* Guard so the prompt example 15*sqrt(11) never leaks a live answer */
if (c = 15 and n = 11) then n : 7;

a2 : a^2;
b2 : b^2;
c2 : c^2;
a2n : a2 * n;
b2n : b2 * n;
d2 : c2 * n;

/* Correct simplified diagonal length in k*sqrt(m) form */
ta1 : c * sqrt(n);

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds: 0 < w2 < ta1 < w1 and 0 < w4 < w3) */
w1 : (a + b) * sqrt(n);
w2 : sqrt((a + b) * n);
w3 : d2;
w4 : c;]]></text>
