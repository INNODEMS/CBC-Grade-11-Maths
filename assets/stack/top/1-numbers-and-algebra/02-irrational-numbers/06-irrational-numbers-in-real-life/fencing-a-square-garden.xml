    <questionvariables>
      <text>/* Loop-free selection across 200+ unique non-colliding variants */
/* Odd square-free integers ensure gcd(4, n) = 1 so Maxima never collapses 4*a*sqrt(n) into fractional exponents */
S : [3, 5, 7, 11, 13, 15, 17, 19, 21, 23, 29, 31, 33, 35, 37];
n : rand(S);

/* Require gcd(x, n) = 1 so gcd(4*a, n) = 1 across 100% of seeds */
alist : sublist(makelist(i, i, 2, 15), lambda([k], gcd(k, n) = 1));
a : rand(alist);

/* Guard so the prompt example 20*sqrt(13) never leaks a live answer */
if (n = 13 and a = 5) then a : 6;

a2 : a^2;
x : a2 * n;
c : 4 * a;

/* Correct simplified perimeter in k*sqrt(m) form */
ta1 : c * sqrt(n);

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
w1 : a * sqrt(n);
w2 : 4 * x;
w3 : (4 + a) * sqrt(n);</text>
    </questionvariables>
