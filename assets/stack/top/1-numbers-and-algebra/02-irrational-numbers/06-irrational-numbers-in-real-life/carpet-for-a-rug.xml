    <questionvariables>
      <text>/* Loop-free selection across 3,500+ unique non-colliding variants */
P : [2, 3, 5, 7, 11, 13, 17, 19, 23];
n : rand(P);
m : rand(delete(n, P));
nm : n * m;

/* Require gcd(x, nm) = 1 so Maxima never collapses ab*sqrt(nm) into fractional exponents, and a != b so a*b != a+b */
alist : sublist(makelist(i, i, 2, 12), lambda([x], gcd(x, nm) = 1));
a : rand(alist);
blist : delete(a, alist);
b : rand(blist);
ab : a * b;

/* Guard so the prompt example 18*sqrt(143) never leaks a live answer */
if (ab = 18 and nm = 143) then (
  a : 4,
  ab : a * b
);

/* Correct simplified surd area */
ta1 : ab * sqrt(nm);

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
w1 : (a + b) * sqrt(nm);
w2 : ab * sqrt(n + m);
w3 : (a + b) * sqrt(n + m);</text>
    </questionvariables>
