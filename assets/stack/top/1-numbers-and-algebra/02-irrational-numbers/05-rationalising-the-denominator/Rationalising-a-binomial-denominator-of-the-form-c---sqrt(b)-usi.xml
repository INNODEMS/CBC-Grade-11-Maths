    <questionvariables>
      <text><![CDATA[/* Loop-free selection across 1,100+ unique non-colliding variants (17 excluded so example never leaks) */
S : [2, 3, 5, 6, 7, 10, 11, 13, 14, 15, 19, 21, 22, 23];
b : rand(S);

/* Ensure c^2 - b >= 2 and c != b so all denominators stay strictly positive and distinct */
clist : sublist([2, 3, 4, 5, 6, 7, 8], lambda([x], (x^2 - b >= 2) and (x # b)));
c : rand(clist);
c2 : c^2;

p : rand(makelist(i, i, 2, 16));

d : c2 - b;
g : gcd(p, d);
p_red : p / g;
d_red : d / g;

/* Accepted simplified forms (factored and expanded) */
ta1 : (p_red * (c + sqrt(b))) / d_red;
ta1_exp1 : expand(p_red * (c + sqrt(b))) / d_red;
ta1_exp2 : expand(ta1);

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
w1 : (p * (c - sqrt(b))) / (c2 - b);
w2 : (p * (c + sqrt(b))) / (c - b);
w3 : (p * (c + sqrt(b))) / (c2 + b);
w4 : (p * (c + sqrt(b))) / (b - c2);
w5 : p / d;]]></text>
    </questionvariables>
