      <text>p: rand(8)+2;

sf_options: [2,3,5,6,7,10,11,13,14,15];

a: sf_options[rand(length(sf_options))+1];

b: sf_options[rand(length(sf_options))+1];
while b = a do b: sf_options[rand(length(sf_options))+1];

denom_original: sqrt(a) + sqrt(b);
conjugate: sqrt(a) - sqrt(b);

new_denom: a - b;
ta1: (p*(sqrt(a)-sqrt(b))) / (a-b);

ta2: (p*(sqrt(a)+sqrt(b))) / (a+b);

ta3: (p*(sqrt(a)-sqrt(b))) / (b-a);</text>
