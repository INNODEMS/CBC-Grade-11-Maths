    <questionvariables>
      <text>/* Loop-free selection across 600+ unique non-colliding combinations */
S : [2, 3, 5, 6, 7, 10, 11, 13, 14, 15, 17, 19, 21, 23];
n : rand(S);
/* Ensure q != n so distractors w1 and w2 never collide */
q : rand(delete(n, [2, 3, 4, 5, 6, 7, 8]));

/* Ensure gcd(k, n) = 1 so Maxima never collapses k*sqrt(n) into fractional exponents */
klist : sublist(makelist(i, i, 2, 12), lambda([x], gcd(x, n) = 1));
k : rand(klist);
/* Prevent the prompt example 9*sqrt(11) from appearing as a live answer */
if (n = 11 and k = 9) then k : 8;

qn : q * n;
p : k * qn;

/* Correct rationalised and simplified answer */
ta1 : k * sqrt(n);

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
w1 : (k * q) * sqrt(n);
w2 : (k * n) * sqrt(n);
w3 : k * n;</text>
    </questionvariables>
