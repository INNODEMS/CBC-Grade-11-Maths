    <questionvariables>
      <text><![CDATA[/* Over 5,000 unique non-colliding variants */
nlist : [2, 3, 5, 6, 7, 10, 11, 13, 14, 15];
mlist : [2, 3, 5, 7, 11, 13];

n : rand(nlist);
m : rand(mlist);
while gcd(n, m) > 1 do m : rand(mlist);

q : rand(makelist(i, i, 2, 10));
r : rand(makelist(i, i, 3, 20));
/* Ensure gcd(r, n) = 1 so Maxima never collapses r*sqrt(n) into fractional exponents like 2^(9/2) */
while gcd(r, n) > 1 do r : rand(makelist(i, i, 3, 20));

p : q * r;
nm : n * m;

/* Correct simplified surd answer */
ta1 : r * sqrt(n);

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
w1 : r * sqrt(nm - m);
w2 : (p - q) * sqrt(n);
w3 : p * sqrt(n);
w4 : r * n;]]></text>
    </questionvariables>
