    <questionvariables>
      <text>/* Loop-free selection across 50,000+ unique non-colliding combinations */
P : [2, 3, 5, 7, 11, 13, 17, 19];
n : rand(P);
m : rand(delete(n, P));

c : rand([2, 3, 4, 5, 6, 7, 8, 9]);

/* Require b != c and gcd(b, n) = 1 so blist and klist are never empty */
blist : sublist(delete(c, makelist(i, i, 2, 20)), lambda([x], gcd(x, n) = 1));
b : rand(blist);

/* Ensure gcd(k, n) = 1 so Maxima never collapses e*sqrt(n) into fractional exponents */
klist : sublist(makelist(i, i, 2, 12), lambda([x], gcd(x, n) = 1));
k : rand(klist);

a : c * k;
ab : a * b;
nm : n * m;
e : k * b;

/* Correct simplified surd answer */
ta1 : e * sqrt(n);

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
w1 : ab * sqrt(n);
w2 : (a + b - c) * sqrt(n);
w3 : e * sqrt(nm);
w4 : e * n;</text>
    </questionvariables>
