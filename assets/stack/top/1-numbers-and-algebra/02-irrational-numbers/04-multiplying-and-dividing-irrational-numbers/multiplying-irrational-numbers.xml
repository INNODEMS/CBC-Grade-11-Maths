    <questionvariables>
      <text><![CDATA[/* Over 18,000 unique non-colliding variants */
P : [2, 3, 5, 7, 11, 13, 17, 19, 23];
n : rand(P);
m : rand(delete(n, P));
nm : n * m;

clist : makelist(i, i, 2, 20);
a : rand(clist);
/* Ensure gcd(a, nm) = 1 so Maxima never converts ab*sqrt(nm) into fractional powers */
while gcd(a, nm) > 1 do a : rand(clist);

b : rand(clist);
/* Ensure gcd(b, nm) = 1 and avoid a = b = 2 so a + b != a*b */
while (gcd(b, nm) > 1) or (a = 2 and b = 2) do b : rand(clist);

ab : a * b;

/* Correct simplified surd answer */
ta1 : ab * sqrt(nm);

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
w1 : (a + b) * sqrt(nm);
w2 : ab * sqrt(n + m);
w3 : sqrt(ab * nm);
w4 : ab * nm;]]></text>
    </questionvariables>
