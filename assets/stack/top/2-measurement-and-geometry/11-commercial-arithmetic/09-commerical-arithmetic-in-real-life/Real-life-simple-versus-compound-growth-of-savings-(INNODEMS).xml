P0 : 1000*rand([10, 15, 20, 25, 40, 50]);
R0 : rand([5, 6, 8, 10, 12]);
T0 : rand([3, 4, 5, 6]);
As : P0*(1 + R0*T0/100);
Ac : P0*(1 + R0/100)^T0;
