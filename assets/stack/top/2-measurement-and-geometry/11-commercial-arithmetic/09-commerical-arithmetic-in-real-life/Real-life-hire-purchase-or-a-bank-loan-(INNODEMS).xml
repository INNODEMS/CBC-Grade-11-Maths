    <questionvariables>
      <text><![CDATA[nm : rand(["Mr. Barasa", "Ms. Njeri", "Mr. Mwangi", "Ms. Atieno", "Mr. Kiprop", "Ms. Wambui"]);
r2(v) := if integerp(round(100*v)/100) then round(v) else float(round(100*v)/100);
item : rand(["motorcycle", "laptop", "posho mill", "solar water heater"]);
cands : sublist(create_list([u1, u2, u3, u4, u5], u1, [60000, 80000, 100000, 120000], u2, [20, 25], u3, [12, 18, 24, 30], u4, [10, 12, 15], u5, [2]),
  lambda([z], block([h, l], h : z[1]*(1 + z[3]/100), l : z[1]*(1 + z[4]/100)^z[5],
     is(integerp((h - z[1]*z[2]/100)/(12*z[5])) and abs(h - l) > 1000))));
pk : rand(cands);
C0 : pk[1];
D0 : C0*pk[2]/100;
R0 : pk[4];
T0 : pk[5];
n0 : 12*T0;
H0 : C0*(1 + pk[3]/100);
x0 : (H0 - D0)/n0;
L0 : C0*(1 + R0/100)^T0;
ta3 : if H0 < L0 then 1 else 2;
cheapw : if H0 < L0 then "hire purchase option" else "bank loan";
opts3 : [[1, is(ta3 = 1), "Hire purchase"], [2, is(ta3 = 2), "Bank loan"]];]]></text>
    </questionvariables>
