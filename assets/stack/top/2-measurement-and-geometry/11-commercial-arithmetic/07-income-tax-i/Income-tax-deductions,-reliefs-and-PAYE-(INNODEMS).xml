    <questionvariables>
      <text><![CDATA[nm : rand(["Mr. Barasa", "Ms. Njeri", "Mr. Mwangi", "Ms. Atieno", "Mr. Kiprop", "Ms. Wambui"]);
r2(v) := if integerp(round(100*v)/100) then round(v) else float(round(100*v)/100);
r0 : rand([15, 20, 25]);
TI : 1000*rand([36, 42, 48, 55, 64, 72, 85]);
ir : rand([300, 450, 600, 750]);
gt : TI*r0/100;
paye : gt - 2400 - ir;
w_asded : (TI - 2400 - ir)*r0/100;        /* treated reliefs as deductions */
w_personal : gt - 2400;                   /* forgot the insurance relief */
w_added : gt + 2400 + ir;                 /* added the reliefs */]]></text>
    </questionvariables>
