R0 : rand([5, 10, 15, 20, 25]);
T0 : rand([2, 3]);
/* Prices chosen so that the value after T years is a whole number of shillings. */
P0 : if T0 = 2 then 40000*rand([2, 3, 4, 5, 8, 10]) else 8000*rand([10, 15, 20, 25, 50]);
A0 : P0*(1 - R0/100)^T0;
totp : 100*(P0 - A0)/P0;
w_avg : totp/T0;]]></text>
