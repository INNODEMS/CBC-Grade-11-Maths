T0 : pr[2];
P0 : rand([120000, 250000, 400000, 800000, 1500000]);
V1 : P0*(1 - R0/100);
A0 : P0*(1 - R0/100)^T0;
w_line : P0*(1 - R0*T0/100);             /* the same amount lost every year */
w_app  : P0*(1 + R0/100)^T0;             /* appreciation formula */]]></text>
