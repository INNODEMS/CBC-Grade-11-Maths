    <questionvariables>
      <text><![CDATA[nm : rand(["Mr. Barasa", "Ms. Njeri", "Mr. Mwangi", "Ms. Atieno", "Mr. Kiprop", "Ms. Wambui"]);
r2(v) := if integerp(round(100*v)/100) then round(v) else float(round(100*v)/100);
b1 : 24000;
b2 : 8333;
taxf(ti) := (1/10)*min(ti, b1) + (1/4)*max(0, min(ti, b1 + b2) - b1) + (3/10)*max(0, ti - b1 - b2);
B0 : 1000*rand([60, 80, 100, 120, 150]);
hb : 15*B0/100;
Ta : 1000*rand([5, 8, 10, 12]);
Pn : 1000*rand([3, 4, 5, 6]);
Md : 1000*rand([1, 2, 3]);
TI : B0 + hb + Ta - Pn - Md;
gt : taxf(TI);
paye : gt - 2400;
w_nohb : B0 + Ta - Pn - Md;               /* left out the housing benefit */
w_hbG  : B0 + 15*(B0 + Ta)/100 + Ta - Pn - Md;  /* 15% of basic + allowance */
w_nodd : B0 + hb + Ta;                    /* forgot the deductions */]]></text>
