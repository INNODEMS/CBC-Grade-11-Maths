    <questionvariables>
      <text><![CDATA[nm : rand(["Esther", "Kelvin", "Wanjiru", "Otieno", "Achieng", "Kiprono", "Amina", "Mutua"]);
r2(v) := if integerp(round(100*v)/100) then round(v) else float(round(100*v)/100);
P0 : rand([20000, 50000, 80000, 100000, 150000, 250000]);
R0 : rand([5, 6, 8, 10, 12]);
T0 : rand([2, 3, 4, 5]);
A0 : P0*(1 + R0/100)^T0;
ci : A0 - P0;
w_simple : P0*(1 + R0*T0/100);           /* simple interest amount */
w_times  : P0*(1 + R0/100)*T0;           /* multiplied by T instead of raising to the power T */
w_rnot100: P0*(1 + R0)^T0;               /* forgot to divide R by 100 */]]></text>
