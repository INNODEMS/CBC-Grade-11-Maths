R0 : rand([5, 8, 10, 12, 15, 20]);
T0 : rand([2, 3]);
P0 : if T0 = 2 then 10000*rand([30, 45, 60, 80, 120]) else 1000000*rand([2, 3, 4, 5]);
A0 : P0*(1 + R0/100)^T0;
totp : 100*(A0 - P0)/P0;
w_avg : totp/T0;                          /* shared the total % equally between the years */]]></text>
