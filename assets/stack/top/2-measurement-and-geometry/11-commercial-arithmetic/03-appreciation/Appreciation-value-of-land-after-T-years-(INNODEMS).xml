R0 : rand([6, 8, 10, 12, 15]);
T0 : rand([3, 4, 5, 6, 8]);
A0 : P0*(1 + R0/100)^T0;
w_simple : P0*(1 + R0*T0/100);           /* same increase every year */
w_dep    : P0*(1 - R0/100)^T0;           /* used the depreciation formula */]]></text>
