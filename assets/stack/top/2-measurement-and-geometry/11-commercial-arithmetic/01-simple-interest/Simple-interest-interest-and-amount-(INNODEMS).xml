R0 : rand([3, 4, 5, 6, 8, 9, 10, 12]);
T0 : rand([2, 3, 4, 5, 6]);
si : P0*R0*T0/100;                       /* model answer (a) */
A0 : P0 + si;                            /* model answer (b) */
w_nodiv  : P0*R0*T0;                     /* forgot to divide by 100 */
w_oneyr  : P0*R0/100;                    /* interest for one year only */
w_comp   : float(P0*(1 + R0/100)^T0 - P0);  /* used compound interest */]]></text>
