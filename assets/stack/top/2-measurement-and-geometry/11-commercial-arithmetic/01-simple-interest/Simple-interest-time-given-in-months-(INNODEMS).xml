R0 : rand([3/2, 2, 5/2, 3, 9/2, 6, 15/2]);
m0 : rand([3, 4, 6, 8, 9, 10]);
T0 : m0/12;
si : P0*R0*T0/100;
w_years : P0*R0*m0/100;                  /* used the months as years */]]></text>
