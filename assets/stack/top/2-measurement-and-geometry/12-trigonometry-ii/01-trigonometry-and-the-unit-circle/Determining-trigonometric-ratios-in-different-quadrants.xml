    <questionvariables>
      <text>/* Select a reference angle */
ref_index: rand(3);
ref_list: [30,45,60];
ref_angle: ref_list[ref_index+1];

/* Randomly select the second or third quadrant */
quadrant: 2 + rand(2);

/* Construct the angle */
theta: if quadrant=2 then 180-ref_angle
       else 180+ref_angle;

/* Calculate exact trigonometric ratios */
sin_theta: sin(theta*%pi/180);
cos_theta: cos(theta*%pi/180);
</text>
