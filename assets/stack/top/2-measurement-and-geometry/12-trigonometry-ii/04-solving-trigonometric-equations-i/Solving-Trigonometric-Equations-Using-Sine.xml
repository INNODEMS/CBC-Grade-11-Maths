    <questionvariables>
      <text>/* Randomly select the magnitude of the sine value */
k: 3+rand(6);

/* Given sine value */
given_value: -k/10;

/* Calculate the reference angle */
alpha_exact: asin(abs(given_value))*180/%pi;

/* Reference angle rounded to 1 decimal place */
ta0: round(alpha_exact*10)/10;

/* Calculate the two solutions */
theta1_exact: 180+alpha_exact;
theta2_exact: 360-alpha_exact;

/* Round solutions to 1 decimal place */
ta1: round(theta1_exact*10)/10;
ta2: round(theta2_exact*10)/10;</text>
