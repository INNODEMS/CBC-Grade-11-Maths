    var P = b.create('point', [px, py], {name:'P' + (i + 1), fixed:true, size:4, color:cols[i],
        label:{offset:[px > 0 ? 10 : -26, py > 0 ? 14 : -16]}});
    b.create('segment', [O, P], {strokeColor:cols[i], strokeWidth:2, fixed:true});
    b.create('angle', [A, O, P], {radius:rad[i], name:t + '°', fillColor:cols[i], strokeColor:cols[i], fillOpacity:0.12, fixed:true, label:{color:cols[i]}});
  });
