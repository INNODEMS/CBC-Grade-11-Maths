  var O = b.create('point', [0, 0], {name:'O', fixed:true, size:2, color:'#222', label:{offset:[-14, k > 0 ? -12 : 10]}});
  b.create('circle', [O, 1], {strokeColor:'#1565c0', strokeWidth:2, fixed:true, highlight:false});
  var A = b.create('point', [1, 0], {visible:false, fixed:true});
  b.create('segment', [[-1.3, k], [1.3, k]], {strokeColor:'#ef6c00', strokeWidth:2, dash:2, fixed:true});
  var cols = ['#c62828', '#6a1b9a'], rad = [0.22, 0.38];
  [x1, x2].forEach(function(t, i) {
