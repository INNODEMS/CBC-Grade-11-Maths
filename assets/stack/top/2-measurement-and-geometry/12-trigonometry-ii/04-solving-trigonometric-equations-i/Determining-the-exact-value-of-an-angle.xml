  var b = JXG.JSXGraph.initBoard(divid, {boundingbox:[-30, 1.45, 390, -1.45], axis:false, grid:false,
      keepaspectratio:false, showNavigation:false, showCopyright:false});
  b.create('arrow', [[-15, 0], [385, 0]], {strokeColor:'#444', fixed:true, highlight:false});
  b.create('arrow', [[0, -1.35], [0, 1.4]], {strokeColor:'#444', fixed:true, highlight:false});
  for (var t = 90; t <= 360; t += 90) {
    b.create('segment', [[t, -0.04], [t, 0.04]], {strokeColor:'#444', fixed:true});
    b.create('text', [t, -0.12, t + '°'], {fixed:true, anchorX:'middle', anchorY:'top', fontSize:12});
  }
  b.create('text', [-6, 1, '1'], {fixed:true, anchorX:'right', anchorY:'middle', fontSize:12});
  b.create('text', [-6, -1, '−1'], {fixed:true, anchorX:'right', anchorY:'middle', fontSize:12});
  b.create('text', [380, -0.12, 'x'], {fixed:true, anchorX:'right', anchorY:'top'});
  b.create('functiongraph', [function(t) { return Math.sin(t*Math.PI/180); }, 0, 360], {strokeColor:'#1565c0', strokeWidth:2.5, fixed:true});
  b.create('segment', [[0, k], [360, k]], {strokeColor:'#ef6c00', strokeWidth:2, dash:2, fixed:true});
  b.create('text', [362, k, 'y = sin x = ' + (k > 0 ? '' : '−') + '{#sv#}/2'.replace('sqrt(2)', '√2').replace('sqrt(3)', '√3')],
      {fixed:true, anchorX:'left', anchorY:'middle', color:'#ef6c00', fontSize:12});
  [x1, x2].forEach(function(t) {
    b.create('point', [t, k], {name:'', size:4, color:'#c62828', fixed:true});
    b.create('segment', [[t, 0], [t, k]], {strokeColor:'#c62828', dash:1, fixed:true});
    b.create('text', [t, k > 0 ? -0.3 : 0.3, 'x = ' + t + '°'], {fixed:true, anchorX:'middle', anchorY:'middle', color:'#c62828', fontSize:13});
  });
