    <questionvariables>
      <text><![CDATA[/* Design backwards: choose sin x = k first, then build the equation m*sin(x) + d = 0.
   k = sg*s/2 with s in {1, sqrt(2), sqrt(3)}, so the reference angle is 30, 45 or 60 degrees.
   sg (+1 or -1) x 3 values of s x 3 coefficients m = 18 distinct variants. */
sg : rand([-1, 1]);
idx : 1 + rand(3);
slist : [1, sqrt(2), sqrt(3)];
alist : [30, 45, 60];
sv : slist[idx];
alpha : alist[idx];
m : rand([2, 4, 6]);
k : sg*sv/2;                 /* sin x = k */
d : -m*k;                    /* constant term of the equation */
eqn : m*sin(x) + d = 0;

/* Solutions in 0 <= x <= 360: sine is positive in Quadrants I and II, negative in III and IV */
x1 : if sg = 1 then alpha else 180 + alpha;
x2 : if sg = 1 then 180 - alpha else 360 - alpha;
sols : [x1, x2];
solset : setify(sols);
/* The two quadrants where sin x has the OPPOSITE sign (the common mistake) */
wrongq : if sg = 1 then [180 + alpha, 360 - alpha] else [alpha, 180 - alpha];
wrongset : setify(wrongq);
solrad : setify([x1*%pi/180, x2*%pi/180]);

/* Possible student mistakes in (a) and (b) */
k_neg : -k;                  /* sign error when rearranging */
k_nodiv : -d;                /* moved d across but did not divide by m */
alpha_rad : alpha*%pi/180;   /* reference angle in radians */]]></text>
    </questionvariables>
