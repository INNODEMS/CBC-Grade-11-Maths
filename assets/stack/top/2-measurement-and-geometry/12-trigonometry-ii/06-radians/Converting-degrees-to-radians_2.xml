    <questionvariables>
      <text>/* 30 angles between 0 and 360 (180 left out) that give tidy multiples of pi:
   multiples of 15 degrees (denominators 12, 6, 4, 3, 2) and multiples of 36 degrees (denominator 5). */
angpool : [15, 30, 45, 60, 75, 90, 105, 120, 135, 150, 165, 195, 210, 225, 240, 255, 270, 285, 300, 315, 330, 345,
           36, 72, 108, 144, 216, 252, 288, 324];
angdeg : rand(angpool);
tc : angdeg/180;               /* coefficient of pi, in lowest terms (simplified) */
ta1 : tc*%pi;                  /* the angle in radians */
hcf : gcd(angdeg, 180);        /* common factor cancelled in the worked solution */
nn : num(tc);
dd : denom(tc);
twrong : angdeg*180/%pi;       /* common slip: multiplied by 180/pi instead of pi/180 */</text>
    </questionvariables>
