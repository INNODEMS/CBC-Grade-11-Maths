    <questionvariables>
      <text><![CDATA[/* 32 angles between 0 and 360 degrees, none of which is used in "Converting degrees to radians"
   (that question uses multiples of 15 and 36 degrees). Each is (pp/qq)*pi with qq = 9, 18 or 10. */
angpool : [20, 40, 80, 100, 140, 160, 200, 220, 260, 280, 320, 340,
           10, 50, 70, 110, 130, 170, 190, 230, 250, 290, 310, 350,
           18, 54, 126, 162, 198, 234, 306, 342];
ta : rand(angpool);            /* the answer in degrees */
tc : ta/180;                   /* coefficient of pi, simplified */
pp : num(tc);
qq : denom(tc);
trad : tc*%pi;                 /* the angle shown in radians, e.g. 7*pi/9 */
unit : 180/qq;                 /* degrees in pi/qq radians */
twithpi : ta*%pi;              /* slip: left pi in the answer */]]></text>
