    <questionvariables>
      <text><![CDATA[/* theta = -a degrees for the 12 standard angles a (tangent always defined, never on an axis).
   unit = 1 shows theta (and asks for the reference angle) in radians, unit = 0 in degrees: 24 distinct variants. */
alist : [30, 45, 60, 120, 135, 150, 210, 225, 240, 300, 315, 330];
a : rand(alist);
unit : rand([0, 1]);
thetadeg : -a;
theta : thetadeg*%pi/180;

/* Turning clockwise through a degrees ends where an anticlockwise turn of 360 - a ends */
pos : 360 - a;
qP : if pos < 90 then 1 else if pos < 180 then 2 else if pos < 270 then 3 else 4;
refdeg : if qP = 1 then pos else if qP = 2 then 180 - pos else if qP = 3 then pos - 180 else 360 - pos;
refrad : refdeg*%pi/180;
posrad : pos*%pi/180;
quadnames : ["I", "II", "III", "IV"];
qn : quadnames[qP];

/* (a) dropdown options */
qopts : [[1, is(qP=1), "Quadrant I"], [2, is(qP=2), "Quadrant II"], [3, is(qP=3), "Quadrant III"], [4, is(qP=4), "Quadrant IV"]];
/* quadrant reached by turning ANTICLOCKWISE through a degrees (the common mistake) */
q_plus : if a < 90 then 1 else if a < 180 then 2 else if a < 270 then 3 else 4;
/* a wrong quadrant that is neither the answer nor q_plus (used in the question tests) */
q_other : if qP = 1 or qP = 4 then 2 else 1;

/* (b) reference angle in the unit of the question */
ta_ref : if unit = 1 then refrad else refdeg;
ref_wrongunit : if unit = 1 then refdeg else refrad;
ref_pos : if unit = 1 then posrad else pos;           /* gave the positive coterminal angle */

/* (c) exact ratios */
sin_theta : sin(theta);
cos_theta : cos(theta);
tan_theta : sin_theta/cos_theta;
sin_ref : sin(refrad);
cos_ref : cos(refrad);
tan_ref : sin_ref/cos_ref;
sin_neg : -sin_theta;
cos_neg : -cos_theta;
tan_neg : -tan_theta;
sin_mag : cos_ref;          /* used the cosine of the reference angle (either sign) */
cos_mag : sin_ref;          /* used the sine of the reference angle (either sign) */
tan_recip : 1/tan_theta;]]></text>
    </questionvariables>
