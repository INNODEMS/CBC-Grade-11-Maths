      <text><![CDATA[/* y = A*cos(B*x) + D, shown on 0 <= x <= 2*pi.
   A = 1..4, B = 1..3, D = -2..2: 4 x 3 x 5 = 60 distinct curves. */
A : rand_with_prohib(1, 4, [0]);
B : rand_with_prohib(1, 3, [0]);
D : rand_with_step(-2, 2, 1);
f : A*cos(B*x) + D;
ta_amp : A;
ta_period : 2*%pi/B;           /* %pi, not pi */
ta_midline : D;
ta_max : A + D;
ta_min : D - A;
/* common slips */
w_period_half : ta_period/2;    /* measured from a maximum to the next minimum */
w_period_deg : 360/B;           /* period in degrees */
w_amp_full : 2*A;               /* maximum minus minimum, not halved */
xmax2 : 2*%pi/B;                /* position of the second maximum (for the worked solution) */]]></text>
