    <questionvariables>
      <text>/* Randomly select a Pythagorean triple */
q: 1+rand(3);

/* Select the two shorter sides and hypotenuse */
sin_num: if q=1 then 3
          elseif q=2 then 5
          else 8;

cos_num: if q=1 then 4
          elseif q=2 then 12
          else 15;

hyp: if q=1 then 5
     elseif q=2 then 13
     else 17;

/* Given sine value */
given_sin: -sin_num/hyp;

/* Exact trigonometric ratios in quadrant III */
ta_cos: -cos_num/hyp;
ta_tan: sin_num/cos_num;

/* Exact coordinates of P */
ta_x: -cos_num/hyp;
ta_y: -sin_num/hyp;

/* Reference angle */
ta_ref: atan(sin_num/cos_num);
</text>
