    <questionvariables>
      <text>/* Define the transformed tangent function */
a: 2;
h: %pi/4;
k: 1;

f(x) := a*tan(x-h)+k;

/* Expected transformation parameters */
ta_a: a;
ta_h: h;
ta_k: k;

/* Expected vertical asymptotes nearest the origin */
ta_asymL: h-%pi/2;
ta_asymR: h+%pi/2;

/* Centre point of the middle branch */
ta_centre_x: h;
ta_centre_y: k;</text>
