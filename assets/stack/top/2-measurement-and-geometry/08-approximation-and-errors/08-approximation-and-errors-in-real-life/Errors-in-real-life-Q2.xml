    <questionvariables>
      <text>base_scale: 10;
base_steps: rand(80*base_scale/10 + 1);
base: float(3 + base_steps/base_scale);
base_err: float(0.5/base_scale);

height_scale: 10;
height_steps: rand(40*height_scale/10 + 1);
height: float(1.5 + height_steps/height_scale);
height_err: float(0.5/height_scale);

max_base: base + base_err;
min_base: base - base_err;

max_height: height + height_err;
min_height: height - height_err;

hyp: float(sqrt(base^2 + height^2));
max_hyp: float(sqrt(max_base^2 + max_height^2));
min_hyp: float(sqrt(min_base^2 + min_height^2));

ta1: max_hyp - hyp;
ta2: ta1 / hyp;
ta3: ta2 * 100;</text>
