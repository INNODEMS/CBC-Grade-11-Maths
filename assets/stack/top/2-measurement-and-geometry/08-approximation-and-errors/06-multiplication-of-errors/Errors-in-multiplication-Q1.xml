    <questionvariables>
      <text>length: rand(30) + 90;
length_err: 0.5;

width: rand(45) + 45;
width_err: 0.5;

max_length: length + length_err;
min_length: length - length_err;

max_width: width + width_err;
min_width: width - width_err;

W_area: length * width;

max_area: max_length * max_width;
min_area: min_length * min_width;

ta1 : max_area - W_area;
ta2 : ta1 / W_area;
ta3 : ta2 * 100;</text>
    </questionvariables>
