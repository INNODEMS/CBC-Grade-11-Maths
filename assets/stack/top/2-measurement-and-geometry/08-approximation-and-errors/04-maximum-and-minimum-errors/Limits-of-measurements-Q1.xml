    <questionvariables>
      <text>simp:true;

dp: 1 + rand(3);
scale: 10^dp;
va: float(1/scale);
va1: float(va/2);

max_steps: 50 * scale / 10;
steps: rand(max_steps + 1);

base: rand(90) + 10;

val: base + steps/scale;
val_disp: float(val);

ta_min: float(val_disp - va1);
ta_max: float(val_disp + va1);</text>
    </questionvariables>
