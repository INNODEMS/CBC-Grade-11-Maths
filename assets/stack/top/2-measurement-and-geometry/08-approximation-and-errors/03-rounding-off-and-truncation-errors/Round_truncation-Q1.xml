    <questionvariables>
      <text>val_scale: 1000;
val_steps: rand(500*val_scale/10 + 1);
val: float(20 + val_steps/val_scale);

rounded: float(round(val*10)/10);
truncated: float(floor(val*10)/10);

ta1: abs(rounded - val);
ta2: ta1 / val;
ta3: ta2 * 100;

ta4: abs(truncated - val);
ta5: ta4 / val;
ta6: ta5 * 100;</text>
    </questionvariables>
