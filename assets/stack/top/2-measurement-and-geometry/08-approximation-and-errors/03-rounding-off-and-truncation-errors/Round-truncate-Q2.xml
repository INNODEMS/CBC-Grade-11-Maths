rounded: float(round(val/1000)*1000);
truncated: float(floor(val/1000)*1000);

ta1: abs(rounded - val);
ta2: ta1 / val;
ta3: ta2 * 100;

ta4: abs(truncated - val);
ta5: ta4 / val;
ta6: ta5 * 100;</text>
