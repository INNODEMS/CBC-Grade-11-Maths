    <questionvariables>
      <text>val1: float((30 + rand(9)) + (rand(9) + 1) / 10);

val2: float((15 + rand(9)) + ((rand(9) + 1) * 10 + (rand(9) + 1)) / 100);

dp1: 1;
dp2: 2;

pre1: 1 / (2 * 10^dp1);
pre2: 1 / (2 * 10^dp2);

max1: val1 + pre1;
max2: val2 + pre2;

min1: val1 - pre1;
min2: val2 - pre2;

acts: val1 + val2;
actd: val1 - val2;

mins: min1 + min2;
maxs: max1 + max2;

mind: min1 - max2;
maxd: max1 - min2;

ta1: (maxs - mins) / 2;
ta2: (maxd - mind) / 2;
ta3: ta1 / acts;
ta4: ta2 / actd;
ta5: ta3 * 100;
ta6: ta4 * 100;
ta7: ta1 / actd;
ta8: ta2 / acts;</text>
    </questionvariables>
