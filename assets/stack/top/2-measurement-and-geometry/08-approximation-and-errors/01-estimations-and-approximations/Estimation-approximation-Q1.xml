actual: float(15000 + actual_steps);

est_scale: 100;
est_steps: rand(300);
estimate: float(round(actual/1000)*1000 + (est_steps - 150));

ta1: abs(estimate - actual);
ta2: ta1 / actual;
ta3: ta2 * 100;</text>
