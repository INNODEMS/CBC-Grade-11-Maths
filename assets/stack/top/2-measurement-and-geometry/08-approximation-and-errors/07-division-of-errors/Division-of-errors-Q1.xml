    <questionvariables>
      <text>distance: rand(200) + 100;
distance_err: 0.5;

time: rand(20) + 10;
time_err: 0.5;

max_distance: distance + distance_err;
min_distance: distance - distance_err;

max_time: time + time_err;
min_time: time - time_err;

W_speed: float(distance / time);

max_speed: max_distance / min_time;
min_speed: min_distance / max_time;

ta1: max_speed - W_speed;
ta2: ta1 / W_speed;
ta3: ta2 * 100;</text>
    </questionvariables>
