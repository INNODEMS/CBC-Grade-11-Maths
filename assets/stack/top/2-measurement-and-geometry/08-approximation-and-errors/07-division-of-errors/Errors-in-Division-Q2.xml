    <questionvariables>
      <text>mass_scale: 10;
mass_steps: rand(150*mass_scale/10 + 1);
mass: float(50 + mass_steps/mass_scale);
mass_err: float(0.5/mass_scale);

volume_scale: 100;
volume_steps: rand(80*volume_scale/10 + 1);
volume: float(20 + volume_steps/volume_scale);
volume_err: float(0.5/volume_scale);

max_mass: mass + mass_err;
min_mass: mass - mass_err;

max_volume: volume + volume_err;
min_volume: volume - volume_err;

conc: float(mass / volume);

max_conc: float(max_mass / min_volume);
min_conc: float(min_mass / max_volume);

ta1: max_conc - conc;
ta2: ta1 / conc;
ta3: ta2 * 100;</text>
    </questionvariables>
