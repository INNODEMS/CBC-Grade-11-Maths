    <questionvariables>
      <text>mn   : rand([[2,1],[3,1],[3,2],[4,1],[4,2],[4,3]]);
m    : mn[1];
nn   : mn[2];
sa   : m^2 - nn^2;        /* side a = BC, opposite A (a leg) */
sb   : 2*m*nn;            /* side b = CA, opposite B (a leg) */
sc   : m^2 + nn^2;        /* side c = AB, the hypotenuse */
ssemi: (sa + sb + sc)/2;  /* semi-perimeter */
area : sa*sb/2;           /* right-triangle area = half product of legs */
ra   : area/(ssemi - sa); /* exradius opposite A = m(m-nn) */
rb   : area/(ssemi - sb); /* exradius opposite B = nn(m+nn) */
rc   : area/(ssemi - sc); /* exradius opposite C = m(m+nn) */
rin  : area/ssemi;        /* inscribed-circle radius (a common wrong answer) */
ta1  : ra;
ta2  : rb;
ta3  : rc;</text>
    </questionvariables>
