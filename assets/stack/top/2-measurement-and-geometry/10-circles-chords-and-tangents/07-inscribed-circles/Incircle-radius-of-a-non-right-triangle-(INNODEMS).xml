    <questionvariables>
      <text>data : [[5,8,7,60],[3,8,7,60],[8,15,13,60],[7,15,13,60],[3,5,7,120],[7,8,13,120]];
    row  : data[rand(6)+1];
    p    : row[1];            /* b = CA, opposite B */
    q    : row[2];            /* c = AB, opposite C */
    opp  : row[3];            /* a = BC, opposite A (the given-angle vertex) */
    ang  : row[4];            /* angle A in degrees (60 or 120) */
    th   : ang*%pi/180;
    ssemiexact: (p + q + opp)/2;                              /* semi-perimeter s */
    areaexact : sqrt(ssemiexact*(ssemiexact-opp)*(ssemiexact-p)*(ssemiexact-q));  /* Heron's formula (an exact surd) */
    rinexact  : areaexact/ssemiexact;        /* inradius = area / s */
    ssemi : decimalplaces(float(ssemiexact), 3);
    area  : decimalplaces(float(areaexact), 3);
    rin   : decimalplaces(float(rinexact), 3);
    dia  : 2*rinexact;             /* twice the radius: missing 1/2, or the diameter */
    Cxv  : float(p*cos(th));  /* vertex C for the figure */
    Cyv  : float(p*sin(th));
    ta1  : ssemi;             /* model answer, step 1 */
    ta2  : area;              /* model answer, step 2 */
    ta3  : rin;               /* model answer, step 3 */</text>
    </questionvariables>
