    <questionvariables>
      <text>a : rand([1,-1,2,-2]);
r1 : rand([-3,-2,-1]);
r2 : rand([1,2,3]);
qexpr : a*(x-r1)*(x-r2);
cc : a*r1*r2;
vx : (r1+r2)/2;
vy : a*(vx-r1)*(vx-r2);
xlo : r1 - 2;
xhi : r2 + 2;
ymag : max(abs(vy), abs(cc), 6) + 3;
sp1 : r1 - 1;
sp2 : r2 + 1;
sp3y : 3;</text>
    </questionvariables>
