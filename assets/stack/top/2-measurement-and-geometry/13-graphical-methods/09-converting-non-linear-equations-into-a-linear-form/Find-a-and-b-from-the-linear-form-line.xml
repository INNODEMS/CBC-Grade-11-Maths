    <questionvariables>
      <text>mm : rand_with_prohib(-6,6,[0]);        /* slope = a (nonzero) */
cc : rand_with_prohib(-6,6,[0,mm]);     /* intercept = b (nonzero, distinct from m) */
/* board window: include the intercept, the slope triangle and the origin */
ylo0 : min(mm*(-2)+cc, mm*2+cc, cc, cc+mm, 0);
yhi0 : max(mm*(-2)+cc, mm*2+cc, cc, cc+mm, 0);
xminv : -2.5;
xmaxv : 2.5;
yminv : ylo0 - 1;
ymaxv : yhi0 + 1;
ta1: y;
ta2: 1/x;</text>
    </questionvariables>
