    <questionvariables>
      <text><![CDATA[/* ---------- DESIGN BACKWARDS ----------
   Choose the two crossing points first (x = pp and x = qq), then BUILD the equations:
   curve  y = x^2 - b   and   line  y = a x + b   meet where  x^2 - a x - 2b = 0 .
   With roots pp, qq:  a = pp + qq   and   b = -pp*qq/2   (pp*qq is even, so b is a whole number).
   Pool = [pp, qq, [allowed left ends of the 10-unit x-interval]], vetted so that
   pp,qq nonzero & distinct, a nonzero (line not horizontal), b nonzero, |b|<=12, |a|<=8,
   |y| <= 20 at both crossings, and the whole picture fits a board <= 28 units tall.
   16 equation pairs x 3-6 interval windows = 60 distinct variants. */
pool : [
    [-4,1,[-6,-5]],
    [-4,2,[-6,-5]],
    [-4,3,[-6,-5]],
    [-3,-2,[-6,-5,-4]],
    [-3,2,[-6,-5,-4]],
    [-3,4,[-5,-4]],
    [-2,-1,[-6,-5,-4,-3]],
    [-2,1,[-6,-5,-4,-3]],
    [-2,3,[-6,-5,-4,-3]],
    [-2,4,[-5,-4,-3]],
    [-1,2,[-6,-5,-4,-3,-2]],
    [-1,4,[-5,-4,-3,-2]],
    [1,2,[-6,-5,-4,-3,-2,-1]],
    [1,4,[-5,-4,-3,-2,-1]],
    [2,3,[-6,-5,-4,-3,-2,-1]],
    [2,4,[-5,-4,-3,-2,-1]]
];
cfg : rand(pool);
pp  : cfg[1];
qq  : cfg[2];
xlo : rand(cfg[3]);            /* randomised interval  xlo <= x <= xhi (always 10 wide) */
xhi : xlo + 10;
aa  : pp + qq;                 /* gradient of the line */
bb  : -pp*qq/2;                /* b : curve y=x^2-b, line y=ax+b */

/* the two solutions, readable from the graph */
sx1 : pp;  sy1 : pp^2 - bb;
sx2 : qq;  sy2 : qq^2 - bb;
sol1 : [sx1, sy1];
sol2 : [sx2, sy2];

/* vertical extent of the board: crossings, vertex (0,-b), y-intercept (0,b), (1,a+b), origin */
ylist : [sy1, sy2, -bb, bb, 0, aa+bb];
ymin  : lmin(ylist) - 2;
ymax  : lmax(ylist) + 2;

/* readable equations (no "x^2 - -3" or "2 - 3x" surprises) */
sgnterm(c) := if is(c<0) then sconcat(" - ", string(-c)) else sconcat(" + ", string(c));
eq1tex : sconcat("y = x^2", sgnterm(-bb));
eq2tex : sconcat("y = ", if is(aa=1) then "x" else if is(aa=-1) then "-x" else sconcat(string(aa),"x"), sgnterm(bb));

/* model answers for the JSXGraph-bound inputs:
   ans1 = turning point of the curve, ans2/ans3 = two points on the line */
ta1 : [0, -bb];
ta2 : [0, bb];
ta3 : [1, aa+bb];
/* model answers for part (b) */
ta4 : sol1;
ta5 : sol2;
/* wrong answer used only in a question test: a solution with x and y swapped (skip one with x=y) */
swp : if is(sol1=reverse(sol1)) then reverse(sol2) else reverse(sol1);

/* small tables for the worked solution */
cvals : create_list(k^2 - bb, k, [-2,-1,0,1,2]);
lvals : create_list(aa*k + bb, k, [0,1,2]);]]></text>
    </questionvariables>
