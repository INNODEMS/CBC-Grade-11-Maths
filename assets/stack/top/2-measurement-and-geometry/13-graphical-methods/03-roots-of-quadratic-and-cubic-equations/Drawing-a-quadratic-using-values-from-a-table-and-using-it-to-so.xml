    <questionvariables>
      <text>r1 : rand([-4,-3,-2,-1,0,1]);
gap : rand([2,3,4,5]);
r2 : r1 + gap;
p : -(r1 + r2);
q : r1*r2;
qexpr : x^2 + p*x + q;
xlo : floor((r1+r2)/2) - 3;
xhi : xlo + 6;
tx : makelist(xlo + i - 1, i, 1, 7);
ty : makelist((tx[i]-r1)*(tx[i]-r2), i, 1, 7);
pxlo : xlo - 1;
pxhi : xhi + 1;
pylo : lmin(ty) - 2;
pyhi : lmax(ty) + 2;</text>
    </questionvariables>
