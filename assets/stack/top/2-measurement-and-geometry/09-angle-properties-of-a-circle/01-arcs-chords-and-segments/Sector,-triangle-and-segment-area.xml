    <questionvariables>
      <text>simp:true;
T: [60,90,120];
SV: [sqrt(3)/2, 1, sqrt(3)/2];
idx: rand([1,2,3]);
theta: T[idx];
sv: SV[idx];
r: rand([4,6,8,10,12]);   /* r = 2 makes the sector area equal the arc length */
r2: r^2;
ta1: theta/360*%pi*r2;
ta2: r2*sv/2;
ta3: ta1-ta2;</text>
    </questionvariables>
