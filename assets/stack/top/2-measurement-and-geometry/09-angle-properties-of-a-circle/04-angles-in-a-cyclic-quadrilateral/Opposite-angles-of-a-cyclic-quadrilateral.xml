    <questionvariables>
      <text>x: rand(delete(90, makelist(5*i,i,14,21)));
y: rand(sublist(makelist(5*i,i,14,19), lambda([t], not(member(t, [90, x, 180-x])))));   /* never 90, equal or supplementary */
rr: 60;
pp: 420-2*x-2*y;
qq: 2*y-rr;
ss: 2*x-rr;
ta1: 180-x;
ta2: 180-y;</text>
    </questionvariables>
    <specificfeedback format="html">
