<quiz>
  <question type="stack">
    <name>
      <text>angles subtended by the same diameter</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>The diagram shows a circle with centre \(O\). \(AB\) is a diameter, and \(C\) and \(D\) are points on the circumference on opposite sides of \(AB\).
The chords \(AC = {@p@}\) cm and \(BC = {@q@}\) cm.</p>
<div style="text-align:center;" role="img" aria-label="A circle with centre O and diameter AB. C is on the circle above AB and D is on the circle below AB. Chord AC is {#p#} cm and chord BC is {#q#} cm. Chords DA and DB meet at D.">
[[jsxgraph width="340px" height="340px"]]
(function() {
  var b = JXG.JSXGraph.initBoard(divid, {boundingbox:[-1.45, 1.45, 1.45, -1.45], axis:false, keepAspectRatio:true,
      showNavigation:false, showCopyright:false, pan:{enabled:false}, zoom:{enabled:false}});
  var deg = Math.PI/180, P = {};
  b.create('circle', [[0, 0], 1], {strokeColor:'#333', strokeWidth:2, fixed:true, highlight:false});
  function pt(n, d) { var t = d*deg; P[n] = b.create('point', [Math.cos(t), Math.sin(t)], {name:n, size:2, fixed:true,
      color:'#222', showInfobox:false, label:{offset:[17*Math.cos(t) - 5, 17*Math.sin(t) - 6], fontSize:15}}); }
  P.O = b.create('point', [0, 0], {name:'O', size:2, fixed:true, color:'#222', showInfobox:false, label:{offset:[6, -14], fontSize:15}});
  pt('A', 180);
  pt('B', 0);
  pt('C', 2*Math.atan2({#q#}, {#p#})/deg);
  pt('D', -110);
  b.create('segment', [P['A'], P['B']], {strokeColor:'#333', strokeWidth:2, dash:0, fixed:true, highlight:false});
  b.create('segment', [P['A'], P['C']], {strokeColor:'#1f5fa8', strokeWidth:2, dash:0, fixed:true, highlight:false});
  b.create('segment', [P['C'], P['B']], {strokeColor:'#1f5fa8', strokeWidth:2, dash:0, fixed:true, highlight:false});
  b.create('segment', [P['A'], P['D']], {strokeColor:'#333', strokeWidth:2, dash:0, fixed:true, highlight:false});
  b.create('segment', [P['D'], P['B']], {strokeColor:'#333', strokeWidth:2, dash:0, fixed:true, highlight:false});
  function angLabel(brd, A, V, C, t) { var ax = A.X() - V.X(), ay = A.Y() - V.Y(), cx = C.X() - V.X(), cy = C.Y() - V.Y(); var la = Math.sqrt(ax*ax + ay*ay), lc = Math.sqrt(cx*cx + cy*cy); var ux = ax/la + cx/lc, uy = ay/la + cy/lc, lu = Math.sqrt(ux*ux + uy*uy); var h = Math.acos(Math.max(-1, Math.min(1, (ax*cx + ay*cy)/(la*lc))))/2; var d = Math.min(0.72, Math.max(0.44, 0.15/Math.tan(h))); brd.create('text', [V.X() + d*ux/lu, V.Y() + d*uy/lu, t], {anchorX:'middle', anchorY:'middle', fontSize:13, fixed:true, highlight:false, cssStyle:'background:rgba(255,255,255,0.85);padding:0 2px;border-radius:3px'}); }
  b.create('nonreflexangle', [P['A'], P['D'], P['B']], {radius:0.24, withLabel:false, fillColor:'#c0392b', fillOpacity:0.35, strokeColor:'#c0392b', fixed:true, highlight:false});
  angLabel(b, P['A'], P['D'], P['B'], '?');
  var mid = function (U, V, t) { var mx = (U.X() + V.X())/2, my = (U.Y() + V.Y())/2, m = Math.sqrt(mx*mx + my*my), k = 1 - 0.2/m; b.create('text', [k*mx, k*my, t], {anchorX:'middle', anchorY:'middle', fontSize:13, fixed:true, strokeColor:'#1f5fa8'}); };
  mid(P.A, P.C, '{#p#} cm');
  mid(P.C, P.B, '{#q#} cm');   
