    <questionvariables>
      <text><![CDATA[simp:true;
ang: rand(makelist(i,i,20,70));
third: 90-ang;

pc: float(2*ang*%pi/180);
xC: float(cos(pc));
yC: float(sin(pc));
img: plot(
  [[parametric, cos(s), sin(s), [s,0,2*%pi]],
   [discrete, [[-1,0],[1,0],[xC,yC],[-1,0]]]],
  [x,-1.4,1.4], [y,-1.4,1.4],
  [box,false], [axes,false], [legend,false], [size,400,400],
  [label, ["A",-1.2,0], ["B",1.2,0], ["C",1.15*xC,1.15*yC], ["O",0,-0.12]]
);

ta1: 90;
ta2: third;]]></text>
