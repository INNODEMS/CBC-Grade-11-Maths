    <questionvariables>
      <text><![CDATA[simp:true;
ang: rand(makelist(i,i,20,80));
cen: 2*ang;
refl: 360-cen;

pa: float((90+ang)*%pi/180);
pb: float((90-ang)*%pi/180);
xA: float(cos(pa));
yA: float(sin(pa));
xB: float(cos(pb));
yB: float(sin(pb));

img: plot(
  [[parametric, cos(s), sin(s), [s,0,2*%pi]],
   [discrete, [[xA,yA],[0,0],[xB,yB]]],
   [discrete, [[xA,yA],[0,-1],[xB,yB]]]],
  [x,-1.4,1.4], [y,-1.4,1.4],
  [box,false], [axes,false], [legend,false], [size,400,400],
  [label, ["A",1.15*xA,1.15*yA], ["B",1.15*xB,1.15*yB], ["C",0,-1.15], ["O",0.1,-0.12]]
);

ta1: cen;
ta2: refl;]]></text>
