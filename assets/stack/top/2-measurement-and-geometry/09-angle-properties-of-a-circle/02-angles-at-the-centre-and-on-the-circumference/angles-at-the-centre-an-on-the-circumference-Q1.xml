<quiz>
  <question type="stack">
    <name>
      <text>angles at the centre an on the circumference Q1</text>
    </name>
    <questiontext format="moodle_auto_format">
      <text><![CDATA[<p>\(A\), \(B\) and \(C\) are points on a circle with centre \(O\). The angle \(ACB = {@ang@}^\circ\).</p>
<p>{@img@}</p>

<p><strong>(a)</strong> Find the angle \(AOB\).</p>
<p>[[input:ans1]] degrees [[validation:ans1]] [[feedback:prt1]]</p>

<p><strong>(b)</strong> Find the reflex angle \(AOB\) (the angle on the other side of \(O\)).</p>
<p>[[input:ans2]] degrees [[validation:ans2]] [[feedback:prt2]]</p>]]></text>
    </questiontext>
    <generalfeedback format="moodle_auto_format">
      <text><![CDATA[<h3>Worked solution</h3>

<p><strong>(a)</strong> The angle at the centre is twice the angle at the circumference when both stand on the same arc \(AB\).</p>
\[ AOB = 2 \times {@ang@}^\circ = {@cen@}^\circ \]

<p><strong>(b)</strong> Angles around a point add up to \(360^\circ\).</p>
\[ \text{reflex } AOB = 360^\circ - {@cen@}^\circ = {@refl@}^\circ \]]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <stackversion>
      <text>2026063000</text>
