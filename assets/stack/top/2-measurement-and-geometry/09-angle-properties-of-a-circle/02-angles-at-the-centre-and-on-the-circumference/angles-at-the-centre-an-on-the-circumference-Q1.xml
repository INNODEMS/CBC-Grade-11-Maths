<quiz>
  <question type="stack">
    <name>
      <text>angles at the centre an on the circumference Q1</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>\(A\), \(B\) and \(C\) are points on a circle with centre \(O\). The angle \(ACB = {@ang@}^\circ\).</p>
<div style="text-align:center;" role="img" aria-label="A circle with centre O. A, B and C are on the circle, with C on the major arc. Chords CA and CB make an angle of {#ang#} degrees at C, and radii OA and OB meet at O.">
[[jsxgraph width="340px" height="340px"]]
(function() {
  var b = JXG.JSXGraph.initBoard(divid, {boundingbox:[-1.45, 1.45, 1.45, -1.45], axis:false, keepAspectRatio:true,
      showNavigation:false, showCopyright:false, pan:{enabled:false}, zoom:{enabled:false}});
  var deg = Math.PI/180, P = {};
  b.create('circle', [[0, 0], 1], {strokeColor:'#333', strokeWidth:2, fixed:true, highlight:false});
  function pt(n, d) { var t = d*deg; P[n] = b.create('point', [Math.cos(t), Math.sin(t)], {name:n, size:2, fixed:true,
      color:'#222', showInfobox:false, label:{offset:[17*Math.cos(t) - 5, 17*Math.sin(t) - 6], fontSize:15}}); }
  P.O = b.create('point', [0, 0], {name:'O', size:2, fixed:true, color:'#222', showInfobox:false, label:{offset:[6, -14], fontSize:15}});
  pt('A', 90 + {#ang#});
  pt('B', 90 - {#ang#});
  pt('C', 270);
  b.create('segment', [P['O'], P['A']], {strokeColor:'#333', strokeWidth:2, dash:0, fixed:true, highlight:false});
  b.create('segment', [P['O'], P['B']], {strokeColor:'#333', strokeWidth:2, dash:0, fixed:true, highlight:false});
  b.create('segment', [P['C'], P['A']], {strokeColor:'#333', strokeWidth:2, dash:0, fixed:true, highlight:false});
  b.create('segment', [P['C'], P['B']], {strokeColor:'#333', strokeWidth:2, dash:0, fixed:true, highlight:false});
  function angLabel(brd, A, V, C, t) { var ax = A.X() - V.X(), ay = A.Y() - V.Y(), cx = C.X() - V.X(), cy = C.Y() - V.Y(); var la = Math.sqrt(ax*ax + ay*ay), lc = Math.sqrt(cx*cx + cy*cy); var ux = ax/la + cx/lc, uy = ay/la + cy/lc, lu = Math.sqrt(ux*ux + uy*uy); var h = Math.acos(Math.max(-1, Math.min(1, (ax*cx + ay*cy)/(la*lc))))/2; var d = Math.min(0.72, Math.max(0.44, 0.15/Math.tan(h))); brd.create('text', [V.X() + d*ux/lu, V.Y() + d*uy/lu, t], {anchorX:'middle', anchorY:'middle', fontSize:13, fixed:true, highlight:false, cssStyle:'background:rgba(255,255,255,0.85);padding:0 2px;border-radius:3px'}); }
  b.create('nonreflexangle', [P['B'], P['C'], P['A']], {radius:0.24, withLabel:false, fillColor:'#1f5fa8', fillOpacity:0.35, strokeColor:'#1f5fa8', fixed:true, highlight:false});
  angLabel(b, P['B'], P['C'], P['A'], '{#ang#}°');
  b.create('nonreflexangle', [P['B'], P['O'], P['A']], {radius:0.24, withLabel:false, fillColor:'#c0392b', fillOpacity:0.35, strokeColor:'#c0392b', fixed:true, highlight:false});
  angLabel(b, P['B'], P['O'], P['A'], '?');
})();
[[/jsxgraph]]
</div>

<p><strong>(a)</strong> Find the angle \(AOB\).</p>
<p>[[input:ans1]] degrees [[validation:ans1]] [[feedback:prt1]]</p>

<p><strong>(b)</strong> Find the reflex angle \(AOB\) (the angle on the other side of \(O\)).</p>
<p>[[input:ans2]] degrees [[validation:ans2]] [[feedback:prt2]]</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<h3>Worked solution</h3>

<p><strong>(a)</strong> The angle at the centre is twice the angle at the circumference when both stand on the same arc \(AB\).</p>
\[ AOB = 2 \times {@ang@}^\circ = {@cen@}^\circ \]

<p><strong>(b)</strong> Angles around a point add up to \(360^\circ\).</p>
\[ \text{reflex } AOB = 360^\circ - {@cen@}^\circ = {@refl@}^\circ \]]]></text>
    </generalfeedback>
