    <questionvariables>
      <text><![CDATA[/* s(t) = s0 + uu t - 5 t^2 with uu = 10 kk, so the stone peaks at t = kk. */
kk  : rand([2, 3, 4, 5]);
uu  : 10*kk;
s0  : rand([5, 10, 15, 20, 25, 30]);
st  : s0 + uu*t - 5*t^2;
vt  : diff(st, t);                       /* uu - 10 t */
tp  : kk;                                /* time of maximum height */
hmax: subst(tp, t, st);
tq  : rand_with_prohib(1, 2*kk - 1, [kk]);  /* a time before or after the peak */
vq  : subst(tq, t, vt);
sq  : subst(tq, t, st);
dirs : [[1, is(vq > 0), "moving upwards"], [2, is(vq < 0), "moving downwards"], [3, false, "momentarily at rest"]];
ta5 : if vq > 0 then 1 else 2;
w_v1 : uu - 5*t;                         /* forgot to multiply by the power 2 */
w_v2 : s0 + uu - 10*t;                   /* kept the constant s0 */]]></text>
    </questionvariables>
