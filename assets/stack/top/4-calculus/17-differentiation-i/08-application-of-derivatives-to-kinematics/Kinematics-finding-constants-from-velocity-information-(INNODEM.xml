    <questionvariables>
      <text>/* s = pv t^2 + qv t; the velocity facts v(t1) = V1, v(t2) = V2 give p and q.
   Filter so that using the POSITION equations by mistake gives different numbers. */
cands : sublist(create_list([u, w, a1, d], u, [-2, -1, 1, 2, 3, 4, 5], w, -6, 8, a1, 1, 3, d, 1, 3),
  lambda([z], block([pa, qa, a2, sol],
    pa : z[1], qa : z[2], a2 : z[3] + z[4],
    sol : linsolve([pa1*z[3]^2 + qa1*z[3] = 2*pa*z[3] + qa, pa1*a2^2 + qa1*a2 = 2*pa*a2 + qa], [pa1, qa1]),
    is(qa # 0 and rhs(sol[1]) # pa and rhs(sol[2]) # qa and 2*pa*z[3] + qa # 0))));
pick : rand(cands);
pv : pick[1];
qv : pick[2];
t1 : pick[3];
t2 : pick[3] + pick[4];
V1 : 2*pv*t1 + qv;
V2 : 2*pv*t2 + qv;
vt : 2*p*t + q;                          /* model answer (a) */
/* Mistake: used s(t1) = V1 and s(t2) = V2. */
wsol : linsolve([p*t1^2 + q*t1 = V1, p*t2^2 + q*t2 = V2], [p, q]);
wp : rhs(wsol[1]);
wq : rhs(wsol[2]);</text>
    </questionvariables>
