    <questionvariables>
      <text>/* Randomise backwards: choose c, n, then the answer is c*n*x^(n-1). */
n : rand(5)+2;                                  /* exponent 2..6 */
m : n-1;                                         /* reduced exponent, a clean integer */
c : rand_with_prohib(2,9,[n]) * rand([-1,1]);   /* |c| in 2..9, c != n, random sign */
notn : rand(3)+1;                                /* 1: f'(x)  2: dy/dx  3: Leibniz */

expr : c*x^n;                                    /* the function to differentiate */
ta1  : c*n*x^m;                                  /* model answer c n x^(n-1) */

/* Misconception targets. */
w_keepexp : c*n*x^n;      /* power down, exponent not reduced */
w_nomult  : c*x^m;        /* exponent reduced, forgot the factor n */
w_dropc   : n*x^m;        /* dropped the constant multiple c */
w_incpow  : c*n*x^(n+1);  /* raised the exponent (integration reflex) */

/* Coefficient shown unevaluated for the worked solution, e.g. 3*4*x^3. */
simp:false;
step_disp : c*n*x^m;
simp:true;</text>
