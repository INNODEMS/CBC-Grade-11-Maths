    <questionvariables>
      <text>/* Predict x^-1 and x^-2: index (rewrite), coefficient, new power. */
idx1_ta : -1;  c1_ta : -1;  p1_ta : -2;  p1_noreduce : -1;  p1_addone : 0;
idx2_ta : -2;  c2_ta : -2;  p2_ta : -3;  p2_noreduce : -2;  p2_addone : -1;

/* Part A: negative power with a constant multiple, f(x) = a/x^p. */
a  : rand(8)+2;                /* coefficient 2..9 */
p  : rand([2,3,4,5]);
fA : a/x^p;
idxA_ta : -p;                  /* rewritten index */
cA_ta   : -a*p;                /* coefficient after differentiating */
cA_dropc : -p;                 /* brought the power down but dropped the coefficient a */
pA_ta   : -p-1;                /* new power */
pA_noreduce : -p;              /* did not subtract 1 (kept the index) */
pA_addone   : -p+1;            /* added 1 to the index instead of subtracting */
dA : cA_ta*x^(pA_ta);          /* full derivative, for the worked solution */</text>
    </questionvariables>
