    <questionvariables>
      <text><![CDATA[/* Each context: [symbol, description, input variable, input plural, 'after' phrase,
   output plural, output singular, input singular, short name, typical value]. */
ctxs : [
  [V, "the volume of water, in litres, in a school water tank", t, "minutes", "after noon", "litres", "litre", "minute", "the volume of water in the tank", 600],
  [P, "the population of a town", t, "years", "after 2020", "people", "person", "year", "the population", 52000],
  [T, "the temperature of a cup of tea, in degrees Celsius", t, "minutes", "after it was poured", "degrees Celsius", "degree Celsius", "minute", "the temperature of the tea", 64],
  [B, "the balance, in KSh, of a chama savings account", t, "months", "after it was opened", "KSh", "shilling", "month", "the balance", 15000],
  [H, "the height, in metres, of a weather balloon above the ground", t, "seconds", "after release", "metres", "metre", "second", "the height of the balloon", 450]];
cx : rand(ctxs);
fs : cx[1];
fdesc : cx[2];
vs : cx[3];
xpl : cx[4];
xafter : cx[5];
fpl : cx[6];
fsg : cx[7];
xsg : cx[8];
qshort : cx[9];
fb : cx[10];
bb : rand([10, 20, 30, 40]);
cc2 : bb + rand([5, 15, 25]);
dfb : rand([-1, 1])*rand([3, 5, 8, 12, 20]);
dirw : if dfb > 0 then "increasing" else "decreasing";
odirw : if dfb > 0 then "decreasing" else "increasing";
/* Key 1 is correct in every dropdown. */
opts1 : random_permutation([
  [1, true,  sconcat(fpl, " per ", xsg)],
  [2, false, fpl],
  [3, false, xpl],
  [4, false, sconcat(xpl, " per ", fsg)]]);
opts2 : random_permutation([
  [1, true,  sconcat("At ", vs, " = ", bb, ", ", qshort, " is ", dirw, " at a rate of ", abs(dfb), " ", fpl, " per ", xsg, ".")],
  [2, false, sconcat("At ", vs, " = ", bb, ", ", qshort, " is ", dfb, " ", fpl, ".")],
  [3, false, sconcat("At ", vs, " = ", bb, ", ", qshort, " is ", odirw, " at a rate of ", abs(dfb), " ", fpl, " per ", xsg, ".")],
  [4, false, sconcat("Between ", vs, " = 0 and ", vs, " = ", bb, ", ", qshort, " changed by ", dfb, " ", fpl, " altogether.")]]);
opts3 : random_permutation([
  [1, true,  sconcat("At ", vs, " = ", cc2, ", ", qshort, " is momentarily neither increasing nor decreasing.")],
  [2, false, sconcat("At ", vs, " = ", cc2, ", ", qshort, " is zero.")],
  [3, false, sconcat(qshort, " never changes.")],
  [4, false, sconcat("At ", vs, " = ", cc2, ", ", qshort, " is changing at its fastest rate.")]]);]]></text>
