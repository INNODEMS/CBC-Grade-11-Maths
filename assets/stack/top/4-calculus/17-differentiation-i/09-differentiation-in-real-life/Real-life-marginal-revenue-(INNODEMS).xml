    <questionvariables>
      <text><![CDATA[/* R(x) = pr x - qc x^2 has its maximum at x = xs, where pr = 2 qc xs. */
qc : rand([2, 4, 5, 10]);
xs : rand([20, 25, 30, 40, 50]);
pr : 2*qc*xs;
rx : pr*x - qc*x^2;
drx : diff(rx, x);
x1 : xs - rand([5, 10, 15]);
x2 : xs + rand([5, 10]);
r1 : subst(x1, x, drx);
r2 : subst(x2, x, drx);
rmax : subst(xs, x, rx);
w_r1 : subst(x1, x, rx);                     /* revenue instead of marginal revenue */
/* Dropdown for (c): key 1 is correct. */
opts3 : random_permutation([
  [1, true,  sconcat("When ", x2, " packets have been sold, selling one more packet would reduce total revenue by about KSh ", -r2, ".")],
  [2, false, sconcat("When ", x2, " packets have been sold, the total revenue is KSh ", r2, ".")],
  [3, false, sconcat("When ", x2, " packets have been sold, selling one more packet would increase total revenue by about KSh ", -r2, ".")],
  [4, false, sconcat("Selling ", x2, " packets makes a loss of KSh ", -r2, ".")]]);]]></text>
    </questionvariables>
