    <questionvariables>
      <text><![CDATA[/* f(x) = pq x^2 + qq x + rq.  Pick the point of tangency aa first; the given
   line then has gradient mt = f'(aa) and an intercept k0 that is not the tangent's. */
cands : sublist(create_list([u2, u1, u0, u], u2, [1, -1, 2], u1, -4, 4, u0, -4, 4, u, -3, 3),
  lambda([z], block([m, fv],
    m  : 2*z[1]*z[4] + z[2],
    fv : z[1]*z[4]^2 + z[2]*z[4] + z[3],
    is(m # 0 and abs(m) <= 8 and abs(fv) <= 12 and z[4] # 0))));
pick : rand(cands);
pq : pick[1];
qq : pick[2];
rq : pick[3];
aa : pick[4];
fx  : pq*x^2 + qq*x + rq;
dfx : diff(fx, x);
mt  : subst(aa, x, dfx);                 /* gradient of the given line and the tangent */
fa  : subst(aa, x, fx);
ct  : fa - mt*aa;                        /* intercept of the tangent */
k0  : rand_with_prohib(-6, 6, [ct, mt, 0]); /* intercept of the given line */
gl  : mt*x + k0;                         /* the given line */
tl  : mt*x + ct;                         /* model tangent */
w_horiz : -qq/(2*pq);                    /* solved f'(x) = 0 */
w_kint  : (k0 - qq)/(2*pq);              /* solved f'(x) = intercept */
w_online: mt*aa + k0;                    /* y taken from the given line */]]></text>
    </questionvariables>
