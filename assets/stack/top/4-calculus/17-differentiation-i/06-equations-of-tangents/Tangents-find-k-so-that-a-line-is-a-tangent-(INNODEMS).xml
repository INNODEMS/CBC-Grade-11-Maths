    <questionvariables>
      <text>/* Line y = mm x + k0 with k0 = -ss^2 is tangent to y = x^2 - k x at x = +/- ss,
   giving k = 2a - mm. */
mm : rand_with_prohib(-6, 6, [0]);
ss : rand([1, 2, 3, 4]);
k0 : -ss^2;
gl : mm*x + k0;
ta1 : 2*a - mm;                       /* k in terms of a */
ta2 : {ss, -ss};
ta3 : {2*ss - mm, -2*ss - mm};
w_sign1 : mm - 2*a;                   /* sign slip in the gradient condition */</text>
    </questionvariables>
