    <questionvariables>
      <text><![CDATA[/* f(x) = c3 x^3 + c2 x^2 + c1 x + c0 (quadratic when c3 = 0) at x = aa.
   The tangent gradient mt is never 0 (normal would be vertical) and never +/-1
   (so that -1/m, 1/m, -m and m are four different numbers). */
cands : sublist(
  create_list([u3, u2, u1, u0, u], u3, [0, 1], u2, -3, 3, u1, -4, 4, u0, -5, 5, u, [-2, -1, 1, 2]),
  lambda([z], block([m, fv],
    m  : 3*z[1]*z[5]^2 + 2*z[2]*z[5] + z[3],
    fv : z[1]*z[5]^3 + z[2]*z[5]^2 + z[3]*z[5] + z[4],
    is((z[1] # 0 or z[2] # 0) and m # 0 and abs(m) # 1 and abs(m) <= 12 and fv # 0 and abs(fv) <= 15 and abs(fv) # abs(m) and fv*m # 2*z[5]))));
pick : rand(cands);
fx  : pick[1]*x^3 + pick[2]*x^2 + pick[3]*x + pick[4];
aa  : pick[5];
dfx : diff(fx, x);
mt  : subst(aa, x, dfx);              /* tangent gradient */
mn  : -1/mt;                          /* normal gradient */
fa  : subst(aa, x, fx);
nl  : expand(mn*(x - aa) + fa);       /* model normal */
tl  : expand(mt*(x - aa) + fa);       /* the tangent, a common wrong answer */
w_noshift : expand(mn*(x - aa));
w_sign    : expand(mn*(x + aa) + fa);]]></text>
    </questionvariables>
