    <questionvariables>
      <text>/* Parabola y = x^2 + cq, point P at x = aa.  Normal: gradient -1/(2 aa).
   Second intersection x2 = -aa - 1/(2 aa)  (sum of the roots). */
aa  : rand([-3, -2, -1, 1, 2, 3]);    /* not +/-1/2: there the normal with the wrong sign IS the tangent */
cq  : rand([-3, -2, -1, 0, 1, 2]);
fx  : x^2 + cq;
ya  : aa^2 + cq;
mn  : -1/(2*aa);
nl  : expand(mn*(x - aa) + ya);
x2  : -aa - 1/(2*aa);
y2  : x2^2 + cq;
tl  : expand(2*aa*(x - aa) + ya);           /* tangent: a common wrong answer */
w_nominus : expand(1/(2*aa)*(x - aa) + ya);  /* forgot the minus sign */</text>
    </questionvariables>
