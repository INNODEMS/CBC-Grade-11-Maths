    <questionvariables>
      <text><![CDATA[/* Design-backwards: f(x) = k/x chosen directly.
   k in {-3,-2,-1,1,2,3} gives sign variety (f'>0 when k<0);
   a in {2,3} keeps the hole legible and the asymptote (h=-a) off the drag range. */
k : rand([-3,-2,-1,1,2,3]);
a : rand([2,3]);
fdisp : k/x;                  /* display of f(x) */
negk  : -k;                   /* the numerator -k, for tidy worked-solution display */

q_simp : -k/(x*(x+h));        /* simplified difference quotient (model answer ans3) */
fpx    : -k/x^2;              /* f'(x) from first principles (model answer ans4) */
fpa    : -k/a^2;              /* exact gradient at x=a (model answer ans5) */
holef  : float(fpa);          /* numeric limit for the graph estimate (ans1) */

/* wrong-answer variables for diagnostics and question tests */
q_sign   : k/(x*(x+h));       /* sign slip: took x-(x+h) as +h */
fpx_sign : k/x^2;             /* sign slip in f'(x) */
fpa_sign : k/a^2;             /* sign slip at x=a */
fpa_nosq : -k/a;              /* forgot to square the denominator */

/* radio options: why can't we set h=0 in q(h)? */
correctopt : 1;
ta2 : [[1, true,  "It gives \\(\\dfrac{0}{0}\\), an indeterminate form."],
       [2, false, "It gives \\(\\dfrac{k}{0}\\), which is infinite."],
       [3, false, "It gives \\(0\\), so the gradient is \\(0\\)."]];

/* JSXGraph geometry: h-domain and a value-window computed from the curve ends */
hmin  : -1.3;                 /* asymptote at h=-a (a>=2), so >=0.7 clear */
hmax  : 1.5;
gEnd1 : float(-k/(a*(a+hmin)));
gEnd2 : float(-k/(a*(a+hmax)));
yvals : [gEnd1, gEnd2, holef, 0];   /* include 0 so the h-axis is on screen */
yT : lmax(yvals) + 0.5;
yB : lmin(yvals) - 0.5;
xL : hmin - 0.3;
xR : hmax + 0.3;]]></text>
    </questionvariables>
