    <questionvariables>
      <text><![CDATA[/* f(x) = a*x^2 + b*x, a in {1,2,3}, b nonzero in [-5,5], c = 0 fixed. */
a  : rand([1,2,3]);
a2 : 2*a;
b  : rand_with_prohib(-5,5,[0]);
x0 : rand_with_prohib(-3,3,[0]);

f(x) := a*x^2 + b*x;
fexpr : f(x);

/* Model answers for each step. */
fxh_unexp     : a*(x+h)^2 + b*(x+h);                 /* Step 1 shown unexpanded */
fxh_true      : expand(f(x+h));                       /* Step 1 target (expanded) */
num_collected : expand(f(x+h) - f(x));                /* numerator: 2a x h + a h^2 + b h */
quot_true     : expand(ratsimp((f(x+h) - f(x))/h));   /* Step 2: 2a x + b + a h */
lim_true      : expand(ev(quot_true, h=0));           /* Step 3: 2a x + b */
fp_x0_true    : ev(lim_true, x=x0);                   /* Step 4: 2a x0 + b */
drop_term     : a*h;                                  /* the term that vanishes as h->0 */

/* Misconception targets. */
fxh_drop      : expand(a*(x^2 + h^2) + b*(x+h));      /* (x+h)^2 -> x^2+h^2 */
fxh_rote      : x^2 + 2*x*h + h^2;                    /* rote-copied (x+h)^2 from the f(x)=x^2 example: ignores a and b */
wrong_factor2 : a*x + b;                              /* forgot the factor of 2 */
wrong_usedf   : ev(f(x), x=x0);                       /* evaluated f(x0), not f'(x0) */

/* Consistent dropped-cross-term chain, for qtests. */
dq_drop  : expand(ratsimp((fxh_drop - f(x))/h));      /* b + a h */
lim_drop : expand(ev(dq_drop, h=0));                  /* b */
fp_drop  : ev(lim_drop, x=x0);                        /* b */

/* Step 4 substitution shown WITHOUT evaluating, e.g. 6*3-5 (for the worked
   solution). Assign under simp:false so the product and sum are left unevaluated;
   restore simp:true immediately afterwards. */
simp:false;
lim_sub : subst(x0, x, lim_true);
simp:true;]]></text>
    </questionvariables>
