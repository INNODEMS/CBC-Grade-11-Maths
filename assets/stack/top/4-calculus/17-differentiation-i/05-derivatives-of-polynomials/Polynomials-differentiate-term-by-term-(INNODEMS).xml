    <questionvariables>
      <text>/* f(x) = ca4 x^4 + ca3 x^3 + ca2 x^2 + ca1 x + ca0, every coefficient non-zero. */
ca4 : rand_with_prohib(-5, 5, [0]);
ca3 : rand_with_prohib(-6, 6, [0]);
ca2 : rand_with_prohib(-6, 6, [0]);
ca1 : rand_with_prohib(-9, 9, [0]);
ca0 : rand_with_prohib(-9, 9, [0]);
fx  : ca4*x^4 + ca3*x^3 + ca2*x^2 + ca1*x + ca0;
dfx : diff(fx, x);                                   /* model answer */

/* Common errors. */
w_const   : dfx + ca0;                               /* kept the constant term */
w_linear  : dfx - ca1 + ca1*x;                       /* left the linear term as ca1*x */
w_nolower : 4*ca4*x^4 + 3*ca3*x^3 + 2*ca2*x^2 + ca1*x;  /* multiplied by n but kept the power */
w_nomult  : ca4*x^3 + ca3*x^2 + ca2*x + ca1;        /* lowered the power but forgot to multiply by n */</text>
    </questionvariables>
