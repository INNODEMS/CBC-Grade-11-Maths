    <questionvariables>
      <text><![CDATA[/* Choose the two x-values r1 < r2 first, then build the cubic so that
   dy/dx - m = 3(x - r1)(x - r2).  r1 + r2 even keeps every coefficient an integer. */
cands : sublist(create_list([u1, u2, u3], u1, -4, 3, u2, -3, 4, u3, -6, 6),
  lambda([z], is(z[1] < z[2] and evenp(z[1] + z[2]) and z[1] + z[2] # 0 and z[3] # 0 and 3*z[1]*z[2] + z[3] # 0)));
pick : rand(cands);
rr1 : pick[1];
rr2 : pick[2];
mg  : pick[3];                         /* the target gradient m */
bq  : -3*(rr1 + rr2)/2;
cq  : 3*rr1*rr2 + mg;
dq  : rand_with_prohib(-5, 5, [0]);
fx  : x^3 + bq*x^2 + cq*x + dq;
dfx : diff(fx, x);                     /* model answer (a) */
ta2 : {rr1, rr2};                      /* model answer (b) */
w_sign : {-rr1, -rr2};                 /* sign slip when factorising */]]></text>
    </questionvariables>
