    <questionvariables>
      <text><![CDATA[/* y = k3 x^3 + k2 x^2 + k1 x + k0 and a point x = xp, chosen so that
   the curve fits on a small graph and f(xp), f'(xp) are different and non-zero. */
cands : sublist(
  create_list([a3, a2, a1, a0, x0], a3, [-1, 1], a2, -3, 3, a1, -4, 4, a0, -3, 3, x0, [-2, -1, 1, 2]),
  lambda([z], block([fv, gv],
    fv : z[1]*z[5]^3 + z[2]*z[5]^2 + z[3]*z[5] + z[4],
    gv : 3*z[1]*z[5]^2 + 2*z[2]*z[5] + z[3],
    is(abs(fv) <= 8 and gv # 0 and gv # fv and abs(gv) <= 15
       and z[2] # 0 and z[3] # 0 and z[4] # 0))));
pick : rand(cands);
k3 : pick[1];
k2 : pick[2];
k1 : pick[3];
k0 : pick[4];
xp : pick[5];
fx  : k3*x^3 + k2*x^2 + k1*x + k0;
dfx : diff(fx, x);              /* model answer (a) */
yp  : subst(xp, x, fx);         /* height of P */
gp  : subst(xp, x, dfx);        /* model answer (b) */
w_nolower : 3*k3*x^3 + 2*k2*x^2 + k1*x;   /* kept the powers */
w_const   : dfx + k0;                      /* kept the constant */]]></text>
    </questionvariables>
