    <questionvariables>
      <text><![CDATA[a: rand(5)+2;
b: rand_with_prohib(2,6,[a]);
f: a*x^2+b;
/* domain of function */
leftend:-3;
rightend:3;
ta6: -3<= x nounand x<= 3;

fatneg3: ev(f,x=-3);
fatneg2: ev(f,x=-2);
ta2: ev(f,x=-1);
ta3: ev(f,x=0);
ta4: ev(f,x=1);
ta5: ev(f,x=2);
fat3: ev(f,x=3);

/* range */
ta7: ta3<=y nounand y<=fat3;

/* Diagnostics: b-a # a+b since a >= 2; y>=b # ta7. */
wrong2: b-a;                   /* treated (-1)^2 as -1 */
wrong7: y>=ta3;                /* range over all real x: ignored the restricted domain */
validate_x(ex) := if every(lambda([w], member(w, [x])), listofvars(ex)) then "" else "Use only the variable x.";
validate_y(ex) := if every(lambda([w], member(w, [y])), listofvars(ex)) then "" else "Use only the variable y.";

/* Distractor graphs: reflection, and vertical shifts by f(a/2) */
shiftv: ev(f,x=a/2);
c_funcs: [f];
w_funcs: [-f, f-shiftv, -f+shiftv];
/* Choose functions to plot */
funcs: append(c_funcs, rand_selection(w_funcs,3));
/* permute the graphs but keep note of which ones are right! */
reordering:random_permutation([1,2,3,4]);
fntoletter:zip_with("[",reordering,[A,B,C,D]);
/* apply the reordering to produce the shuffled list of options */
funcstoplot: makelist(funcs[reordering[i]],i,1,4);
corr:maplist(lambda([ex],assoc(ex,fntoletter)), [1,2,3,4]);
ta1:maplist(lambda([ex],[ex, is(ex=assoc(1,fntoletter))]), [A,B,C,D]);
/* Plot exactly the domain -3 <= x <= 3. Every plotted function is c1*x^2+c0, so its extremes
   on the domain are at x=0 and x=3; the shared y-window covers all four graphs (and y=0),
   padded and rounded out to a multiple of the tick step (so y=0 is a tick), so the range
   maximum f(3) is always visible. */
plotvals: append([0], flatten(map(lambda([g], [ev(g,x=0), ev(g,x=3)]), funcstoplot)));
yhi: lmax(plotvals)+2;
ylo: lmin(plotvals)-2;
ystep: if yhi-ylo <= 60 then 10 else 20;
ymax: ystep*ceiling(yhi/ystep);
ymin: ystep*floor(ylo/ystep);
thumbnailplot:lambda([ex1,ex2],plot(ex1,[x,leftend,rightend],[y,ymin,ymax],[box, false],[yx_ratio, 0.7],[xtics, leftend, 1, rightend],[ytics, ymin, ystep, ymax],[axes, solid],[size,240,240],[plottags,false],[alt,ex2]));]]></text>
    </questionvariables>
