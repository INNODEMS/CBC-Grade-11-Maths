      <text><![CDATA[a : rand_with_prohib(-5,5,[0]);
h : rand_with_prohib(-6,6,[]);
k : rand_with_prohib(-6,6,[h]);         /* k # h, so the "used h" diagnostic never equals the answer */
fdisp : a*(x-h)^2+k;                    /* display expression: no "1(x - -3)^2 + -4" */
opens_up : is(a>0);
/* dropdown: literal values, plain-text Unicode labels (LaTeX does not render in a dropdown) */
ge_opt : "ge"; le_opt : "le";
opts : [[ge_opt, opens_up, "≥"],[le_opt, not opens_up, "≤"]];
ta_sym : if opens_up then ge_opt else le_opt;
ta_val : k;
wrong_val : h;                          /* used the x-coordinate of the vertex instead of the y-value */
range_ineq : if opens_up then y>=k else y<=k;
ytop : if opens_up then k+10 else k+2;  /* graph window in the worked solution */
ybot : if opens_up then k-2 else k-10;]]></text>
    </questionvariables>
