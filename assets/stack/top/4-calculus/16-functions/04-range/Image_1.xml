    <questionvariables>
      <text><![CDATA[n1:rand_with_step(1, 4, 1);
n2:rand_with_step(-9, 9, 1);
rhs:expand((x+n1)^2+n2);
f1:f(x)=rhs;
correctanswer:y >= n2;
/* Diagnostics: both differ from correctanswer on every seed (n1 >= 1). */
wrong_strict:y > n2;            /* excluded the minimum, which is attained at x = -n1 */
wrong_yint:y >= n1^2+n2;        /* took the constant term f(0) as the minimum */
validate_y(ex) := if every(lambda([w], member(w, [y])), listofvars(ex)) then "" else "Use only the variable y.";]]></text>
