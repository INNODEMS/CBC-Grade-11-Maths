    <questionvariables>
      <text><![CDATA[a : rand_with_prohib(-6,6,[0]);    /* a # 0, so the vertex is never on the y-axis */
b : rand_with_prohib(-6,6,[0]);         /* b # 0, so the "forgot the shift" and "flipped sign" diagnostics never equal b */
gdisp : abs(x-a)+b;                     /* display expression: no "x - -3" or "+ -4" */
ta : b;
wrong_shift : 0;                        /* forgot the vertical shift entirely */
wrong_sign : -b;                        /* flipped the sign of the shift */]]></text>
    </questionvariables>
