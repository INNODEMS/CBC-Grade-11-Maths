    <questionvariables>
      <text>/* (a) linear f(x) = a2*x + a1, a1 in 1..9, a2 in 2..9 */
a1: 1+rand(9);
a2: 2+rand(8);
aa: a2*x + a1;
Ansa: (x - a1)/a2;
/* Diagnostics for (a): reciprocal 1/f(x), and undoing the steps in the wrong order.
   Neither can equal Ansa: the first is not a polynomial, the second differs because a2 is at least 2. */
diag1r: 1/aa;
diag1o: x/a2 - a1;
/* (b) f(x) = x or -x, a self-inverse function */
b1: rand([-1,1]);
bb: b1*x;
Ansb: (1/b1)*x;
/* (c) f(x) = kc*x with |kc| in 21..40 */
c1: 21+rand(20);
kc: -b1*c1;
cc: kc*x;
Ansc: x/kc;
/* (d) f(x) = d1/(x + d2) */
d1: 1+rand(4);
d2: 1+rand(4);
dd: d1/(x + d2);
Ansd: (d1 - d2*x)/x;</text>
    </questionvariables>
