    <questionvariables>
      <text><![CDATA[m: rand_with_prohib(-6,6,[-1,0,1]);
b: rand_with_prohib(-9,9,[0]);
fx: m*x + b;
fy: m*y + b;
ta: (x-b)/m;
validate_x(ex) := if every(lambda([v], member(v, [x])), listofvars(ex)) then "" else "Write your answer in terms of x only.";
/* Diagnostics (pairwise distinct and distinct from ta, since m is not 0 or 1 or -1 and b is not 0):
   divided only x by m; sign error moving b across; the reciprocal 1/f(x) read as the inverse. */
wrong_notdist: x/m - b;
wrong_signb: (x+b)/m;
wrong_recip: 1/(m*x+b);]]></text>
    </questionvariables>
