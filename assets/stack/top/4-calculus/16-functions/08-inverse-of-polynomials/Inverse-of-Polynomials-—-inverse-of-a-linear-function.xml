    <questionvariables>
      <text>m : rand_with_prohib(-6,6,[0,1,-1]);
b : rand_with_prohib(-9,9,[0]);
ta : (x-b)/m;
wrong_noswap : m*x+b;                    /* just isolated x without swapping x and y - actually gives back f, catch differently */
wrong_reciprocal : x/m - b;              /* divided by m but forgot to also divide b by m (didn't distribute correctly) */
wrong_signb : (x+b)/m;                   /* sign error moving b to the other side */</text>
    </questionvariables>
