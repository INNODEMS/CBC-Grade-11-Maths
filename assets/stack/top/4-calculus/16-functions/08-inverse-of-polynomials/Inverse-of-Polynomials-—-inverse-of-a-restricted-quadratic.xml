    <questionvariables>
      <text><![CDATA[/* h and k are nonzero and distinct (and k+1 is not h, so the generic test value k+1 never hits the diagnostic), so every diagnostic is distinct from the answer and from each other */
h: rand_with_prohib(-6,6,[0]);
k: rand_with_prohib(-6,6,[0,h,h-1]);
fx: (x-h)^2 + k;
fy0: (x-h)^2 + k;
fy: (y-h)^2 + k;
ta1: h + sqrt(x-k);
ta2: k;
validate_x(ex) := if every(lambda([v], member(v, [x])), listofvars(ex)) then "" else "Write your answer in terms of x only.";
/* prt1 diagnostics: minus branch; forgot to add h; swapped the roles of h and k */
wrong_branch: h - sqrt(x-k);
wrong_noshift: sqrt(x-k);
wrong_swaphk: k + sqrt(x-h);
/* prt2 diagnostic: gave the domain of f instead of the domain of the inverse */
wrong_dom: h;
/* board limits for the figure: square box containing both curves */
bmin: min(h,k) - 2;
bmax: max(h,k) + 10;]]></text>
