    <questionvariables>
      <text><![CDATA[a  : rand_with_prohib(1,5,[]);
b  : rand_with_prohib(1,5,[]);
c  : rand_with_prohib(1,5,[]);
d  : rand_with_prohib(1,5,[]);
ff : rand_with_prohib(1,5,[]);
g  : rand_with_prohib(1,5,[]);
h  : rand_with_prohib(1,5,[]);
scenario : rand(3);                        /* 0 = even, 1 = odd, 2 = neither */
e1 : if scenario=0 then 1 elseif scenario=1 then 0 else 1;
e2 : if scenario=0 then 0 elseif scenario=1 then 1 else 1;
numer : e1*(a*x^4+b*x^2+c) + e2*(d*x^3+ff*x);
denom : g*x^2+h;
expr : numer/denom;
fnegx : ratsimp(subst(x=-x,expr));
is_even : is(ratsimp(fnegx-expr)=0);
is_odd  : is(ratsimp(fnegx+expr)=0);
even_opt : "even"; odd_opt : "odd"; neither_opt : "neither";
classatom  : if is_even then even_opt elseif is_odd then odd_opt else neither_opt;
classlabel : if is_even then "Even" elseif is_odd then "Odd" else "Neither";
classopts  : [[even_opt, is_even, "Even"],[odd_opt, is_odd, "Odd"],[neither_opt, not(is_even) and not(is_odd), "Neither"]];
/* common wrong substitutions for part (a) */
wrong_noflip    : expr;                                              /* forgot to substitute at all */
wrong_overflip  : -expr;                                             /* flipped every term, even the even-power ones */
wrong_constflip : (e1*(a*x^4+b*x^2-c)+e2*(d*x^3+ff*x))/denom;        /* wrongly flipped the sign of the constant term */]]></text>
    </questionvariables>
    <specificfeedback format="html">
