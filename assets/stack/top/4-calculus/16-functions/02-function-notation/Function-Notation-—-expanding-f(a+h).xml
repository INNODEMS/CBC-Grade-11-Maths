    <questionvariables>
      <text>p : rand_with_prohib(1,5,[]);
q : rand_with_prohib(1,9,[]);
r : rand_with_prohib(1,9,[]);
fx : p*x^2+q*x+r;
ta : expand(subst(x=a+h,fx));
wrong_linear : expand(subst(x=a,fx)) + expand(subst(x=h,fx));   /* f(a+h) = f(a)+f(h) misconception */</text>
    </questionvariables>
