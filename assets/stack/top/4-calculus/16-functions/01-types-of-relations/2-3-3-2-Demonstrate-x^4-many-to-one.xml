    <questionvariables>
      <text><![CDATA[/* Construct-an-example item: the PRT checks the property (x1 # x2, y = f(x), y1 = y2),
   so any valid pair scores. Fixed function, so no randomisation; the model pair is only for the worked solution. */
p: x^4;
tax1: 2;
tax2: -2;
tay1: ev(p, x=tax1);
/* Reject complex entries (i, %i, sqrt(-1)): with complexno=i they would otherwise
   give x1=i, x2=1 a shared output of 1. The question is about real inputs. */
validate_real(ex) := if freeof(%i, ev(rectform(ex), simp)) then "" else "Enter a real number. Complex numbers such as i are not allowed here.";]]></text>
    </questionvariables>
