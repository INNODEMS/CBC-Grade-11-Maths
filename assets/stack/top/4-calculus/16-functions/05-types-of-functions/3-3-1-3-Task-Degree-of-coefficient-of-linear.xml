    <questionvariables>
      <text><![CDATA[/* p(x) = aa*x + bb is linear; the quadratic is (x+dd)*p(x) expanded */
dd: rand(3)+2;
aa: rand(3)+2;
bb: rand(10)+5;
d1: aa*dd + bb;
d2: bb*dd;
pol: aa*x^2 + d1*x + d2;
px: aa*x + bb;
ta1: 1;
ta2: aa;
/* Diagnostics: degree 2 (p has the same degree as the product); d1 is the
   x-coefficient of the quadratic, not of p. d1 >= 9 > aa, so never equal. */
wrong_deg: 2;
wrong_coef: d1;]]></text>
    </questionvariables>
