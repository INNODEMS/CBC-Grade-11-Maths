    <questionvariables>
      <text><![CDATA[/* Cubic f(x) = a*x^3 with a positive integer coefficient, a in 2..6 */
a: rand(5)+2;
f: a*x^3;
fatneg3: ev(f,x=-3);
fatneg2: ev(f,x=-2);
ta2: ev(f,x=-1);
ta3: ev(f,x=0);
ta4: ev(f,x=1);
ta5: ev(f,x=2);
fat3: ev(f,x=3);
/* Diagnostic for f(-1): sign error, treating (-1)^3 as +1. Never equals ta2 because a is non-zero. */
diag2: -ta2;
/* Distractor graphs: other function types or a clearly shifted cubic, all genuinely different from f */
c_funcs: [f];
w_funcs: [-a*x^3, a*x^2, a*x, a*x^3-10];
funcs: append(c_funcs, rand_selection(w_funcs,3));
/* Permute the graphs but keep note of which one is right */
reordering: random_permutation([1,2,3,4]);
fntoletter: zip_with("[",reordering,[A,B,C,D]);
funcstoplot: makelist(funcs[reordering[i]],i,1,4);
ta1: maplist(lambda([ex],[ex, is(ex=assoc(1,fntoletter))]), [A,B,C,D]);
thumbnailplot: lambda([ex1,ex2],plot(ex1,[x,-5,5],[y,-30,30],[box,false],[yx_ratio,0.7],[xtics,-5,1,5],[ytics,-30,15,30],[axes,solid],[size,240,240],[plottags,false],[alt,ex2]));]]></text>
    </questionvariables>
    <specificfeedback format="html">
      <text/>
    </specificfeedback>
    <questionnote format="html">
      <text>f(x) = {@f@}. Graphs A to D show {@funcstoplot@}; the correct graph is {@first(mcq_correct(ta1))@}.</text>
