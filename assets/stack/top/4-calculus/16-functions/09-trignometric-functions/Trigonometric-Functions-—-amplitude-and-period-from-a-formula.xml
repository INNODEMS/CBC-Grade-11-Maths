    <questionvariables>
      <text><![CDATA[amp: rand([-1,1])*rand_with_prohib(2,6,[]);
b: rand_with_prohib(2,5,[]);
trig: rand(2);   /* 0 sine, 1 cosine */
fx: if trig = 0 then amp*sin(b*x) else amp*cos(b*x);
ta_amp: abs(amp);
ta_period: 2*%pi/b;
validate_numeric(ex) := block([sx], sx: ev(ex, simp), if listofvars(ex) = [] and freeof(%i, sx) then "" else "Enter a real number, not an expression containing a letter, a variable or i.");
/* amplitude diagnostics: a negative amplitude; peak-to-trough height 2|A| */
wrong_amp_neg: -abs(amp);
wrong_amp_double: 2*abs(amp);
/* period diagnostics: multiplied by B; dropped the 2; worked in degrees. All distinct from 2*pi/b for b in 2..5. */
wrong_period: 2*%pi*b;
wrong_period2: %pi/b;
wrong_period_deg: 360/b;]]></text>
    </questionvariables>
