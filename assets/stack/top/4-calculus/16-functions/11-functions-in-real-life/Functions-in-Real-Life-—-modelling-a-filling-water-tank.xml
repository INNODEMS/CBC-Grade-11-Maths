    <questionvariables>
      <text><![CDATA[/* start >= 10 > rate, so the swapped model never coincides with the correct one */
start: rand_with_prohib(10,50,[]);
rate: rand_with_prohib(2,9,[]);
tval: rand_with_prohib(3,12,[]);
Vfun: start + rate*t;
ta1: Vfun;
ta2: subst(t=tval, Vfun);
validate_t(ex) := if every(lambda([v], member(v, [t])), listofvars(ex)) then "" else "Write your answer in terms of t only.";
/* prt1 diagnostics: swapped the rate and the starting amount; left out the starting amount */
wrong_swapped: rate + start*t;
wrong_nostart: rate*t;
/* prt2 diagnostic: value without the starting amount */
wrong_nostart_val: rate*tval;]]></text>
    </questionvariables>
