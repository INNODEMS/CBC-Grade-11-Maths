    <questionvariables>
      <text><![CDATA[/* perimeter is a multiple of 4, so the best width P/4 and the maximum area P^2/8 = 2*kk^2 are whole numbers */
kk: rand_with_prohib(5,20,[]);
perimeter: 4*kk;
Afun: w*(perimeter-2*w);
Aexpand: expand(Afun);
wvertex: -coeff(Aexpand,w,1)/(2*coeff(Aexpand,w,2));
ta: subst(w=wvertex, Afun);
/* Diagnostics (distinct from ta = 2*kk^2 and from each other for kk >= 5):
   the best width; the best length; a square fenced on all four sides */
wrong_vertexw: wvertex;
wrong_length: perimeter - 2*wvertex;
wrong_square: (perimeter/4)^2;]]></text>
    </questionvariables>
