    <questionvariables>
      <text>/* Randomize payout and claim rates to ensure exact integer expected values */
payout : rand([100000, 150000, 200000, 250000, 300000, 400000, 500000]);
claim_rate : rand([2, 4, 5, 8, 10, 12, 15]);

/* The prob_claim is claim_rate / 1000. 
   Because payout has at least 5 zeros, expected_payout is always an exact integer. */
expected_payout : (payout * claim_rate) / 1000;

/* Generate a premium that guarantees a realistic positive expected profit margin */
profit_margin : rand([500, 800, 1000, 1200, 1500, 2000, 2500]);
premium : expected_payout + profit_margin;

/* Scale of operations */
num_policies : rand([500, 1000, 1200, 1500, 2000, 2500, 5000]);

/* Target Answers */
ta1 : expected_payout;
ta2 : profit_margin; /* By definition: premium - expected_payout */
ta3 : ta2 * num_policies;

/* Distractors */
ta1_wrong_complement : (payout * (1000 - claim_rate)) / 1000; /* Calculated payout for NOT having a fire */
ta2_wrong_max_loss : premium - payout; /* Assumed profit was premium minus the maximum possible payout instead of expected */
ta3_wrong_revenue : premium * num_policies; /* Calculated total revenue instead of total profit */</text>
    </questionvariables>
