    <questionvariables>
      <text>/* Randomize variables to ensure clean integer payouts */
total_tickets : rand([500, 1000, 2000, 2500, 5000]);
ticket_cost : rand([50, 100, 150, 200]);

/* Ensure the prize guarantees an integer Expected Value */
multiplier : rand([4, 5, 6, 8]); /* e.g., EV is 4 to 8 times smaller than cost */
expected_gross : ticket_cost * multiplier / 10; /* Gives clean integers like 20, 25, 40 */
prize_amount : expected_gross * total_tickets;

/* Targets */
ta1 : 1 / total_tickets;
ta2 : expected_gross;
ta3 : ta2 - ticket_cost; /* Will always be negative */

/* Distractors */
ta3_wrong_positive : ticket_cost - ta2; /* Forgot the negative sign / flipped subtraction */
ta3_wrong_prize : prize_amount - ticket_cost; /* Calculated net return IF they win, not the EXPECTED net return */</text>
    </questionvariables>
