    <questionvariables>
      <text><![CDATA[/* Randomize frequencies using explicit lists to generate over 10,000 unique variants */
f0 : rand([2, 3, 4, 5, 6, 7, 8]);
f1 : rand([10, 12, 14, 16, 18, 20]);
f2 : rand([22, 24, 26, 28, 30, 32]);
f3 : rand([11, 13, 15, 17, 19, 21]);
f4 : rand([3, 4, 5, 6, 7, 8, 9]);

/* Total observations */
tot : f0 + f1 + f2 + f3 + f4;

/* Calculate probabilities */
p_eq_3 : f3 / tot;

/* P(X < 3) means X = 0, 1, 2 */
p_less_3 : (f0 + f1 + f2) / tot;

/* Distractor for P(X <= 3) which incorrectly includes 3 */
p_less_eq_3 : (f0 + f1 + f2 + f3) / tot;

/* Target answers */
ta1 : tot;
ta2 : p_eq_3;
ta3 : p_less_3;]]></text>
    </questionvariables>
