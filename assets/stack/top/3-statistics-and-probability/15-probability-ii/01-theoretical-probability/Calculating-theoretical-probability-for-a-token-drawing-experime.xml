    <questionvariables>
      <text><![CDATA[/* Randomize token counts using explicit lists for maximum compatibility */
num_red : rand([5, 6, 7, 8, 9, 10, 11, 12]);
num_blue : rand([5, 6, 7, 8, 9, 10, 11, 12]);
total_tokens : num_red + num_blue;

/* Randomize total drawn and ensure a split requirement safely */
draw_total : rand([3, 4, 5]);
req_red_temp : rand([1, 2, 3]);

/* Ensure req_red is strictly less than draw_total so blue tokens are also required */
req_red : if req_red_temp >= draw_total then draw_total - 1 else req_red_temp;
req_blue : draw_total - req_red;

/* Maxima uses binomial(n, k) for the combinations function nCr */
n_S : binomial(total_tokens, draw_total);
red_comb : binomial(num_red, req_red);
blue_comb : binomial(num_blue, req_blue);
n_E : red_comb * blue_comb;

/* Calculate the final probability */
prob : n_E / n_S;

/* Target answers */
ta1 : n_S;
ta2 : n_E;
ta3 : prob;]]></text>
    </questionvariables>
