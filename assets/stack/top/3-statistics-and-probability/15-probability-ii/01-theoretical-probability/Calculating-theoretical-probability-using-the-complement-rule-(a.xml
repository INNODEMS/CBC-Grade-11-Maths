    <questionvariables>
      <text>/* Randomize student counts to guarantee many unique variants */
num_actors : rand_with_step(5, 10, 1);
num_singers : rand_with_step(5, 10, 1);
total_pop : num_actors + num_singers;

/* Randomize total drawn */
select_n : rand([3, 4, 5]);

/* Maxima uses binomial(n, k) for the combinations function nCr */
n_S : binomial(total_pop, select_n);

/* The complement event: picking NO actors means picking ALL singers */
n_none : binomial(num_singers, select_n);

/* Calculate probabilities */
prob_none : n_none / n_S;
prob_at_least_one : 1 - prob_none;

/* Target answers */
ta1 : n_S;
ta2 : n_none;
ta3 : prob_at_least_one;</text>
    </questionvariables>
