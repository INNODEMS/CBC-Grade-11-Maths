    <questionvariables>
      <text>/* Randomize seat counts safely using explicit lists */
num_window : rand([3, 4, 5, 6]);
num_aisle : rand([4, 5, 6, 7]);
total_seats : num_window + num_aisle;

/* Randomize boarding passengers and required split */
board_pass : rand([3, 4]);

/* Ensure required window seats is physically possible and forces a split */
req_window : rand([1, 2]);
req_aisle : board_pass - req_window;

/* Maxima uses binomial(n, k) for the combinations function nCr */
n_S : binomial(total_seats, board_pass);
window_comb : binomial(num_window, req_window);
aisle_comb : binomial(num_aisle, req_aisle);
n_E : window_comb * aisle_comb;

/* Calculate the final probability */
prob : n_E / n_S;

/* Target answers */
ta1 : n_S;
ta2 : n_E;
ta3 : prob;</text>
    </questionvariables>
