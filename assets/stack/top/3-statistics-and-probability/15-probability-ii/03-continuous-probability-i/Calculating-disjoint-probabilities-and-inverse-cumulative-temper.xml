    <questionvariables>
      <text><![CDATA[/* Randomize bounds for the uniform temperature distribution */
a : rand([18, 19, 20, 21, 22]);
w : rand([10, 12, 14, 15, 16, 20]);
b : a + w;

/* Part a: Disjoint probabilities */
offset1 : rand([2, 3, 4]);
c : a + offset1; 
offset2 : rand([2, 3, 4]);
d : b - offset2; 

prob_less_c : (c - a) / w;
prob_greater_d : (b - d) / w;
ta1 : prob_less_c + prob_greater_d;

/* Part b: Inverse probability targets */
target_prob_list : [1/4, 1/3, 1/2, 2/3, 3/4, 1/5, 2/5, 3/5, 4/5];
target_prob_tex_list : ["1/4", "1/3", "1/2", "2/3", "3/4", "1/5", "2/5", "3/5", "4/5"];

idx : rand([1, 2, 3, 4, 5, 6, 7, 8, 9]);
target_prob_num : target_prob_list[idx];
target_prob_str : target_prob_tex_list[idx];
target_prob_tex : target_prob_num;

/* Calculate t: (t - a) / w = p  =>  t = a + p * w */
ta2 : a + target_prob_num * w;

/* Distractors for targeted PRT feedback */
ta1_wrong : prob_less_c * prob_greater_d;
ta2_wrong : target_prob_num * w;]]></text>
    </questionvariables>
