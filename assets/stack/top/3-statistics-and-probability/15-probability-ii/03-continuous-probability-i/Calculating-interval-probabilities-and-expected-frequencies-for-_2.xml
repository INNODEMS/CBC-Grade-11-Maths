    <questionvariables>
      <text><![CDATA[/* Randomize bounds for the uniform weight distribution */
a : rand([385, 390, 392, 395]);
w : rand([20, 24, 25, 30, 35]);
b : a + w;

/* Randomize the quality control cutoff */
offset : rand([5, 8, 10, 12, 15]);
c : a + offset;

/* Calculate exact probability for part a */
prob_accept : (b - c) / w;
ta1 : prob_accept;

/* Force N to be a multiple of the width so the expected value is always a perfect integer */
N_mult : rand([10, 12, 15, 20, 25, 30]);
N : N_mult * w;

/* Calculate expected frequency */
ta2 : N * prob_accept;

/* Distractors for targeted PRT feedback */
ta1_wrong : (c - a) / w; /* Calculated P(W < c) instead of P(W >= c) */
ta2_wrong : ta1; /* Entered the probability again instead of multiplying by N */]]></text>
    </questionvariables>
