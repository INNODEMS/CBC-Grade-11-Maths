      <text><![CDATA[/* Master arrays to strictly enforce float-safe exact rational math and high variance */
num_A_list : [45, 50, 55, 60, 65, 70, 75, 80];
str_A_list : ["0.45", "0.50", "0.55", "0.60", "0.65", "0.70", "0.75", "0.80"];
idx_A : rand([1, 2, 3, 4, 5, 6, 7, 8]);
num_A : num_A_list[idx_A];
str_A : str_A_list[idx_A];

num_B_list : [42, 48, 52, 58, 62, 68, 72, 78];
str_B_list : ["0.42", "0.48", "0.52", "0.58", "0.62", "0.68", "0.72", "0.78"];
idx_B : rand([1, 2, 3, 4, 5, 6, 7, 8]);
num_B : num_B_list[idx_B];
str_B : str_B_list[idx_B];

/* Exact fractional calculations */
P_A : num_A / 100;
P_B : num_B / 100;

ta1 : P_A * P_B;
ta2 : P_A + P_B - ta1;
ta3 : ta2 - ta1;

/* Complement strings for the alternative solution method */
comp_A_str : float(1 - P_A);
comp_B_str : float(1 - P_B);

/* Strings for display in worked solution */
ta1_str : float(ta1);
ta2_str : float(ta2);
ta3_str : float(ta3);

/* Distractors for specific PRT feedback */
ta2_wrong : P_A + P_B; /* Forgot to subtract intersection */
ta3_wrong_path1 : P_A * (1 - P_B); /* Only counted one pathway */
ta3_wrong_path2 : (1 - P_A) * P_B; /* Only counted the other pathway */]]></text>
