    <questionvariables>
      <text>/* Construct class sizes using independent blocks to guarantee math consistency and high variance */
Only_B : rand([12, 15, 18, 20, 24, 25]);
Only_C : rand([14, 16, 22, 26, 28, 30]);
Both : rand([5, 6, 8, 10, 12, 14]);
Neither : rand([2, 4, 5, 7, 9, 11]);

/* Derive the explicit values used in the question text */
B : Only_B + Both;
C : Only_C + Both;
Total : Only_B + Only_C + Both + Neither;

/* Calculate target answers using exact fractions */
ta1 : Both / C;
ta2 : Both / B;

/* Distractors for specific PRT feedback */
ta1_wrong : Both / Total;
ta2_wrong : Both / Total;</text>
    </questionvariables>
