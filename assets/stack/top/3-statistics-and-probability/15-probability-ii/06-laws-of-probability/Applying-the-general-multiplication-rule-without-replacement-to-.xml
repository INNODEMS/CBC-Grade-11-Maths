    <questionvariables>
      <text>/* Randomize counts broadly to prevent STACK cache collisions */
num_B : rand([8, 10, 12, 14, 15, 18, 20]);
num_G : rand([6, 9, 11, 13, 16, 17, 19]);

/* Calculate totals for stage 1 and stage 2 */
total1 : num_B + num_G;
total2 : total1 - 1;
num_G_minus_1 : num_G - 1;

/* Calculate target probabilities using exact fractional math */
ta1 : num_G / total1;
ta2 : num_G_minus_1 / total2;
ta3 : ta1 * ta2;

/* Distractors for PRT checks */
ta2_wrong : num_G / total1; /* Did not account for without replacement */
ta3_wrong : ta1 * ta2_wrong; /* Multiplied independent events instead of dependent */</text>
    </questionvariables>
