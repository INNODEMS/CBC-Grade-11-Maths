    <questionvariables>
      <text><![CDATA[/* Randomize the total number of cards broadly */


/* Define the divisors ensuring they share no common factors so the intersection is strictly their product */
d1 : rand([2, 3]);
d2_opts : if d1=2 then [3, 5, 7, 9] else [2, 4, 5, 7, 8];
d2 : rand(d2_opts);
d_int : d1 * d2;
/* Half the variants use a pack that is a multiple of d1*d2 (then A and B are independent) */
indep_mode : rand(2);
N_other : sublist([20, 25, 30, 35, 40, 45, 50, 60, 75, 100], lambda([n], mod(n, d_int) # 0));
N : if indep_mode = 1 then d_int*rand([2, 3, 4]) else rand(N_other);

/* Calculate the sizes of each set using exact integer division (floor) to prevent float evaluation */
size_A : floor(N / d1);
size_B : floor(N / d2);
size_int : floor(N / d_int);

/* Target answers using exact fractional logic */
P_A : size_A / N;
P_B : size_B / N;

ta1 : size_int / N;
ta2 : P_A * P_B;
ta3 : P_A + P_B - ta1;

/* Feedback text logic for the worked solution */
is_indep : if ta1 = ta2 then true else false;
indep_sign : if is_indep then "=" else "\\neq";
indep_text : if is_indep then "independent" else "dependent";

/* Distractors */
ta3_wrong : P_A + P_B; /* Forgot to subtract intersection */
/* Part d: classify (dropdown) */
ta4 : [[indep, is_indep, "Yes, A and B are independent"], [dep, not is_indep, "No, A and B are not independent"]];
ta4v : if is_indep then indep else dep;
ta4w : if is_indep then dep else indep;]]></text>
    </questionvariables>
