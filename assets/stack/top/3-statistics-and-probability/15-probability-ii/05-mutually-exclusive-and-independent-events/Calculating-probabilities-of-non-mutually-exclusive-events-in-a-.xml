    <questionvariables>
      <text><![CDATA[/* Randomize school name */
school : rand(["St. Jude Seregeya Secondary", "Aligula Secondary", "Eshikulu Girls High", "Tumaini Secondary", "Mlimani High", "Amani Academy"]);

/* Construct the groups systematically to guarantee mathematical consistency */
/* Expanded arrays to prevent STACK variant cache collisions */
R_only : rand([10, 11, 12, 14, 15, 17, 18, 20, 22, 25]);
F_only : rand([8, 9, 11, 13, 16, 19, 21, 23, 24]);
B : rand([4, 5, 6, 7, 8, 9, 10]);
neither : rand([2, 3, 4, 5, 8, 10, 12]);

/* Calculate totals based on the distinct components */
N : R_only + F_only + B + neither;
R : R_only + B;
F : F_only + B;

/* Target answers using exact fractional logic */
ta1 : B / N;
ta2 : (R + F - B) / N;
ta3 : (R_only + F_only) / N;

/* Distractors for specific PRT feedback */
ta2_wrong : (R + F) / N; /* Forgot to subtract the intersection */]]></text>
    </questionvariables>
