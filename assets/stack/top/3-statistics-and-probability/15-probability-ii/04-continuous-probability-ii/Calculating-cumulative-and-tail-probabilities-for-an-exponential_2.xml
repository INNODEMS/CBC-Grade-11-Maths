    <questionvariables>
      <text><![CDATA[/* Randomize the lambda denominator to ensure clean math and massive variance */
lam_den : rand([2, 4, 5, 10, 20, 25, 50]);
mean_val : lam_den;

/* Create an exact rational for STACK math, and a string for display */
lam_frac : 1 / lam_den;
lam_str : if lam_den = 2 then "0.5" elseif lam_den = 4 then "0.25" elseif lam_den = 5 then "0.2" elseif lam_den = 10 then "0.1" elseif lam_den = 20 then "0.05" elseif lam_den = 25 then "0.04" else "0.02";

/* Randomize targets ensuring the resulting exponent is a clean integer */
k_a : rand([1, 2, 3, 4, 5, 6]);
x_a : lam_den * k_a;
power_a : k_a;

k_b : k_a + rand([1, 2, 3, 4]);
x_b : lam_den * k_b;
power_b : k_b;

/* Target answers using exact algebra */
ta1 : 1 - exp(-power_a);
ta2 : exp(-power_b);

/* Distractors for PRT checks */
ta1_wrong : exp(-power_a);
ta2_wrong : 1 - exp(-power_b);]]></text>
    </questionvariables>
