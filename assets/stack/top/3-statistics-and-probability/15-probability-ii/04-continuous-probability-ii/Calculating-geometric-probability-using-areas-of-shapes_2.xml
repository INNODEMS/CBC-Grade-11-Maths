    <questionvariables>
      <text><![CDATA[/* Randomize dimensions for massive variance */
s : rand([16, 18, 20]);   /* s >= 16 keeps the corner pen clear of the circle */

/* Ensure radius strictly fits well within the square without overlapping logic */
r : rand([3, 4, 5]);   /* r = 2 would make the circumference 2*pi*r equal the area pi*r^2 */

/* Dimensions for the rectangular pen */
w : rand([2, 3, 4]);
h : rand([2, 3, 4]);

/* Calculate target answers */
ta1 : s^2;
ta2 : pi * r^2;
ta3 : ta2 / ta1;

/* Distractor for part b: multiplying by 2 instead of squaring */
ta2_wrong : 2 * pi * r;
/* Part d: the region outside both the circle and the pen (they do not overlap) */
ta4 : 1 - (pi*r^2 + w*h)/s^2;
ta4_nopen : 1 - pi*r^2/s^2;          /* forgot the pen */
ta4_nocomp : (pi*r^2 + w*h)/s^2;     /* forgot to take the complement */]]></text>
    </questionvariables>
