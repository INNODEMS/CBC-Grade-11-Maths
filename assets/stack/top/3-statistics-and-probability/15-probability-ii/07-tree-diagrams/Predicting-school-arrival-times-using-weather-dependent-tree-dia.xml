    <questionvariables>
      <text><![CDATA[/* Master arrays expanded to guarantee 100 unique variants (5 x 5 x 4) */
idx_R : rand([1, 2, 3, 4, 5]);
num_R_list : [20, 25, 30, 35, 40];
str_R_list : ["0.20", "0.25", "0.30", "0.35", "0.40"];
num_R : num_R_list[idx_R];
str_R : str_R_list[idx_R];

idx_LR : rand([1, 2, 3, 4, 5]);
num_LR_list : [50, 55, 60, 65, 70];
str_LR_list : ["0.50", "0.55", "0.60", "0.65", "0.70"];
num_LR : num_LR_list[idx_LR];
str_LR : str_LR_list[idx_LR];

idx_LNR : rand([1, 2, 3, 4]);
num_LNR_list : [5, 10, 15, 20];
str_LNR_list : ["0.05", "0.10", "0.15", "0.20"];
num_LNR : num_LNR_list[idx_LNR];
str_LNR : str_LNR_list[idx_LNR];

/* Exact internal calculations */
P_R : num_R / 100;
P_NR : 1 - P_R;

P_LR : num_LR / 100;
P_LNR_given_R : 1 - P_LR;

P_LNR : num_LNR / 100;
P_NL_given_NR : 1 - P_LNR;

/* Path Calculations */
ta1 : (P_R * P_LR) + (P_NR * P_LNR);
ta2 : P_R * P_LNR_given_R;

/* Output strings for worked solution to ensure clean formatting */
str_NR : float(P_NR);
str_LNR_given_R : float(P_LNR_given_R);
str_NL_given_NR : float(P_NL_given_NR);
path_R_L : float(P_R * P_LR);
path_NR_L : float(P_NR * P_LNR);

ta1_str : float(ta1);
ta2_str : float(ta2);

/* Distractors */
ta1_wrong_one_path : P_R * P_LR; /* Only found the "Rain and Late" path */
ta2_wrong_independent : P_R * (1 - ta1); /* Wrongly assumed weather and lateness were independent */]]></text>
    </questionvariables>
