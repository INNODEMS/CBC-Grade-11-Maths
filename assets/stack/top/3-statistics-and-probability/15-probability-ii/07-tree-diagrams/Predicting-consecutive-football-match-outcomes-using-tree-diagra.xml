    <questionvariables>
      <text><![CDATA[/* Context arrays for localization */
idx_team : rand([1, 2, 3, 4, 5, 6]);
team_list : ["Shabana FC", "Gor Mahia", "AFC Leopards", "Bandari FC", "Tusker FC", "Kakamega Homeboyz"];
team : team_list[idx_team];

/* Independent probability parameters using integers to ensure exact fractional math */
num_W_list : [35, 40, 45, 50, 55, 60];
num_D_list : [15, 20, 25, 30];

num_W : rand(num_W_list);
num_D : rand(num_D_list);
num_L : 100 - num_W - num_D; /* Automatically sums to 1.0 */

/* Exact internal fractions */
P_W : num_W / 100;
P_D : num_D / 100;
P_L : num_L / 100;

/* Decimal strings for safe display */
str_W : float(P_W);
str_D : float(P_D);
str_L : float(P_L);

/* Calculate targets precisely */
ta1 : P_W * P_W;
ta2 : P_D * P_D;

P_Not_W : P_D + P_L;
P_Zero_Wins : P_Not_W * P_Not_W;
ta3 : 1 - P_Zero_Wins;

/* Intermediate display strings for worked solution */
ta1_str : float(ta1);
ta2_str : float(ta2);
ta3_str : float(ta3);
P_Not_W_str : float(P_Not_W);
P_Zero_Wins_str : float(P_Zero_Wins);

/* Distractors */
ta1_wrong_add : P_W + P_W;
ta3_wrong_complement : 1 - ta1; /* Mistakenly calculated 1 - P(Both Wins) */]]></text>
    </questionvariables>
