    <questionvariables>
      <text>/* Randomize ball counts broadly */
num_R : rand([3, 4, 5, 6, 7, 8, 9]);
num_B : rand([2, 3, 4, 5, 6, 7]);

/* Calculate exact totals */
total1 : num_R + num_B;
total2 : total1 - 1;
num_R_minus_1 : num_R - 1;

/* Calculate target probabilities using exact fractional math */
ta1 : num_R / total1;
ta2 : num_R_minus_1 / total2;
ta3 : ta1 * ta2;

P_RB : (num_R / total1) * (num_B / total2);
P_BR : (num_B / total1) * (num_R / total2);
ta4 : P_RB + P_BR;

/* Distractors for specific PRT checks */
ta2_wrong_replacement : num_R / total1;
ta3_wrong_replacement : ta1 * ta1;
ta4_wrong_one_path : P_RB;
ta4_wrong_replacement : 2 * (num_R / total1) * (num_B / total1);</text>
    </questionvariables>
