    <questionvariables>
      <text><![CDATA[/* Part (a): 8 algebraic factorial quotient variants in terms of n */
idx_a : 1 + rand(8);

list_num_a : ["(n + 1)!", "(n + 2)!", "n!", "(n + 3)!", "(n - 1)!", "(n + 1)!", "(n + 2)!", "(n + 2)!"];
list_den_a : ["(n - 1)!", "n!", "(n - 2)!", "(n + 1)!", "(n - 3)!", "(n - 2)!", "(n - 1)!", "(n + 1)!"];
list_exp_a : [
  "(n + 1) \\times n \\times (n - 1)!",
  "(n + 2) \\times (n + 1) \\times n!",
  "n \\times (n - 1) \\times (n - 2)!",
  "(n + 3) \\times (n + 2) \\times (n + 1)!",
  "(n - 1) \\times (n - 2) \\times (n - 3)!",
  "(n + 1) \\times n \\times (n - 1) \\times (n - 2)!",
  "(n + 2) \\times (n + 1) \\times n \\times (n - 1)!",
  "(n + 2) \\times (n + 1)!"
];
list_rem_a : [
  "n(n + 1)",
  "(n + 2)(n + 1)",
  "n(n - 1)",
  "(n + 3)(n + 2)",
  "(n - 1)(n - 2)",
  "(n + 1)n(n - 1)",
  "(n + 2)(n + 1)n",
  "n + 2"
];
list_ta1 : [
  n*(n + 1),
  (n + 2)*(n + 1),
  n*(n - 1),
  (n + 3)*(n + 2),
  (n - 1)*(n - 2),
  (n + 1)*n*(n - 1),
  (n + 2)*(n + 1)*n,
  n + 2
];
list_ta1_short : [
  n + 1,
  n + 2,
  n,
  n + 3,
  n - 1,
  (n + 1)*n,
  (n + 2)*(n + 1),
  n + 1
];

num_a : list_num_a[idx_a];
den_a : list_den_a[idx_a];
exp_a : list_exp_a[idx_a];
rem_a : list_rem_a[idx_a];
ta1 : list_ta1[idx_a];
ta1_wrong_one_step : list_ta1_short[idx_a];

/* Part (b): 4 equation structures x 48 integer values = 192 variants (1,536 total) */
idx_b : 1 + rand(4);
pk : 8 + rand(48);

list_num_b : ["n!", "(n + 1)!", "(n + 2)!", "(n - 1)!"];
list_den_b : ["(n - 1)!", "n!", "(n + 1)!", "(n - 2)!"];
list_exp_b : [
  "n \\times (n - 1)!",
  "(n + 1) \\times n!",
  "(n + 2) \\times (n + 1)!",
  "(n - 1) \\times (n - 2)!"
];
list_lhs_b : ["n", "n + 1", "n + 2", "n - 1"];
list_ta2 : [pk, pk - 1, pk - 2, pk + 1];
list_ta2_wrong_sign : [pk - 1, pk + 1, pk + 2, pk - 1];
list_solve_b : [
  sconcat("n = ", string(pk)),
  sconcat("n = ", string(pk), " - 1 = ", string(pk - 1)),
  sconcat("n = ", string(pk), " - 2 = ", string(pk - 2)),
  sconcat("n = ", string(pk), " + 1 = ", string(pk + 1))
];

num_b : list_num_b[idx_b];
den_b : list_den_b[idx_b];
exp_b : list_exp_b[idx_b];
lhs_b : list_lhs_b[idx_b];
ta2 : list_ta2[idx_b];
ta2_wrong_sign : list_ta2_wrong_sign[idx_b];
solve_b : list_solve_b[idx_b];]]></text>
    </questionvariables>
