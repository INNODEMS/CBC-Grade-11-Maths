    <questionvariables>
      <text><![CDATA[/* Independent pools yielding 23 x 20 = 460 distinct variants with non-colliding distractors */
triple_a : rand([
  [2, 2, 3], [2, 2, 4],
  [2, 3, 3], [2, 3, 4], [2, 4, 2], [2, 4, 3], [2, 4, 4],
  [3, 2, 3], [3, 2, 4], [3, 3, 2], [3, 3, 3], [3, 4, 2], [3, 4, 3], [3, 4, 4],
  [4, 2, 2], [4, 2, 3], [4, 2, 4], [4, 3, 2], [4, 3, 3], [4, 3, 4], [4, 4, 2], [4, 4, 3], [4, 4, 4]
]);
pA : triple_a[1];
pB : triple_a[2];
pC : triple_a[3];
pn : pA + pB + pC;
ta1 : factorial(pn) / (factorial(pA) * factorial(pB) * factorial(pC));

pH : rand([3, 4, 5, 6, 7]);
pT : rand([2, 3, 4, 5]);
pnc : pH + pT;
ta2 : factorial(pnc) / (factorial(pH) * factorial(pT));

/* Step-by-step expansion helpers */
nary("mycross");
texput("mycross", " \\times ", nary);

sorted1 : sort([pA, pB, pC], ">");
d1 : sorted1[1];
d2 : sorted1[2];
d3 : sorted1[3];
rem1 : pn - d1;
num1_factors : apply("mycross", makelist(pn - i, i, 0, rem1 - 1));
den1_d2 : apply("mycross", makelist(d2 - i, i, 0, d2 - 1));
den1_d3 : apply("mycross", makelist(d3 - i, i, 0, d3 - 1));
num1_val : factorial(pn) / factorial(d1);
den1_val : factorial(d2) * factorial(d3);

big2 : max(pH, pT);
small2 : min(pH, pT);
num2_factors : apply("mycross", makelist(pnc - i, i, 0, small2 - 1));
den2_small : apply("mycross", makelist(small2 - i, i, 0, small2 - 1));
num2_val : factorial(pnc) / factorial(big2);
den2_val : factorial(small2);

/* Distractors for targeted PRT feedback (guaranteed distinct across 100% of seeds) */
ta1_omit_one : factorial(pn) / (factorial(pA) * factorial(pB));
ta1_no_div : factorial(pn);
ta1_no_fact : factorial(pn) / (pA * pB * pC);

ta2_no_div : factorial(pnc);
ta2_no_fact : factorial(pnc) / (pH * pT);]]></text>
    </questionvariables>
