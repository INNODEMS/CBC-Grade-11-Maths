    <questionvariables>
      <text><![CDATA[/* Independent arrays yielding 4 x 4 x 7 = 112 distinct variants */
pblock : rand([2, 3, 4, 5]);
pother : rand([2, 3, 4, 5]);
ptotal : pother + 1;

val_ptotal_fact : factorial(ptotal);
val_pblock_fact : factorial(pblock);
ta1 : val_ptotal_fact * val_pblock_fact;

pn2 : rand([4, 5, 6, 7, 8, 9, 10]);
prem2 : pn2 - 1;
ta2 : factorial(prem2);

/* Unsimplified n-ary multiplication strings for step-by-step factorial expansion */
nary("mycross");
texput("mycross", " \\times ", nary);
exp_ptotal : apply("mycross", makelist(ptotal - i, i, 0, ptotal - 1));
exp_pblock : apply("mycross", makelist(pblock - i, i, 0, pblock - 1));
exp_prem2 : apply("mycross", makelist(prem2 - i, i, 0, prem2 - 1));

/* Distractors for targeted PRT feedback */
ta1_no_internal : val_ptotal_fact;
ta1_unrestricted : factorial(pblock + pother);
ta1_added : val_ptotal_fact + val_pblock_fact;

ta2_unrestricted : factorial(pn2);]]></text>
    </questionvariables>
