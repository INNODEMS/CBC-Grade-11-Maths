    <questionvariables>
      <text><![CDATA[/* Part A: Ensure max(pa, pb) >= 3 so pa!*pb! > pa*pb in 100% of variants (19 choices) */
pa : rand([2, 3, 4, 5, 6]);
pb_pool : if pa = 2 then [3, 4, 5] else [2, 3, 4, 5];
pb : rand(pb_pool);
pn : pa + pb;
ta1 : factorial(pn) / (factorial(pa) * factorial(pb));

/* Part B: Valid triples where max >= 3 and pc1*pc2*pc3 # max! so all 4 PRT outcomes are distinct (13 choices) */
triple_b : rand([
  [3, 2, 2], [2, 3, 2], [2, 2, 3],
  [3, 3, 2], [3, 2, 3], [2, 3, 3],
  [3, 3, 3],
  [4, 2, 2], [2, 4, 2], [2, 2, 4],
  [4, 3, 3], [4, 4, 2], [4, 4, 3]
]);
pc1 : triple_b[1];
pc2 : triple_b[2];
pc3 : triple_b[3];
pnc : pc1 + pc2 + pc3;
ta2 : factorial(pnc) / (factorial(pc1) * factorial(pc2) * factorial(pc3));

/* Step-by-step expansion helpers */
nary("mycross");
texput("mycross", " \\times ", nary);

big1 : max(pa, pb);
small1 : min(pa, pb);
num1_factors : apply("mycross", makelist(pn - i, i, 0, small1 - 1));
den1_small : apply("mycross", makelist(small1 - i, i, 0, small1 - 1));
num1_val : factorial(pn) / factorial(big1);
den1_val : factorial(small1);

sorted2 : sort([pc1, pc2, pc3], ">");
g1 : sorted2[1];
g2 : sorted2[2];
g3 : sorted2[3];
rem_count2 : pnc - g1;
num2_factors : apply("mycross", makelist(pnc - i, i, 0, rem_count2 - 1));
den2_g2 : apply("mycross", makelist(g2 - i, i, 0, g2 - 1));
den2_g3 : apply("mycross", makelist(g3 - i, i, 0, g3 - 1));
num2_val : factorial(pnc) / factorial(g1);
den2_val : factorial(g2) * factorial(g3);

/* Distractors for targeted PRT feedback (guaranteed distinct from ta1/ta2 across all seeds) */
ta1_no_div : factorial(pn);
ta1_no_fact : factorial(pn) / (pa * pb);

ta2_no_div : factorial(pnc);
ta2_no_fact : factorial(pnc) / (pc1 * pc2 * pc3);
ta2_one_group : factorial(pnc) / factorial(g1);]]></text>
    </questionvariables>
