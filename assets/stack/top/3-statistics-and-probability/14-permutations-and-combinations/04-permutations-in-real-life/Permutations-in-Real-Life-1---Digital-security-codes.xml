    <questionvariables>
      <text><![CDATA[/* Independent arrays yielding 7 x 6 = 42 distinct variants with non-colliding distractors */
pdigits : 10;
plen1 : rand([3, 4, 5, 6, 7, 8, 9]);
rem1 : pdigits - plen1;
ta1 : factorial(pdigits) / factorial(rem1);

pletters : 26;
plen2 : rand([2, 3, 4, 5, 6, 7]);
rem2 : pletters - plen2;
ta2 : factorial(pletters) / factorial(rem2);

/* Step-by-step expansion helpers */
nary("mycross");
texput("mycross", " \\times ", nary);

num1_factors : apply("mycross", makelist(pdigits - i, i, 0, plen1 - 1));
num2_factors : apply("mycross", makelist(pletters - i, i, 0, plen2 - 1));

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
ta1_rep : pdigits^plen1;
ta1_comb : factorial(pdigits) / (factorial(plen1) * factorial(rem1));

ta2_rep : pletters^plen2;
ta2_comb : factorial(pletters) / (factorial(plen2) * factorial(rem2));]]></text>
    </questionvariables>
