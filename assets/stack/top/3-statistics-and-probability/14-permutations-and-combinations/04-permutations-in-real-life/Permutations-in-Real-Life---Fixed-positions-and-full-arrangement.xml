    <questionvariables>
      <text><![CDATA[/* Independent arrays yielding 7 x 7 = 49 distinct variants with non-colliding distractors */
pn1 : rand([6, 7, 8, 9, 10, 11, 12]);
prem1 : pn1 - 1;
ta1 : factorial(prem1);

pn2 : rand([5, 6, 7, 8, 9, 10, 11]);
ta2 : factorial(pn2);

/* Unsimplified n-ary multiplication strings for step-by-step factorial expansion */
nary("mycross");
texput("mycross", " \\times ", nary);
exp1 : apply("mycross", makelist(prem1 - i, i, 0, prem1 - 1));
exp2 : apply("mycross", makelist(pn2 - i, i, 0, pn2 - 1));

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
ta1_unfixed : factorial(pn1);
ta1_two_fixed : factorial(pn1 - 2);

ta2_minus_one : factorial(pn2 - 1);]]></text>
    </questionvariables>
