    <questionvariables>
      <text><![CDATA[/* Disjoint parameter pools guaranteeing 100% distinct formulas across all variants */
r1 : rand([3, 4, 5, 6]);
rem1 : 10 - r1;
val1 : factorial(10) / factorial(rem1);

n2 : rand([15, 18, 20, 25, 30]);
r2 : rand([2, 3, 4]);
rem2 : n2 - r2;
val2 : factorial(n2) / factorial(rem2);
prize_text : if r2 = 2 then sconcat("First and second prizes are awarded among ", n2, " contestants.")
             else if r2 = 3 then sconcat("First, second, and third prizes are awarded among ", n2, " contestants.")
             else sconcat("First, second, third, and fourth prizes are awarded among ", n2, " contestants.");

n3 : rand([5, 6, 7]);
val3 : factorial(n3);

n4 : rand([9, 10, 11, 12]);
rem4 : n4 - 1;
val4 : factorial(rem4);

L5 : rand([2, 3, 4]);
D5 : rand([2, 3, 4]);

n6 : rand([12, 14, 16, 24]);
r6 : rand([4, 5, 6]);
rem6 : n6 - r6;
val6 : factorial(n6) / factorial(rem6);

/* 6 correct formulas + 2 targeted distractors */
f1_tex : sconcat("{}_{10}P_{", r1, "} = \\frac{10!}{", rem1, "!}");
f2_tex : sconcat("{}_{", n2, "}P_{", r2, "} = \\frac{", n2, "!}{", rem2, "!}");
f3_tex : sconcat(n3, "!");
f4_tex : sconcat(rem4, "!");
f5_tex : sconcat("{}_{26}P_{", L5, "} \\times {}_{10}P_{", D5, "}");
f6_tex : sconcat("{}_{", n6, "}P_{", r6, "} = \\frac{", n6, "!}{", rem6, "!}");
f7_tex : sconcat(n4, "!");
f8_tex : sconcat("{}_{10}C_{", r1, "} = \\frac{10!}{", r1, "! \\times ", rem1, "!}");

f_pool : [f1_tex, f2_tex, f3_tex, f4_tex, f5_tex, f6_tex, f7_tex, f8_tex];
perm : random_permutation([1, 2, 3, 4, 5, 6, 7, 8]);
letters : ["A", "B", "C", "D", "E", "F", "G", "H"];

disp_A : f_pool[perm[1]];
disp_B : f_pool[perm[2]];
disp_C : f_pool[perm[3]];
disp_D : f_pool[perm[4]];
disp_E : f_pool[perm[5]];
disp_F : f_pool[perm[6]];
disp_G : f_pool[perm[7]];
disp_H : f_pool[perm[8]];

/* Correct letter labels for each scenario and targeted distractor */
corr1 : letters[sublist_indices(perm, lambda([x], x = 1))[1]];
corr2 : letters[sublist_indices(perm, lambda([x], x = 2))[1]];
corr3 : letters[sublist_indices(perm, lambda([x], x = 3))[1]];
corr4 : letters[sublist_indices(perm, lambda([x], x = 4))[1]];
corr5 : letters[sublist_indices(perm, lambda([x], x = 5))[1]];
corr6 : letters[sublist_indices(perm, lambda([x], x = 6))[1]];
corr_unfixed4 : letters[sublist_indices(perm, lambda([x], x = 7))[1]];
corr_comb1 : letters[sublist_indices(perm, lambda([x], x = 8))[1]];

/* Dropdown option lists using sconcat */
opts1 : makelist([letters[i], is(letters[i] = corr1), sconcat("Formula ", letters[i])], i, 1, 8);
opts2 : makelist([letters[i], is(letters[i] = corr2), sconcat("Formula ", letters[i])], i, 1, 8);
opts3 : makelist([letters[i], is(letters[i] = corr3), sconcat("Formula ", letters[i])], i, 1, 8);
opts4 : makelist([letters[i], is(letters[i] = corr4), sconcat("Formula ", letters[i])], i, 1, 8);
opts5 : makelist([letters[i], is(letters[i] = corr5), sconcat("Formula ", letters[i])], i, 1, 8);
opts6 : makelist([letters[i], is(letters[i] = corr6), sconcat("Formula ", letters[i])], i, 1, 8);]]></text>
    </questionvariables>
