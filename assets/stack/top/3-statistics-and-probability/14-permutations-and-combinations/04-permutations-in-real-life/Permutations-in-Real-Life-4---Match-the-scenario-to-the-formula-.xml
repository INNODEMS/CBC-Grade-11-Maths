<quiz>
  <question type="stack">
    <name>
      <text>Matching real-life permutation scenarios to counting formulas</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Match each real-life situation to the formula in the <b>Formula Bank</b> below that gives the number of possible arrangements. Order matters in every situation.</p>

<table border="1" cellpadding="8" cellspacing="0" style="border-collapse: collapse; width: 100%; max-width: 720px; margin-bottom: 16px;">
  <thead>
    <tr style="background-color: #f4f6f8;">
      <th style="text-align: left; width: 18%;">Label</th>
      <th style="text-align: left; width: 32%;">Formula</th>
      <th style="text-align: left; width: 18%;">Label</th>
      <th style="text-align: left; width: 32%;">Formula</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><b>Formula A</b></td>
      <td>\(\displaystyle {#disp_A#}\)</td>
      <td><b>Formula E</b></td>
      <td>\(\displaystyle {#disp_E#}\)</td>
    </tr>
    <tr>
      <td><b>Formula B</b></td>
      <td>\(\displaystyle {#disp_B#}\)</td>
      <td><b>Formula F</b></td>
      <td>\(\displaystyle {#disp_F#}\)</td>
    </tr>
    <tr>
      <td><b>Formula C</b></td>
      <td>\(\displaystyle {#disp_C#}\)</td>
      <td><b>Formula G</b></td>
      <td>\(\displaystyle {#disp_G#}\)</td>
    </tr>
    <tr>
      <td><b>Formula D</b></td>
      <td>\(\displaystyle {#disp_D#}\)</td>
      <td><b>Formula H</b></td>
      <td>\(\displaystyle {#disp_H#}\)</td>
    </tr>
  </tbody>
</table>

<table border="1" cellpadding="8" cellspacing="0" style="border-collapse: collapse; width: 100%; max-width: 720px;">
  <thead>
    <tr style="background-color: #f4f6f8;">
      <th style="text-align: left; width: 65%;">Real-Life Situation</th>
      <th style="text-align: left; width: 35%;">Matching Formula</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><b>1.</b> A phone uses a \({@r1@}\)-digit code made from different digits \(0\) to \(9\).</td>
      <td>[[input:ans1]] [[validation:ans1]] [[feedback:prt1]]</td>
    </tr>
