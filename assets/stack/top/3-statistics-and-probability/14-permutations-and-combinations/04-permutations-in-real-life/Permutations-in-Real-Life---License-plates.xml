    <questionvariables>
      <text><![CDATA[/* Independent arrays yielding 3 x 3 x 8 x 3 = 216 distinct variants with non-colliding distractors */
pletters : 26;
pnletters : rand([2, 3, 4]);
remL : pletters - pnletters;
pL : factorial(pletters) / factorial(remL);

pdigits : 10;
pndigits : rand([2, 3, 4]);
remD : pdigits - pndigits;
pD : factorial(pdigits) / factorial(remD);

ta1 : pL * pD;

pn2 : rand([8, 9, 10, 11, 12, 13, 14, 15]);
pr2 : rand([2, 3, 4]);
rem2 : pn2 - pr2;
ta2 : factorial(pn2) / factorial(rem2);

/* Step-by-step expansion helpers */
nary("mycross");
texput("mycross", " \\times ", nary);

numL_factors : apply("mycross", makelist(pletters - i, i, 0, pnletters - 1));
numD_factors : apply("mycross", makelist(pdigits - i, i, 0, pndigits - 1));
num2_factors : apply("mycross", makelist(pn2 - i, i, 0, pr2 - 1));

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
ta1_added : pL + pD;
ta1_rep : (pletters^pnletters) * (pdigits^pndigits);
ta1_comb : binomial(pletters, pnletters) * binomial(pdigits, pndigits);

ta2_comb : binomial(pn2, pr2);
ta2_rep : pn2^pr2;]]></text>
    </questionvariables>
