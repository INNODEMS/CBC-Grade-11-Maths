/* Worked solution step strings */
row1_steps_html : if fam = 1 then "1 + 4 = 5, &nbsp; 4 + 6 = 10, &nbsp; 6 + 4 = 10, &nbsp; 4 + 1 = 5"
                  else "6 + 15 = 21, &nbsp; 15 + 20 = 35, &nbsp; 20 + 15 = 35, &nbsp; 15 + 6 = 21";
row1_full_str : if fam = 1 then "1, &nbsp; 5, &nbsp; 10, &nbsp; 10, &nbsp; 5, &nbsp; 1"
                else "1, &nbsp; 7, &nbsp; 21, &nbsp; 35, &nbsp; 35, &nbsp; 21, &nbsp; 7, &nbsp; 1";

row2_steps_html : if fam = 1 then "1 + 5 = 6, &nbsp; 5 + 10 = 15, &nbsp; 10 + 10 = 20, &nbsp; 10 + 5 = 15, &nbsp; 5 + 1 = 6"
                  else "7 + 21 = 28, &nbsp; 21 + 35 = 56, &nbsp; 35 + 35 = 70, &nbsp; 35 + 21 = 56, &nbsp; 21 + 7 = 28";
row2_full_str : if fam = 1 then "1, &nbsp; 6, &nbsp; 15, &nbsp; 20, &nbsp; 15, &nbsp; 6, &nbsp; 1"
                else "1, &nbsp; 8, &nbsp; 28, &nbsp; 56, &nbsp; 70, &nbsp; 56, &nbsp; 28, &nbsp; 8, &nbsp; 1";

/* Part B randomized combinations and symmetry queries (5 x 5 x 4 = 100 per family) */
pair_a : if fam = 1 then rand([[5, 1], [5, 2], [5, 4], [4, 1], [4, 2]])
                    else rand([[7, 2], [7, 3], [7, 5], [6, 2], [6, 3]]);
na : pair_a[1];
ra : pair_a[2];
na_rem : na - ra;
ta10 : binomial(na, ra);

pair_b : if fam = 1 then rand([[6, 2], [6, 3], [6, 4], [6, 5], [5, 2]])
                    else rand([[8, 2], [8, 3], [8, 4], [8, 5], [8, 6]]);
nb : pair_b[1];
rb : pair_b[2];
nb_rem : nb - rb;
ta11 : binomial(nb, rb);

pair_s : if fam = 1 then rand([[6, 4], [6, 5], [5, 3], [5, 4]])
                    else rand([[8, 5], [8, 6], [7, 4], [7, 5]]);
ns : pair_s[1];
rs : pair_s[2];
rs_sym : ns - rs;
ta12 : binomial(ns, rs);

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
ta10_off_by_one : binomial(na, ra - 1);
ta11_perm : factorial(nb) / factorial(nb - rb);]]></text>
