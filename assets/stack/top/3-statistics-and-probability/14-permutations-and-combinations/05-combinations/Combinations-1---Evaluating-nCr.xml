    <questionvariables>
      <text><![CDATA[/* Independent arrays yielding 4 x 3 x 5 x 3 = 180 distinct variants with strictly non-colliding distractors */
pn1 : rand([7, 9, 10, 11]);
pr1 : rand([2, 3, 4]);
rem1 : pn1 - pr1;
ta1 : binomial(pn1, pr1);

pn2 : rand([9, 10, 11, 12, 13]);
pr2 : rand([2, 3, 4]);
rem2 : pn2 - pr2;
ta2 : binomial(pn2, pr2);

/* Step-by-step expansion and intermediate quotient helpers */
nary("mycross");
texput("mycross", " \\times ", nary);

num1_factors : apply("mycross", makelist(pn1 - i, i, 0, pr1 - 1));
den1_factors : apply("mycross", makelist(pr1 - i, i, 0, pr1 - 1));
num1_prod : factorial(pn1) / factorial(rem1);
den1_prod : factorial(pr1);

num2_factors : apply("mycross", makelist(pn2 - i, i, 0, pr2 - 1));
den2_factors : apply("mycross", makelist(pr2 - i, i, 0, pr2 - 1));
num2_prod : factorial(pn2) / factorial(rem2);
den2_prod : factorial(pr2);

/* Distractors for targeted PRT feedback (strictly distinct across 100% of seeds) */
ta1_perm : factorial(pn1) / factorial(rem1);
ta1_no_rem : factorial(pn1) / factorial(pr1);

ta2_perm : factorial(pn2) / factorial(rem2);
ta2_no_rem : factorial(pn2) / factorial(pr2);]]></text>
    </questionvariables>
