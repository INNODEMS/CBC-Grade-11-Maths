      <text><![CDATA[/* Randomize scenario quantities and shuffle all 8 items (8! = 40,320 orderings x parameter pools) */
n1 : rand([8, 10, 12, 15]);
n2 : rand([7, 8, 9, 10]);
r2 : rand([3, 4]);
r3 : rand([4, 5, 6]);
r4 : rand([4, 5, 6]);
n4 : rand([25, 30, 32, 36]);
n5 : rand([8, 10, 12, 14]);
n6 : rand([9, 10, 12, 15]);
n7 : rand([5, 6, 7, 8]);
n8 : rand([11, 14, 15, 18]);

/* 1 = Order matters (permutation), 2 = Order does not matter (combination) */
base_cats : [1, 2, 1, 2, 1, 2, 1, 2];

base_txt : [
  sconcat("A school elects a Prefect and an Assistant Prefect from ", string(n1), " candidates."),
  sconcat("A farmer chooses ", string(r2), " goats out of ", string(n2), " to take to the market."),
  sconcat("A ", string(r3), "-digit M-Pesa PIN is made from different digits."),
  sconcat("A committee of ", string(r4), " students is chosen from a class of ", string(n4), "."),
  sconcat("The Gold, Silver and Bronze medals are awarded to 3 of ", string(n5), " runners."),
  sconcat(string(n6), " people at a meeting shake hands once with everyone else."),
  sconcat(string(n7), " different novels are arranged on a library shelf."),
  sconcat("Two players are picked from a squad of ", string(n8), " to carry the ball bag.")
];

base_exp : [
  "<b>Order matters (permutation):</b> Prefect and Assistant Prefect are distinct ranks; swapping the two elected students swaps their roles.",
  "<b>Order does not matter (combination):</b> The chosen goats form one unranked group going to the market; swapping two goats gives the same group.",
  "<b>Order matters (permutation):</b> A PIN is an ordered sequence of digits; swapping two digits produces a different PIN.",
  "<b>Order does not matter (combination):</b> Committee members hold identical unranked roles; swapping two selected students gives the same committee.",
  "<b>Order matters (permutation):</b> Gold, Silver and Bronze represent distinct finishing positions; swapping two runners changes who wins which medal.",
  "<b>Order does not matter (combination):</b> A handshake is a pair of two people; person A shaking B's hand is the same handshake as B shaking A's.",
  "<b>Order matters (permutation):</b> Books placed in different left-to-right positions on a shelf create a different arrangement.",
  "<b>Order does not matter (combination):</b> Both players share the same unranked duty; swapping the two players gives the exact same pair."
];

perm : random_permutation([1, 2, 3, 4, 5, 6, 7, 8]);

q1 : base_txt[perm[1]];
q2 : base_txt[perm[2]];
q3 : base_txt[perm[3]];
q4 : base_txt[perm[4]];
q5 : base_txt[perm[5]];
q6 : base_txt[perm[6]];
q7 : base_txt[perm[7]];
q8 : base_txt[perm[8]];

exp1 : base_exp[perm[1]];
exp2 : base_exp[perm[2]];
exp3 : base_exp[perm[3]];
exp4 : base_exp[perm[4]];
exp5 : base_exp[perm[5]];
exp6 : base_exp[perm[6]];
exp7 : base_exp[perm[7]];
exp8 : base_exp[perm[8]];

