ta2 : base_cats[perm[2]];
ta3 : base_cats[perm[3]];
ta4 : base_cats[perm[4]];
ta5 : base_cats[perm[5]];
ta6 : base_cats[perm[6]];
ta7 : base_cats[perm[7]];
ta8 : base_cats[perm[8]];

/* Pre-evaluated wrong answers for qtest (dropdown inputs require evaluated option keys 1 or 2) */
